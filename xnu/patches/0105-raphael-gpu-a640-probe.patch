@@ -53,6 +53,7 @@ extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
 extern void sweet_touch_init(void);
 extern void sweet_usb_probe(void);
+extern void sweet_gpu_init(void);
 
 #define REG_CAP         0x00
 #define REG_IS          0x20
@@ -660,6 +661,7 @@ sweet_ufs_init(void)
 	sweet_keys_init();
 	sweet_touch_init();
 	sweet_usb_probe();
+	sweet_gpu_init();         /* nothing unless boot-arg sweetgpu (bsd/dev/sweet_gpu.c) */
 	return 0;
 }
 
