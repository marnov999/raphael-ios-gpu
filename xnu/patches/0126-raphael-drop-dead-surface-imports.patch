+/* Is the surface still somebody's (in the table by its id): one that is not can never be imported again. */
+extern "C" bool
+sweet_surface_gpu_live(void *surface)
+{
+	SweetSurface *s = (SweetSurface *)surface;
+	bool live;
+	if (s == NULL || sweet_surface_lock == NULL) {
+		return false;
+	}
+	IOLockLock(sweet_surface_lock);
+	live = s->id != 0 && s->id < SWEET_SURFACE_MAX_ID && sweet_surface_table[s->id] == s && sweet_surface_users[s->id] != 0;
+	IOLockUnlock(sweet_surface_lock);
+	return live;
+}
