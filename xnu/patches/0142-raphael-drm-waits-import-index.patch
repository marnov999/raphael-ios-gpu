+/*
+ * The waits (GEM_CPU_PREP, WAIT_FENCE) as they come in: Linux's _IOW direction bit is XNU's IOC_OUT, and
+ * a request encoded so comes with nothing copied in -- zeroed, which CPU_PREP takes for "wait for all the
+ * GPU has been given", even Mesa's NOSYNC look at whether a buffer is busy. Such a request's arguments
+ * are copied in here from the caller's own pointer (x2 of its ioctl). Counted for the five-second line.
+ */
+extern struct arm_saved_state *get_user_regs(thread_t);
+
 static int
 drm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
 {
 	unsigned nr  = (unsigned)(cmd & 0xffu);
 	unsigned typ = (unsigned)((cmd >> 8) & 0xffu);
 	int e;
+	uint64_t began = 0;
 	if (typ != DRM_IOC_TYPE) {
 		return ENOTTY;
 	}
+	if ((nr == DRM_NR_MSM_GEM_CPU_PREP || nr == DRM_NR_MSM_WAIT_FENCE) && (cmd & IOC_IN) == 0 && IOCPARM_LEN(cmd) != 0) {
+		static uint32_t told;
+		arm_saved_state_t *ss = get_user_regs(current_thread());
+		user_addr_t uaddr = ss != NULL ? (user_addr_t)get_saved_state_reg(ss, 2) : 0;
+		int ce = uaddr != 0 ? copyin(uaddr, data, IOCPARM_LEN(cmd)) : EFAULT;
+		if (told++ < 4) {
+			printf("SWEET DRM: ioctl nr %#x cmd %#lx came with nothing copied in: from %#llx: %d\n", nr, cmd,
+			    (unsigned long long)uaddr, ce);
+		}
+	}
+	if (nr == DRM_NR_MSM_GEM_CPU_PREP) {
+		struct drm_msm_gem_cpu_prep *cp = (struct drm_msm_gem_cpu_prep *)data;
+		g_prep_calls++;
+		g_prep_zero += cp->handle == 0;
+		g_prep_nosync += (cp->op & MSM_PREP_NOSYNC) != 0;
+		began = mach_absolute_time();
+	} else if (nr == DRM_NR_MSM_WAIT_FENCE) {
+		g_waitf_calls++;
+	}
 	gpu_lock();
 	e = drm_ioctl_locked(nr, data);
 	gpu_unlock();
+	if (began != 0) {
+		g_prep_time += mach_absolute_time() - began;
+	}
 	if (e == ENOTTY) {
 		printf("SWEET DRM: ioctl nr=%#x is not known here\n", nr);
 	}
