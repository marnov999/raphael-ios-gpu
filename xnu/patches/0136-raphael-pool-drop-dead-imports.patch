+/*
+ * SweetSurface.cpp, raphael, when the display pool is empty: the kept GPU buffers (used 3) of surfaces
+ * nobody has any more given back now. CoreAnimation makes a full-screen surface a frame and lets each go a
+ * few frames later; the buffers the GL bridge had of them were kept until gpu_import_expire looked again
+ * (every 250 ms: 20 frames at 81 Hz) -- 11 of the 16 display buffers held so in animations (u20), and a
+ * third of the frames' surfaces were made of new pages, zeroed and pushed out of the cache.
+ */
+void sweet_gpu_drop_dead_imports(void);
+void
+sweet_gpu_drop_dead_imports(void)
+{
+	if (g_gpu_mtx == NULL || !g_kgsl_ready) {
+		return;
+	}
+	gpu_lock();
+	for (unsigned i = 0; i < KGSL_MAX_BO; i++) {
+		if (g_bo[i].used == 3 && !sweet_surface_gpu_live(g_bo[i].surf)) {
+			gpu_import_drop(&g_bo[i]);
+		}
+	}
+	gpu_reap();
+	gpu_unlock();
+}
