+/* The display block: MDSS (MDP 0xae00000, DSI0 +0x94000, its PHY +0x94400 and PLL +0x94900, DSI1 +0x96000) and DISP_CC (0xaf00000) */
+#define MDSS_PA                 0x0ae00000u
+#define MDSS_LEN                0x120000u
+#define INTF1_TEAR              0x6b800u
+#define TEAR_SYNC_CONFIG_VSYNC  0x288u          /* sde_hw_intf.c INTF_TEAR_*: [18:0] vsync clocks a line, 19 counter, 20 TE pin */
+#define TEAR_VSYNC_INIT_VAL     0x294u          /* the read pointer's line at a TE */
+#define TEAR_INT_COUNT_VAL      0x298u          /* [31:16] TEs seen, [15:0] the read pointer's line */
+#define VSYNC_CLK_HZ            19200000ull     /* dt clock "vsync_clk": the XO */
+
+static vm_offset_t g_mdss;
+
+static vm_offset_t
+mdss(void)
+{
+	if (g_mdss == 0) {
+		g_mdss = ml_io_map(MDSS_PA, MDSS_LEN);
+	}
+	return g_mdss;
+}
+
+/*
+ * The last TE: when it came (mach_absolute_time) and how many have come (16 bits, wrapping); false if
+ * the tear check is not counting a TE pin. The read pointer runs on from VSYNC_INIT_VAL after each TE
+ * at the configured lines a second, so the time since the TE is its lines past that.
+ */
+bool sweet_panel_te(uint64_t *at, uint32_t *count);
+bool
+sweet_panel_te(uint64_t *at, uint32_t *count)
+{
+	vm_offset_t m = mdss();
+	if (m == 0) {
+		return false;
+	}
+	volatile uint32_t *t = (volatile uint32_t *)(m + INTF1_TEAR);
+	uint32_t cfg = t[TEAR_SYNC_CONFIG_VSYNC / 4], init = t[TEAR_VSYNC_INIT_VAL / 4] & 0xffffu;
+	uint64_t now = mach_absolute_time();
+	uint32_t v = t[TEAR_INT_COUNT_VAL / 4];
+	uint32_t clocks = cfg & 0x7ffffu, line = v & 0xffffu;
+	if ((cfg & (1u << 19 | 1u << 20)) != (1u << 19 | 1u << 20) || clocks == 0 || line < init) {
+		return false;
+	}
+	uint64_t since = 0;
+	nanoseconds_to_absolutetime((uint64_t)(line - init) * clocks * 1000000000ull / VSYNC_CLK_HZ, &since);
+	*at = now - since;
+	*count = v >> 16;
+	return true;
+}
+
+/*
+ * kern.sweet_mdss (root): in { op, off, val, n, bytes[56] }, out { val, ok, at, count }.
+ * op 0 reads the word at MDSS + off, 1 writes val there (and reads it back), 2 sends bytes[0..n) to the
+ * panel as one DCS long write, 3 samples the TE (sweet_panel_te).
+ */
+struct sweet_mdss_req {
+	uint32_t op, off, val, n;
+	uint8_t  bytes[56];
+};
+struct sweet_mdss_out {
+	uint32_t val, ok;
+	uint64_t at;
+	uint32_t count, pad;
+};
+
+static bool
+dcs_long(const uint8_t *b, uint32_t n)
+{
+	uint32_t dw[1 + 14];
+	if (n == 0 || n > 56) {
+		return false;
+	}
+	dw[0] = (n & 0xffu) | (n >> 8 & 0xffu) << 8 | DCS_LONG_WRITE << 16 | 0xc0u << 24;
+	for (uint32_t i = 0; i < (n + 3) / 4; i++) {
+		uint32_t w = 0;
+		for (uint32_t k = 0; k < 4; k++) {
+			w |= (uint32_t)(4 * i + k < n ? b[4 * i + k] : 0xffu) << (8 * k);
+		}
+		dw[1 + i] = w;
+	}
+	return dsi_ready() && dsi_send(dw, 1 + (n + 3) / 4);
+}
+
+static int
+sysctl_sweet_mdss SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	struct sweet_mdss_req in;
+	struct sweet_mdss_out out;
+	int error;
+	if (req->newptr == USER_ADDR_NULL) {
+		return EINVAL;
+	}
+	bzero(&in, sizeof(in));
+	bzero(&out, sizeof(out));
+	if ((error = SYSCTL_IN(req, &in, sizeof(in))) != 0) {
+		return error;
+	}
+	vm_offset_t m = mdss();
+	switch (in.op) {
+	case 0:
+	case 1:
+		if (m == 0 || (in.off & 3u) != 0 || in.off >= MDSS_LEN) {
+			return EINVAL;
+		}
+		if (in.op == 1) {
+			*(volatile uint32_t *)(m + in.off) = in.val;
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+		out.val = *(volatile uint32_t *)(m + in.off);
+		out.ok = 1;
+		break;
+	case 2:
+		out.ok = dcs_long(in.bytes, in.n);
+		break;
+	case 3:
+		out.ok = sweet_panel_te(&out.at, &out.count);
+		break;
+	default:
+		return EINVAL;
+	}
+	return SYSCTL_OUT(req, &out, sizeof(out));
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_mdss, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_mdss, "S", "display block registers, panel DCS writes, the panel's TE");
+
