+/*
+ * What the clocks were, for the bench (both governors): kern.sweet_dvfs_stats, running sums since the boot -- ms, then
+ * for L3, silver, gold, prime and the GPU the MHz asked times ms (the average: its difference over the ms'), the touches
+ * seen, and the governor's last view (busiest CPU per cluster permille, GPU busy %, rows, GPU level).
+ */
+static uint64_t g_st_ms_x1000, g_st_mhzms[GOV_CL + 1], g_st_at;
+static void
+stats_add(uint64_t now)
+{
+	uint64_t ns = 0;
+	if (g_st_at != 0) {
+		absolutetime_to_nanoseconds(now - g_st_at, &ns);
+		uint64_t us = ns / 1000u;
+		g_st_ms_x1000 += us;
+		for (unsigned c = 0; c < GOV_CL; c++) {
+			g_st_mhzms[c] += (uint64_t)(g_osm_base[c] ? g_osm_mhz[c][g_osm_row[c]] : 0) * us / 1000u;
+		}
+		if (g_gpu_nlevels != 0) {
+			g_st_mhzms[GOV_CL] += (uint64_t)g_gpu_mhz[g_gpu_level < g_gpu_nlevels ? g_gpu_level : 0] * us / 1000u;
+		}
+	}
+	g_st_at = now;
+}
