+/*
+ * The battery's current and voltage every 100 ms (the PM8150B fuel gauge's live mirrors, fg-batt-info 0x41A2/0x41A0,
+ * their latched copies at +6 to reject torn reads; read only, as SweetBattery.cpp): kern.sweet_power -- running sums
+ * of mA*ms and mW*ms (drawn from the battery positive), the samples, the last mA and mV.
+ */
+extern int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+static int64_t g_pw_mams, g_pw_mwms;
+static uint64_t g_pw_ms, g_pw_at;
+static uint32_t g_pw_n;
+static int g_pw_ma;
+static uint32_t g_pw_mv;
+
+static bool
+pw_word(unsigned addr, uint16_t *v)
+{
+	for (unsigned attempt = 0; attempt < 4u; attempt++) {
+		uint8_t a0, a1, b0, b1;
+		if (sweet_spmi_read(2, addr, &a0) || sweet_spmi_read(2, addr + 1u, &a1) || sweet_spmi_read(2, addr + 6u, &b0) ||
+		    sweet_spmi_read(2, addr + 7u, &b1)) {
+			return false;
+		}
+		if (a0 == b0 && a1 == b1) {
+			*v = (uint16_t)(a0 | (a1 << 8));
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+pw_sample(uint64_t now)
+{
+	uint16_t vraw, iraw;
+	uint64_t ns = 0;
+	if (!pw_word(0x41A0u, &vraw) || !pw_word(0x41A2u, &iraw)) {
+		g_pw_at = 0;
+		return;
+	}
+	int sraw = (iraw & 0x8000u) ? (int)iraw - 65536 : (int)iraw;
+	int ma = (int)((int64_t)sraw * 488281 / 1000000);           /* positive: drawn from the battery */
+	uint32_t mv = (uint32_t)(((uint64_t)vraw * 122070u) / 1000000u);
+	if (g_pw_at != 0) {
+		absolutetime_to_nanoseconds(now - g_pw_at, &ns);
+		uint64_t ms = ns / NSEC_PER_MSEC;
+		g_pw_mams += (int64_t)ma * (int64_t)ms;
+		g_pw_mwms += (int64_t)ma * (int64_t)mv / 1000 * (int64_t)ms;
+		g_pw_ms += ms;
+	}
+	g_pw_at = now;
+	g_pw_ma = ma;
+	g_pw_mv = mv;
+	g_pw_n++;
+}
+
+static int
+sysctl_sweet_power SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char s[200];
+	snprintf(s, sizeof(s), "ms %llu mAms %lld mWms %lld n %u ma %d mv %u", g_pw_ms, g_pw_mams, g_pw_mwms, g_pw_n, g_pw_ma, g_pw_mv);
+	return SYSCTL_OUT(req, s, strlen(s) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_power, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_power, "A", "battery current and power sums (mA*ms, mW*ms, drawn positive) every 100 ms");
+
+/*
+ * The SoC's temperatures (TSENS, stock DTB tsens@c222000 / @c223000, their TM blocks at 0xc263000 / 0xc265000; a
+ * sensor's word at 0xa0 + 4n: bits 11:0 tenths of a degree, signed, bit 21 valid), read every 100 ms with the power:
+ * kern.sweet_temps -- now and the highest since the last read (which starts it again), silver / big / GPU / DDR, tenths.
+ */
+static vm_offset_t g_ts[2];
+static int g_ts_now[4], g_ts_peak[4];
+static bool g_ts_tried;
+
+static int
+ts_read(unsigned blk, unsigned n)
+{
+	uint32_t w = gpu_rd(g_ts[blk], 0xa0u + 4u * n);
+	int t = (int)(w & 0xfffu);
+	if (!(w & (1u << 21))) {
+		return -9999;
+	}
+	return t & 0x800 ? t - 0x1000 : t;
+}
+
+static void
+ts_sample(void)
+{
+	/* tsens0 1-4 cpu-0-x (silver), 7-14 cpu-1-x (gold, prime), 15 gpuss-0; tsens1 11 gpuss-1, 3 ddr */
+	int v[4] = { -9999, -9999, -9999, -9999 };
+	if (!g_ts_tried) {
+		g_ts_tried = true;
+		g_ts[0] = ml_io_map(0xc263000u, 0x1000u);
+		g_ts[1] = ml_io_map(0xc265000u, 0x1000u);
+	}
+	if (!g_ts[0] || !g_ts[1]) {
+		return;
+	}
+	for (unsigned n = 1; n <= 4u; n++) {
+		v[0] = GOV_MAX(v[0], ts_read(0, n));
+	}
+	for (unsigned n = 7; n <= 14u; n++) {
+		v[1] = GOV_MAX(v[1], ts_read(0, n));
+	}
+	v[2] = GOV_MAX(ts_read(0, 15), ts_read(1, 11));
+	v[3] = ts_read(1, 3);
+	for (unsigned i = 0; i < 4u; i++) {
+		g_ts_now[i] = v[i];
+		g_ts_peak[i] = GOV_MAX(g_ts_peak[i], v[i]);
+	}
+}
+
+static int
+sysctl_sweet_temps SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char s[160];
+	snprintf(s, sizeof(s), "silver %d big %d gpu %d ddr %d peak %d %d %d %d", g_ts_now[0], g_ts_now[1], g_ts_now[2],
+	    g_ts_now[3], g_ts_peak[0], g_ts_peak[1], g_ts_peak[2], g_ts_peak[3]);
+	for (unsigned i = 0; i < 4u; i++) {
+		g_ts_peak[i] = g_ts_now[i];
+	}
+	return SYSCTL_OUT(req, s, strlen(s) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_temps, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_temps, "A", "SoC temperatures (tenths of a degree): silver big GPU DDR, now and peak since the last read");
