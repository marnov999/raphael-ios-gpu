+/*
+ * (0151) The MIUI-like governor: clocks/gov=1 MIUI's own numbers (research/miui-dvfs.md: schedutil 80% target load
+ * and hispeed jumps on 10 ms windows; the perf HAL's gesture floors -- touch-down 80 ms, finger down, 800 ms after a
+ * swipe's lift, all at their top for 400 ms for an app's opening or closing; the GPU from its slowest level, one
+ * level up a sample while busy, back a level after 80 / 500 ms of little work), gov=2 the same rules with this
+ * port's own numbers (/usr/local/gltest/gov, key=value or key=L3,silver,gold,prime). gov=0: the clocks as asked,
+ * as before. The load: each CPU's idle time from the scheduler's accounting (sweet_cpu_idle_mach, sched_prim.c),
+ * the GPU's from its own cycle counts per submission (gpu_times).
+ */
+#define GOV_TICK_MS 10u
+enum { GOV_L3, GOV_S, GOV_G, GOV_P, GOV_CL };
+struct gov_prof {
+	uint32_t tl, hs_load, hs[GOV_CL], base[GOV_CL], down_ticks;
+	uint32_t in_s, in_ms;
+	uint32_t pf[GOV_CL], pf_ms;
+	uint32_t dr[GOV_CL];
+	uint32_t fl[GOV_CL], fl_ms;
+	uint32_t tr[GOV_CL], tr_ms, tr_gpu;
+	uint32_t gpu_base, gpu_up, gpu_up2, gpu_dn, gpu_dn_ms, gpu_mid, gpu_mid_ms;
+	uint32_t l3_pct;
+};
+#define GOV_TOP 9999u
+static const struct gov_prof g_gov_miui = {
+	.tl = 80, .hs_load = 90, .hs = { 0, 1209, 1612, 1612 }, .base = { 300, 576, 710, 825 }, .down_ticks = 2,
+	.in_s = 1382, .in_ms = 120,
+	.pf = { 806, 1555, 1612, 1612 }, .pf_ms = 80,
+	.dr = { 806, 1036, 1056, 1056 },
+	.fl = { 806, 1555, 1612, 1612 }, .fl_ms = 800,
+	.tr = { GOV_TOP, GOV_TOP, GOV_TOP, GOV_TOP }, .tr_ms = 400, .tr_gpu = 499,
+	.gpu_base = 257, .gpu_up = 85, .gpu_up2 = 95, .gpu_dn = 50, .gpu_dn_ms = 80, .gpu_mid = 70, .gpu_mid_ms = 500,
+	.l3_pct = 100,
+};
+static const struct gov_prof g_gov_tuned0 = {
+	.tl = 60, .hs_load = 75, .hs = { 0, 1209, 1804, 2016 }, .base = { 300, 576, 710, 825 }, .down_ticks = 4,
+	.in_s = 1382, .in_ms = 150,
+	.pf = { 1344, 1555, 2016, 2419 }, .pf_ms = 120,
+	.dr = { 1036, 1209, 1612, 1804 },
+	.fl = { 1344, 1555, 2016, 2419 }, .fl_ms = 1000,
+	.tr = { GOV_TOP, GOV_TOP, GOV_TOP, GOV_TOP }, .tr_ms = 600, .tr_gpu = 499,
+	.gpu_base = 345, .gpu_up = 75, .gpu_up2 = 90, .gpu_dn = 40, .gpu_dn_ms = 100, .gpu_mid = 60, .gpu_mid_ms = 500,
+	.l3_pct = 125,
+};
+static struct gov_prof g_gov_tuned;
+static bool g_gov_tuned_set;
+
+/* /usr/local/gltest/gov: "name=V" or "name=L3,S,G,P" pairs, whitespace apart, onto the tuned profile */
+static const struct { const char *name; size_t off; unsigned n; } g_gov_keys[] = {
+#define GK(f, n) { #f, __builtin_offsetof(struct gov_prof, f), n }
+	GK(tl, 1), GK(hs_load, 1), GK(hs, 4), GK(base, 4), GK(down_ticks, 1), GK(in_s, 1), GK(in_ms, 1),
+	GK(pf, 4), GK(pf_ms, 1), GK(dr, 4), GK(fl, 4), GK(fl_ms, 1), GK(tr, 4), GK(tr_ms, 1), GK(tr_gpu, 1),
+	GK(gpu_base, 1), GK(gpu_up, 1), GK(gpu_up2, 1), GK(gpu_dn, 1), GK(gpu_dn_ms, 1), GK(gpu_mid, 1),
+	GK(gpu_mid_ms, 1), GK(l3_pct, 1),
+#undef GK
+};
