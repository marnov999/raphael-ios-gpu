+	    "busy %u/%u/%u gpu%% %u rows %u/%u/%u/%u lvl %u",
+	    g_st_ms_x1000 / 1000u, g_st_mhzms[0], g_st_mhzms[1], g_st_mhzms[2], g_st_mhzms[3], g_st_mhzms[4], g_clocks.gov,
+	    g_t_taps, g_t_swipes, g_gov_busy[1], g_gov_busy[2], g_gov_busy[3], g_gov_gpu_busy, g_osm_row[0], g_osm_row[1],
+	    g_osm_row[2], g_osm_row[3], g_gpu_level);
+	return SYSCTL_OUT(req, s, strlen(s) + 1);
+}
