+static void
+gov_file(void)
+{
+	char text[768];
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx;
+	int resid = 0;
+	struct gov_prof p = g_gov_tuned0;
+	if (rootvnode == NULLVP) {
+		return;
+	}
+	ctx = vfs_context_kernel();
+	if (vnode_lookup("/usr/local/gltest/gov", 0, &vp, ctx) == 0) {
+		bzero(text, sizeof(text));
+		(void)vn_rdwr(UIO_READ, vp, (caddr_t)text, sizeof(text) - 1, 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx),
+		    &resid, vfs_context_proc(ctx));
+		vnode_put(vp);
+		for (char *at = text; *at != '\0';) {
+			char *name = at, *eq;
+			while (*at != '\0' && *at != ' ' && *at != '\n' && *at != '\t') {
+				at++;
+			}
+			if (*at != '\0') {
+				*at++ = '\0';
+			}
+			if ((eq = strchr(name, '=')) == NULL) {
+				continue;
+			}
+			*eq++ = '\0';
+			for (unsigned k = 0; k < sizeof(g_gov_keys) / sizeof(g_gov_keys[0]); k++) {
+				uint32_t *f = (uint32_t *)((char *)&p + g_gov_keys[k].off);
+				if (strcmp(name, g_gov_keys[k].name) != 0) {
+					continue;
+				}
+				for (unsigned i = 0; i < g_gov_keys[k].n && *eq >= '0' && *eq <= '9'; i++) {
+					uint32_t v = 0;
+					while (*eq >= '0' && *eq <= '9') {
+						v = v * 10u + (uint32_t)(*eq++ - '0');
+					}
+					f[i] = v;
+					if (*eq == ',') {
+						eq++;
+					}
+				}
+			}
+		}
+	}
+	if (!g_gov_tuned_set || memcmp(&p, &g_gov_tuned, sizeof(p)) != 0) {
+		g_gov_tuned = p;
+		g_gov_tuned_set = true;
+		printf("SWEET GOV: tuned profile: tl %u hs_load %u hs %u/%u/%u pf %u/%u/%u/%u dr %u/%u/%u/%u fl %u/%u/%u/%u "
+		    "%u ms tr %u ms GPU>=%u base GPU %u up %u/%u dn %u@%u mid %u@%u l3 %u%%\n",
+		    p.tl, p.hs_load, p.hs[1], p.hs[2], p.hs[3], p.pf[0], p.pf[1], p.pf[2], p.pf[3], p.dr[0], p.dr[1], p.dr[2],
+		    p.dr[3], p.fl[0], p.fl[1], p.fl[2], p.fl[3], p.fl_ms, p.tr_ms, p.tr_gpu, p.gpu_base, p.gpu_up, p.gpu_up2,
+		    p.gpu_dn, p.gpu_dn_ms, p.gpu_mid, p.gpu_mid_ms, p.l3_pct);
+	}
+}
+
+/* The touches: from the panel's digitizer (SweetHID.cpp sweet_hid_touch) and from hidtouch (kern.sweet_dvfs_kick) */
+static volatile uint64_t g_t_down_at, g_t_input_until, g_t_fling_until, g_t_tr_until;
+static volatile int g_t_down, g_t_x0, g_t_y0, g_t_travel, g_t_edge;
+static volatile uint32_t g_t_taps, g_t_swipes;
+#define GOV_PANEL_H 2340
+#define GOV_EDGE_PX 60
+#define GOV_TAP_PX 60
+
+static uint64_t
+gov_ms(uint32_t ms)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &t);
+	return t;
+}
+
+static const struct gov_prof *
+gov_prof(void)
+{
+	return g_clocks.gov == 1 ? &g_gov_miui : &g_gov_tuned;
+}
+
+void sweet_dvfs_touch(int down, int x, int y);
+void
+sweet_dvfs_touch(int down, int x, int y)
+{
+	const struct gov_prof *p = gov_prof();
+	uint64_t now = mach_absolute_time();
+	if (down && !g_t_down) {
+		g_t_down = 1;
+		g_t_down_at = now;
+		g_t_x0 = x;
+		g_t_y0 = y;
+		g_t_travel = 0;
+		g_t_edge = y >= GOV_PANEL_H - GOV_EDGE_PX;
+		g_t_fling_until = 0;            /* (MIUI lets the fling's floor go at the next touch-down) */
+	} else if (down) {
+		int d = (x > g_t_x0 ? x - g_t_x0 : g_t_x0 - x) + (y > g_t_y0 ? y - g_t_y0 : g_t_y0 - y);
+		if (d > g_t_travel) {
+			g_t_travel = d;
+		}
+	} else if (g_t_down) {
+		uint64_t held = now - g_t_down_at;
+		int d = (x > g_t_x0 ? x - g_t_x0 : g_t_x0 - x) + (y > g_t_y0 ? y - g_t_y0 : g_t_y0 - y);
+		if (d > g_t_travel) {
+			g_t_travel = d;
+		}
+		g_t_down = 0;
+		if (g_t_travel < GOV_TAP_PX && held < gov_ms(350)) {
+			g_t_tr_until = now + gov_ms(p->tr_ms);      /* a tap: an app may open (MIUI: the resume boost) */
+			g_t_taps++;
+		} else {
+			g_t_fling_until = now + gov_ms(p->fl_ms);
+			if (g_t_edge) {
+				g_t_tr_until = now + gov_ms(p->tr_ms);  /* from the bottom edge: an app closes, the switcher */
+			}
+			g_t_swipes++;
+		}
+	}
+	g_t_input_until = now + gov_ms(p->in_ms);
+	if (g_dvfs_on && g_clocks.gov != 0) {
+		thread_wakeup((event_t)&g_dvfs_chan);
+	}
+}
+
+extern uint64_t sweet_cpu_idle_mach(int cpu);   /* osfmk/kern/sched_prim.c */
+static const struct { int first, n; } g_gov_cpus[GOV_CL] = { { 0, 0 }, { 0, 4 }, { 4, 3 }, { 7, 1 } };
+
+static uint32_t
+gov_row(unsigned c, uint32_t mhz)
+{
+	for (uint32_t r = 0; r <= g_osm_top[c]; r++) {
+		if (g_osm_mhz[c][r] >= mhz) {
+			return r;
+		}
+	}
+	return g_osm_top[c];
+}
+
+/* memlat's tables (stock DTB): a cluster's busy-weighted MHz -> L3 MHz */
+static uint32_t
+gov_l3_vote(unsigned c, uint32_t eff)
+{
+	static const uint16_t s_in[] = { 300, 499, 576, 672, 768, 940, 1036, 1113, 1209, 1305, 1382, 1478, 1632 },
+	    s_out[] = { 300, 403, 499, 614, 710, 806, 902, 998, 1075, 1171, 1267, 1344, 1536, 1612 };
+	static const uint16_t g_in[] = { 300, 825, 1171, 1401, 1708, 2016, 2419 },
+	    g_out[] = { 300, 614, 806, 998, 1267, 1344, 1536, 1612 };
+	const uint16_t *in = c == GOV_S ? s_in : g_in, *out = c == GOV_S ? s_out : g_out;
+	unsigned n = c == GOV_S ? sizeof(s_in) / sizeof(s_in[0]) : sizeof(g_in) / sizeof(g_in[0]);
+	if (eff == 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		if (eff <= in[i]) {
+			return out[i];
+		}
+	}
+	return out[n];
+}
+
+static uint64_t g_gov_idle_was[8], g_gov_was_at;
+static uint32_t g_gov_down_n[GOV_CL], g_gov_full_n[GOV_CL];
+static uint64_t g_gov_gpu_was_ticks, g_gov_gpu_busy_us, g_gov_gpu_tot_us, g_gov_gpu_changed_at;
+static volatile uint32_t g_gov_busy[GOV_CL];    /* the last tick's busiest CPU of each cluster, permille */
+static volatile uint32_t g_gov_gpu_busy;        /* the GPU's, percent, over the last window */
+
+static void
+gov_tick(uint64_t now)
+{
+	const struct gov_prof *p = gov_prof();
+	uint32_t floor[GOV_CL], busy[GOV_CL] = { 0 }, eff[GOV_CL] = { 0 }, want[GOV_CL];
+	uint64_t dt = g_gov_was_at ? now - g_gov_was_at : 0, dt_ns = 0;
+	bool touching = g_t_down != 0, tr = now < g_t_tr_until;
+	absolutetime_to_nanoseconds(dt, &dt_ns);
+	bool sample = g_gov_was_at == 0 || dt_ns >= 5u * NSEC_PER_MSEC;     /* (a touch's wake: the floors only) */
+	/* the floors of the gesture now */
+	for (unsigned c = 0; c < GOV_CL; c++) {
+		floor[c] = p->base[c];
+#define GOV_MAX(a, b) ((a) > (b) ? (a) : (b))
+		if (touching) {
+			floor[c] = GOV_MAX(floor[c], now - g_t_down_at < gov_ms(p->pf_ms) ? p->pf[c] : p->dr[c]);
+		}
+		if (now < g_t_fling_until) {
+			floor[c] = GOV_MAX(floor[c], p->fl[c]);
+		}
+		if (tr) {
+			floor[c] = GOV_MAX(floor[c], p->tr[c]);
+		}
+	}
+	if (now < g_t_input_until) {
+		floor[GOV_S] = GOV_MAX(floor[GOV_S], p->in_s);
+	}
+	if (!sample) {
+		for (unsigned c = 0; c < GOV_CL; c++) {
+			uint32_t row = gov_row(c, floor[c]);
+			if (row > g_osm_row[c]) {
+				osm_set(c, row);
+				g_gov_down_n[c] = 0;
+			}
+		}
+		if (tr && g_kgsl_ready && g_gpu_nlevels != 0) {
+			uint32_t f = g_gpu_level;
+			for (uint32_t i = g_gpu_nlevels; i-- > 0;) {
+				if (g_gpu_mhz[i] >= p->tr_gpu) {
+					f = i;                  /* the slowest level at or above tr_gpu */
+					break;
+				}
+			}
+			if (f < g_gpu_level) {
+				uint64_t o = 0;
+				gpu_lock();
+				g_level_quiet = 1;
+				g_level_nowait = 1;
+				(void)gpu_set_level(f, &o);
+				g_level_nowait = 0;
+				g_level_quiet = 0;
+				gpu_unlock();
+				g_gov_gpu_changed_at = now;
+			}
+		}
+		return;
+	}
+	/* each cluster's load */
+	for (int cpu = 0; cpu < 8; cpu++) {
+		uint64_t idle = sweet_cpu_idle_mach(cpu), d;
+		uint32_t b = 0;
+		if (idle == UINT64_MAX) {
+			continue;
+		}
+		if (dt != 0 && g_gov_idle_was[cpu] != 0) {
+			d = idle > g_gov_idle_was[cpu] ? idle - g_gov_idle_was[cpu] : 0;
+			b = d >= dt ? 0 : (uint32_t)(1000u - d * 1000u / dt);
+		}
+		g_gov_idle_was[cpu] = idle;
+		for (unsigned c = GOV_S; c < GOV_CL; c++) {
+			if (cpu >= g_gov_cpus[c].first && cpu < g_gov_cpus[c].first + g_gov_cpus[c].n && b > busy[c]) {
+				busy[c] = b;
+			}
+		}
+	}
+	g_gov_was_at = now;
+	for (unsigned c = GOV_S; c < GOV_CL; c++) {
+		uint32_t cur = g_osm_mhz[c][g_osm_row[c]], util = busy[c] * cur / 1000u, w = util * 100u / (p->tl ? p->tl : 80u);
+		eff[c] = util;
+		g_gov_busy[c] = busy[c];
+		if (busy[c] * 100u >= p->hs_load * 1000u) {
+			w = GOV_MAX(w, p->hs[c]);
+		}
+		g_gov_full_n[c] = busy[c] >= 980u ? g_gov_full_n[c] + 1u : 0;
+		if (g_gov_full_n[c] >= 2u) {
+			w = GOV_TOP;                    /* (schedutil: a cluster that stays full goes to its top) */
+		}
+		want[c] = GOV_MAX(w, floor[c]);
+	}
+	{
+		uint32_t l3 = GOV_MAX(gov_l3_vote(GOV_S, eff[GOV_S]), GOV_MAX(gov_l3_vote(GOV_G, eff[GOV_G]), gov_l3_vote(GOV_P, eff[GOV_P])));
+		want[GOV_L3] = GOV_MAX(l3 * p->l3_pct / 100u, floor[GOV_L3]);
+	}
+	for (unsigned c = 0; c < GOV_CL; c++) {
+		uint32_t row = gov_row(c, want[c]);
+		if (row > g_osm_row[c]) {
+			osm_set(c, row);
+			g_gov_down_n[c] = 0;
+		} else if (row < g_osm_row[c]) {
+			if (++g_gov_down_n[c] >= GOV_MAX(p->down_ticks, 1u)) {
+				osm_set(c, row);
+				g_gov_down_n[c] = 0;
+			}
+		} else {
+			g_gov_down_n[c] = 0;
+		}
+	}
+	/* the GPU */
+	if (g_kgsl_ready && g_gpu_nlevels != 0) {
+		uint32_t lvl = g_gpu_level < g_gpu_nlevels ? g_gpu_level : g_gpu_nlevels - 1u, mhz = g_gpu_mhz[lvl], slowest = 0,
+		    fastest_floor = g_gpu_nlevels - 1u;
+		uint64_t ticks, held_ns = 0;
+		gpu_lock();
+		gpu_times();
+		ticks = g_gpu_busy_ticks;
+		gpu_unlock();
+		if (g_gov_gpu_was_ticks != 0 && mhz != 0) {
+			g_gov_gpu_busy_us += (ticks - g_gov_gpu_was_ticks) / mhz;
+			g_gov_gpu_tot_us += dt_ns / 1000u;
+		}
+		g_gov_gpu_was_ticks = ticks;
+		for (uint32_t i = 0; i < g_gpu_nlevels; i++) {
+			if (g_gpu_mhz[i] >= p->gpu_base) {
+				slowest = i;            /* the slowest level at or above the floor at rest */
+			}
+			if (tr && g_gpu_mhz[i] >= p->tr_gpu) {
+				fastest_floor = i;
+			}
+		}
+		absolutetime_to_nanoseconds(now - g_gov_gpu_changed_at, &held_ns);
+		if (g_gov_gpu_tot_us >= 10000u) {
+			uint32_t b = (uint32_t)(g_gov_gpu_busy_us * 100u / g_gov_gpu_tot_us), held_ms = (uint32_t)(held_ns / NSEC_PER_MSEC);
+			g_gov_gpu_busy = b;
+			if (b > p->gpu_up2 && lvl >= 2u) {
+				lvl -= 2u;
+			} else if (b > p->gpu_up && lvl >= 1u) {
+				lvl -= 1u;
+			} else if (b < p->gpu_dn && held_ms >= p->gpu_dn_ms) {
+				lvl += 1u;
+			} else if (b < p->gpu_mid && held_ms >= p->gpu_mid_ms) {
+				lvl += 1u;
+			}
+			g_gov_gpu_busy_us = g_gov_gpu_tot_us = 0;
+		}
+		if (lvl > slowest) {
+			lvl = slowest;
+		}
+		if (tr && lvl > fastest_floor) {
+			lvl = fastest_floor;
+		}
+		if (lvl != g_gpu_level) {
+			uint64_t o = 0;
+			gpu_lock();
+			g_level_quiet = 1;
+			g_level_nowait = 1;
+			(void)gpu_set_level(lvl, &o);
+			g_level_nowait = 0;
+			g_level_quiet = 0;
+			gpu_unlock();
+			g_gov_gpu_changed_at = now;
+		}
+	}
+}
