diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
new file mode 100644
index 0000000..ef03078
--- /dev/null
+++ b/bsd/dev/sweet_touch.c
@@ -0,0 +1,1235 @@
+/*
+ * SWEET SE7 FIFO I2C / GT9896 Yellowstone / Focaltech 54:52 bring-up.
+ * Call once after the scheduler is running; all work runs on one thread.
+ * Requires ABL-loaded GENI I2C firmware; votes L11C through sweet_rpmh.c.
+ * No firmware/config upload or direct PMIC writes. Only IC data write:
+ * zero to GT9896's event status after reading a report. See touch2/report.md.
+ *
+ * RAPHAEL (Redmi K20 Pro, SM8150): Goodix GT9889 @0x5d on GENI SE19
+ * (i2c@c88000 = QUPV3_WRAP2_S2), powered by TLMM GPIOs (no RPMh vote),
+ * 0x824E GTX8-style event protocol. See NOTES-RAPHAEL.md.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_touch_init(void);
+
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+/* Panel configs extracted from the raphael vendor blob (see the GT9886
+ * comment at the GT9886_* defines for provenance). RAPHAEL-only: the SWEET
+ * arm keeps its classic-GT9xx path and does not reference these arrays. */
+#include "gt9886_cfg.h"
+/* SM8150: TLMM base 0x03000000 is split into per-tile blocks; a GPIO
+ * register address = tile base + 0x1000 * global GPIO id (pinctrl-sm8150.c:
+ * SOUTH 0x00D00000, NORTH 0x00900000, EAST 0x00500000, WEST 0x00100000).
+ * Every touch GPIO (54/57/58/98/100/122) is SOUTH-tile, so the GPIO window
+ * starts at 0x03000000 + 0x00D00000 = 0x03D00000. Mapping the TLMM base
+ * itself (as this driver did from 0083 through t10) put every mux, output,
+ * rail-power and reset write into an unimplemented region: the touch IC
+ * never powered on, SDA/SCL never muxed to qup19 -- exactly the "bus
+ * idle/live all zero" signature in the t10 log. Touch is SE19 @ 0xc88000
+ * (GCC_QUPV3_WRAP2_S2: vote BIT(6)@0x52014, RCG 0x1e3a8). Power via TLMM
+ * GPIOs per raphael-sm8150.dtsi: vdd 3v3 = GPIO98, avdd 1v8 = GPIO100,
+ * reset = GPIO54, IRQ = GPIO122, SDA/SCL = GPIO57/58 (qup19). */
+#define TOUCH_SE_PA      0x00c88000u
+#define TOUCH_GCC_PA     0x00100000u
+/* 0x80000 covers global ids 0..127: gpio122 IN_OUT ends at 0x7a004. */
+#define TOUCH_GPIO_PA    0x03D00000u
+#define TOUCH_GCC_VOTE   0x52014u
+#define TOUCH_RCG       0x1e3a8u    /* wrap2_s2 cmd_rcgr (SE19) */
+#define TOUCH_VOTE_MASK ((1u << 1) | (1u << 2) | (1u << 6)) /* s_ahb|m_ahb|s2 */
+#define TOUCH_GPIO_RESET 54u
+#define TOUCH_GPIO_IRQ   122u
+#define TOUCH_GPIO_VDD   98u         /* 3v3 rail enable, output high */
+#define TOUCH_GPIO_AVDD  100u        /* 1v8 rail enable, output high */
+#define TOUCH_GPIO_SDA   57u
+#define TOUCH_GPIO_SCL   58u
+#define TOUCH_MAX_Y      2339u
+#else
+#define TOUCH_SE_PA      0x00a84000u
+#define TOUCH_GCC_PA     0x00100000u
+#define TOUCH_GPIO_PA    0x03900000u /* DT TLMM + NORTH (0x500000) */
+#define TOUCH_GCC_VOTE   0x5200cu
+#define TOUCH_RCG       0x18148u    /* wrapper1 LOCAL S1 = global SE7 */
+#define TOUCH_VOTE_MASK ((0x0fu << 18) | (1u << 23))
+#define TOUCH_GPIO_RESET 8u
+#define TOUCH_GPIO_IRQ   9u
+#define TOUCH_GPIO_VDD   90u
+#define TOUCH_GPIO_AVDD  90u
+#define TOUCH_GPIO_SDA   6u
+#define TOUCH_GPIO_SCL   7u
+#define TOUCH_MAX_Y      2399u
+#endif
+#define TOUCH_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define TOUCH_GPIO_IO(n)  (TOUCH_GPIO_CFG(n) + 4u)
+#define TOUCH_MAX        10u
+#define TOUCH_GOODIX     1
+#define TOUCH_FTS        2
+#define TOUCH_GOODIX9886 3
+#define TOUCH_STFTS      4
+/* GT9886 "normandy" (raphael GT9886/9889 family, goodix_driver_gt9886).
+ * The register map is NOT the classic GT9xx 0x81xx map and NOT the
+ * 0x824x map this driver assumed through t11: every address below is
+ * taken from the raphael cfg-blob reg table (goodix_gt9886_cfg_f11.bin)
+ * which the vendor driver programs verbatim (goodix_ts_i2c.c). The IC
+ * also requires its 784-byte panel config download on every boot --
+ * without it the firmware never posts touch frames. Frame at 0x4100:
+ * b[0] event flags (bit7 touch, bit6 request, bit5 gesture), b[1] bit4
+ * have_key + bits3:0 count, then 8 bytes per point (id, x lo, x hi,
+ * y lo, y hi, w, rsvd, area), little-endian; the whole 4+8n frame sums
+ * to zero mod 256. Ack by writing one zero byte to 0x4100. */
+#define GT9886_PID_REG     0x4535u  /* 4-byte ASCII product id, expect "9886" */
+#define GT9886_SENSOR_REG  0x4541u  /* panel supplier id, mask 0x0f */
+#define GT9886_VER_BASE    0x452cu  /* 72-byte version block, sums to zero */
+#define GT9886_VER_LEN     72u
+#define GT9886_CMD_REG     0x6f68u  /* 3-byte command channel */
+#define GT9886_CFG_REG     0x6f78u  /* config window */
+#define GT9886_COOR_REG    0x4100u  /* touch frames */
+#define GT9886_POINT_LEN   8u
+#define GT9886_TOUCH_EV    0x80u
+#define GT9886_REQUEST_EV  0x40u
+#define GT9886_DOZE_CTRL   0x30f0u  /* 0xAA = keep awake, 0xCC = may doze */
+#define GT9886_DOZE_STAT   0x3100u  /* 0xBB = confirmed awake */
+#define GT9886_CMD_READY   0xffu
+#define GT9886_CMD_START   0x80u
+#define GT9886_CMD_PREPARE 0x82u
+#define GT9886_CMD_END     0x83u
+#define GOODIX_PID_REG   0x4022u
+#define GOODIX_EVENT_REG 0x4180u
+#define GOODIX_HEAD_LEN  8u
+#define GOODIX_POINT_LEN 8u
+
+/* ST FTS (FingerTipS), carried as fts_521 in the raphael kernel source:
+ * I2C 0x49; hw-register reads are 0xFA + 4 big-endian address bytes
+ * (fts_lib/ftsIO.c fts_writeReadU8UX); chip id at 0x20000000; event FIFO
+ * read = write 0x86, then 8-byte events where b[7]&0x1f counts the rest
+ * (fts.c fts_event_handler); per event b[0]>>4: 1 enter / 2 motion /
+ * 3 leave, id = b[1]>>4, type = b[1]&0xf (1 = finger),
+ * x = ((b[3]&0xf)<<8)|b[2], y = (b[4]<<4)|(b[3]>>4). Read-only bring-up:
+ * no panel-init writes, so sensing must be inherited from the previous OS. */
+#define STFTS_ADDR       0x49u
+#define STFTS_FIFO_CMD   0x86u
+#define STFTS_EVT_LEN    8u
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+static struct {
+        vm_offset_t se, gcc, gpio;
+        bool started, dead, probing, flip;
+        int kind, irq_hint;
+        uint32_t irq_status, irq_last, active;
+        unsigned sent, got;
+        int x[TOUCH_MAX], y[TOUCH_MAX];
+} st;
+static int touch_sleep_chan;
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+        uint32_t v = *(volatile uint32_t *)(base + off);
+        __asm__ volatile("dmb oshld" ::: "memory");
+        return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+        __asm__ volatile("dmb oshst" ::: "memory");
+        *(volatile uint32_t *)(base + off) = val;
+        __asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+touch_wait(unsigned ms)
+{
+        uint64_t deadline;
+        clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+        (void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+        thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+        for (unsigned i = 0; i < 5000; ++i) {
+                if (!(touch_rd(base, off) & mask)) {
+                        return true;
+                }
+                delay(1);
+        }
+        return false;
+}
+
+static void
+touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+        uint32_t off = TOUCH_GPIO_CFG(pin);
+        uint32_t cfg = touch_rd(st.gpio, off);
+        if (out) {
+                /* Set the desired latch before enabling output (reset is active low). */
+                touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
+                    (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+        }
+        cfg &= ~0x3ffu;
+        cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+        touch_wr(st.gpio, off, cfg);
+}
+
+static bool
+touch_clocks(void)
+{
+        /* Vote on only the QUP wrapper and the touch SE, preserving other users. */
+        uint32_t mask = TOUCH_VOTE_MASK;
+        touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | mask);
+        uint32_t dfs = touch_rd(st.gcc, TOUCH_RCG + 0x14u);
+        uint32_t cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
+        printf("SWEET TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+            touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, TOUCH_RCG), cfg, dfs);
+        if (dfs & 1u) {
+                /* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+                cfg = touch_rd(st.gcc, TOUCH_RCG + 0x1cu);
+                if ((cfg & 0x371fu) != 1u) {
+                        printf("SWEET TOUCH: DFS level0=%#x is not XO/1; need clock integration\n", cfg);
+                        return false;
+                }
+        } else {
+                /* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+                cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+                touch_wr(st.gcc, TOUCH_RCG + 4u, cfg);
+                touch_wr(st.gcc, TOUCH_RCG, touch_rd(st.gcc, TOUCH_RCG) | 1u);
+                if (!touch_wait_clear(st.gcc, TOUCH_RCG, 1u)) {
+                        printf("SWEET TOUCH: RCG update timeout\n");
+                        return false;
+                }
+        }
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+        /* wrap2 m_ahb / s_ahb / s2 (SE19) CBCRs */
+        const uint32_t branches[] = {0x1e004, 0x1e008, 0x1e3a4};
+#else
+        const uint32_t branches[] = {0x18004, 0x18008, 0x1800c, 0x18010, 0x18144};
+#endif
+        for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+                uint32_t val = touch_rd(st.gcc, branches[i]);
+                if (!(val & (1u << 31))) {
+                        continue; /* running */
+                }
+                /* Linux clk_branch_wait() skips the halt check when the
+                 * branch is in hardware clock-gating mode: with the HWCG
+                 * bit set the clock auto-gates while idle and CLK_OFF reads
+                 * 1 even though the branch is enabled and usable. wrap2
+                 * s_ahb (0x1e008) is such a clock -- its healthy 0x80000002
+                 * used to abort raphael touch bring-up silently. */
+                if (val & (1u << 1)) { /* HWCG mode */
+                        printf("SWEET TOUCH: GCC branch %#x HW-gated (%#x); ok\n",
+                            branches[i], val);
+                        continue;
+                }
+                if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+                        /* Never a hard stop: the SE firmware print below is
+                         * the real verdict on whether the engine is alive. */
+                        printf("SWEET TOUCH: GCC branch %#x still halted (%#x); continuing\n",
+                            branches[i], touch_rd(st.gcc, branches[i]));
+                }
+        }
+        return true;
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+touch_abort(void)
+{
+        touch_wr(st.se, SE_CTRL, 2); /* abort M command, release held bus */
+        bool done = false;
+        for (unsigned i = 0; i < 5000; ++i) {
+                if (touch_rd(st.se, SE_IRQ) & (1u << 5)) {
+                        done = true;
+                        break;
+                }
+                delay(1);
+        }
+        if (!done || !touch_wait_clear(st.se, SE_STATUS, 1u)) {
+                st.dead = true;
+                printf("SWEET TOUCH: abort failed status=%#x irq=%#x; stopping\n",
+                    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ));
+        }
+        /* Bound drain even if the hardware reports an impossible FIFO count. */
+        for (unsigned i = 0; i < 64 && (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+                (void)touch_rd(st.se, SE_RX);
+        }
+        touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+        if (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
+                st.dead = true;
+                printf("SWEET TOUCH: TX FIFO not empty after abort; stopping\n");
+        }
+}
+
+/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
+static uint32_t
+touch_irq(void)
+{
+        st.irq_last = touch_rd(st.se, SE_IRQ);
+        st.irq_status |= st.irq_last;
+        return st.irq_last;
+}
+
+/* One Linux-style FIFO message. TX up to 2+784 bytes (the GT9886 config
+ * download): the FIFO is fed one word per TX-watermark hit, so any length
+ * streams correctly regardless of FIFO depth. RX at most 90. */
+static int
+touch_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+        if (st.dead || nt > 800 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+                return EIO;
+        }
+        if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+                st.dead = true; /* no other SE7 owner is supported */
+                return EBUSY;
+        }
+        touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+        touch_wr(st.se, SE_TX_WM, nt ? 1u : 0u);
+        touch_wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+        touch_wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+            ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+        int err = ETIMEDOUT;
+        for (unsigned i = 0; i < 20000; ++i) {
+                uint32_t irq = touch_irq();
+                if (irq & SE_ERRORS) {
+                        err = (irq & SE_NACK) ? ENXIO : EIO;
+                        /* A completed NACK is normal during address probing. Aborting an
+                         * idle sequencer may never produce ABORT_DONE. Wait for completion
+                         * and leave a clean idle engine available for the other IC. */
+                        for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+                                delay(1);
+                                irq = touch_irq();
+                        }
+                        if ((irq & SE_DONE) && !(touch_rd(st.se, SE_STATUS) & 1u) &&
+                            !(touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) &&
+                            !(touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+                                touch_wr(st.se, SE_IRQ_CLR, irq);
+                                return err;
+                        }
+                        break;
+                }
+                if (nt && st.sent < nt && (irq & SE_TX_WM_IRQ)) {
+                        /* One word per watermark hit (threshold 1: at least
+                         * one slot free). Identical to the old single-word
+                         * path for short commands, and a paced stream for
+                         * the 786-byte config write. */
+                        uint32_t word = 0;
+                        for (unsigned j = 0; j < 4u && st.sent + j < nt; ++j) {
+                                word |= (uint32_t)tx[st.sent + j] << (8u * j);
+                        }
+                        touch_wr(st.se, SE_TX, word);
+                        st.sent += 4u;
+                        if (st.sent >= nt) {
+                                st.sent = nt;
+                                touch_wr(st.se, SE_TX_WM, 0);
+                        }
+                }
+                uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+                if (count > 64 || count > (nr - st.got + 3u) / 4u) {
+                        err = EIO;
+                        break;
+                }
+                while (count--) {
+                        uint32_t word = touch_rd(st.se, SE_RX);
+                        for (unsigned j = 0; j < 4 && st.got < nr; ++j) {
+                                rx[st.got++] = (uint8_t)(word >> (8u * j));
+                        }
+                }
+                /* DONE is checked after draining RX, so final short words aren't lost. */
+                if (irq & SE_DONE) {
+                        /* Re-sample after the final drain; a late error must beat DONE. */
+                        irq = touch_irq();
+                        if (irq & SE_ERRORS) {
+                                continue;
+                        }
+                        touch_wr(st.se, SE_IRQ_CLR, irq);
+                        if (st.got == nr && st.sent == nt) {
+                                return 0;
+                        }
+                        err = EIO;
+                        break;
+                }
+                /* Preserve DONE/errors if they arrive during this iteration. */
+                touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+                delay(1);
+        }
+        touch_abort();
+        return err;
+}
+
+static int
+touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+        st.irq_status = st.irq_last = 0;
+        st.sent = st.got = 0;
+        int err = touch_msg_run(addr, tx, nt, rx, nr, stretch);
+        if (st.probing) {
+                printf("SWEET TOUCH: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+                    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+                    err, st.irq_last, st.irq_status, st.sent, st.got,
+                    touch_rd(st.se, SE_STATUS));
+        }
+        return err;
+}
+
+static int
+touch_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+        uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+        int err = touch_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
+            NULL, 0, true);
+        if (err) {
+                return err;
+        }
+        /* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+        return touch_msg(addr, NULL, 0, buf, len, false);
+}
+
+static int
+touch_goodix_ack(void)
+{
+        const uint8_t ack[3] = {GOODIX_EVENT_REG >> 8, GOODIX_EVENT_REG & 0xffu, 0};
+        return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+/* Raw read only: 0x8240 is the vendor's generic/older VERSION candidate,
+ * not a second accepted GT9896 identity. Never try a four-byte Berlin pointer:
+ * on this 16-bit IC the extra bytes would be register data writes. */
+static int
+touch_probe_info(uint16_t reg, uint8_t *buf)
+{
+        memset(buf, 0xa5, 32);
+        int err = touch_read(0x5d, reg, true, buf, 32);
+        printf("SWEET TOUCH: probe info reg=%#x len=32 err=%d irq=%#x seen=%#x\n",
+            reg, err, st.irq_last, st.irq_status);
+        if (!err) {
+                for (unsigned off = 0; off < 32; off += 16) {
+                        char line[49];
+                        for (unsigned j = 0; j < 16; ++j) {
+                                (void)snprintf(line + j * 3u, 4, "%02x ", buf[off + j]);
+                        }
+                        printf("SWEET TOUCH: probe raw %#x: %s\n", reg + off, line);
+                }
+        }
+        return err;
+}
+
+static unsigned
+touch_be16(const uint8_t *p)
+{
+        return ((unsigned)p[0] << 8) | p[1];
+}
+
+static bool
+touch_checksum(const uint8_t *buf, unsigned len)
+{
+        if (len < 2) {
+                return false;
+        }
+        unsigned sum = 0;
+        for (unsigned i = 0; i + 2 < len; ++i) {
+                sum += buf[i];
+        }
+        return (sum & 0xffffu) == touch_be16(buf + len - 2);
+}
+
+/*
+ * kern.sweet_touch_mute (boot-arg sweettouchmute): 1 drops the touchscreen's own reports (fingers down
+ * are let go once), for measurements without this panel's ghost touches; touches injected from userland
+ * (tools/touch.sh) still come through.
+ */
+static int sweet_touch_mute = -1;
+SYSCTL_INT(_kern, OID_AUTO, sweet_touch_mute, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_touch_mute, 0,
+    "1: the touchscreen's own touches dropped");
+
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+        if (sweet_touch_mute < 0) {
+                sweet_touch_mute = 0;
+                (void)PE_parse_boot_argn("sweettouchmute", &sweet_touch_mute, sizeof(sweet_touch_mute));
+        }
+        if (sweet_touch_mute > 0) {
+                mask = 0;
+        }
+        /* No flip by default: the R14 video was shot while the phone was
+         * physically held upside down (user-confirmed 2026-10-21) -- the
+         * panel and iOS agree and touch needs no rotation. The hook stays:
+         * boot with sweettouchflip=1 to rotate both axes if ever needed. */
+        static int flip = -1;
+        if (flip < 0) {
+                flip = 0;
+                (void)PE_parse_boot_argn("sweettouchflip", &flip, sizeof(flip));
+                if (flip) {
+                        printf("SWEET TOUCH: 180-deg flip on (x'=1079-x, y'=%u-y)\n",
+                            TOUCH_MAX_Y);
+                }
+        }
+        for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+                uint32_t bit = 1u << id;
+                if (mask & bit) {
+                        int px = flip ? 1079 - x[id] : x[id];
+                        int py = flip ? (int)TOUCH_MAX_Y - y[id] : y[id];
+                        if (!(st.active & bit) || px != st.x[id] || py != st.y[id]) {
+                                sweet_hid_touch((int)id, 1, px, py);
+                        }
+                        st.x[id] = px;
+                        st.y[id] = py;
+                } else if (st.active & bit) {
+                        sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+                }
+        }
+        st.active = mask;
+}
+
+static int
+gt9886_clear(void)
+{
+        /* One zero byte to the frame register: clears the event the IC just
+         * posted (vendor goodix_ts_threadirq_func "clean irq flag"). */
+        const uint8_t ack[3] = {GT9886_COOR_REG >> 8, GT9886_COOR_REG & 0xffu, 0};
+        return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+static int
+gt9886_write_reg(uint16_t reg, const uint8_t *data, unsigned len)
+{
+        /* Register pointer + payload as one write; the IC's data pointer
+         * auto-increments within the message. */
+        uint8_t buf[2 + 784];
+        if (len > sizeof(buf) - 2u) {
+                return EIO;
+        }
+        buf[0] = (uint8_t)(reg >> 8);
+        buf[1] = (uint8_t)reg;
+        memcpy(buf + 2, data, len);
+        return touch_msg(0x5d, buf, 2u + len, NULL, 0, false);
+}
+
+static int
+gt9886_cmd(uint8_t op, uint8_t data)
+{
+        /* 3-byte command: {op, data, checksum} to 0x6f68 (vendor
+         * goodix_cmds_init: cmds[2] = 0 - op - data). */
+        const uint8_t cmd[3] = {op, data, (uint8_t)(0u - op - data)};
+        return gt9886_write_reg(GT9886_CMD_REG, cmd, sizeof(cmd));
+}
+
+static int
+gt9886_doze_disable(void)
+{
+        /* Vendor goodix_set_i2c_doze_mode(dev, false): write 0xAA to 0x30F0,
+         * then poll 0x3100 for 0xBB (rewrite 0xAA whenever it reads neither
+         * 0xAA nor 0xBB). Kept disabled afterwards: this driver polls on its
+         * own schedule, not from an interrupt the IC raises while awake. */
+        static const uint8_t aa[1] = {0xaa};
+        for (unsigned i = 0; i < 10u; ++i) {
+                int err = gt9886_write_reg(GT9886_DOZE_CTRL, aa, sizeof(aa));
+                if (err) {
+                        return err;
+                }
+                touch_wait(1);
+                for (unsigned j = 0; j < 10u; ++j) {
+                        uint8_t stat = 0;
+                        err = touch_read(0x5d, GT9886_DOZE_STAT, true, &stat, 1);
+                        if (!err && stat == 0xbbu) {
+                                return 0;
+                        }
+                        if (!err && stat != 0xaau) {
+                                break; /* rewrite 0xAA and retry */
+                        }
+                        touch_wait(10);
+                }
+        }
+        return ETIMEDOUT;
+}
+
+static int
+gt9886_send_config(const uint8_t *cfg, unsigned len)
+{
+        uint8_t rdy = 0;
+        bool ok = false;
+        /* 1. command register free? */
+        for (unsigned i = 0; i < 10u; ++i) {
+                int err = touch_read(0x5d, GT9886_CMD_REG, true, &rdy, 1);
+                if (!err && rdy == GT9886_CMD_READY) {
+                        ok = true;
+                        break;
+                }
+                touch_wait(10);
+        }
+        if (!ok) {
+                printf("SWEET TOUCH: cfg send: cmd reg not ready (%#x)\n", rdy);
+                return EIO;
+        }
+        /* 2. START_SEND_CFG (0x80) */
+        int err = gt9886_cmd(GT9886_CMD_START, 0);
+        if (err) {
+                printf("SWEET TOUCH: cfg send: start cmd err=%d\n", err);
+                return err;
+        }
+        /* 3. wait for PREPARE_OK (0x82), resending on abnormal reads */
+        ok = false;
+        for (unsigned i = 0; i < 10u; ++i) {
+                uint8_t cmd_buf[3] = {0};
+                err = touch_read(0x5d, GT9886_CMD_REG, true, cmd_buf, 3);
+                if (!err && cmd_buf[0] == GT9886_CMD_PREPARE) {
+                        ok = true;
+                        break;
+                }
+                if (!err && cmd_buf[0] != GT9886_CMD_START) {
+                        (void)gt9886_cmd(GT9886_CMD_START, 0);
+                }
+                touch_wait(10);
+        }
+        if (!ok) {
+                printf("SWEET TOUCH: cfg send: no 0x82 prepare\n");
+                return EIO;
+        }
+        /* 4. the 784-byte config itself */
+        err = gt9886_write_reg(GT9886_CFG_REG, cfg, len);
+        if (err) {
+                printf("SWEET TOUCH: cfg send: write %uB err=%d\n", len, err);
+                return err;
+        }
+        /* 5. END_SEND_CFG (0x83), then wait for the register to free */
+        err = gt9886_cmd(GT9886_CMD_END, 0);
+        if (err) {
+                printf("SWEET TOUCH: cfg send: end cmd err=%d\n", err);
+                return err;
+        }
+        ok = false;
+        for (unsigned i = 0; i < 10u; ++i) {
+                err = touch_read(0x5d, GT9886_CMD_REG, true, &rdy, 1);
+                if (!err && rdy == GT9886_CMD_READY) {
+                        ok = true;
+                        break;
+                }
+                touch_wait(10);
+        }
+        if (!ok) {
+                printf("SWEET TOUCH: cfg send: cmd reg stuck after send (%#x)\n", rdy);
+                return EIO;
+        }
+        return 0;
+}
+
+static int
+touch_goodix_9886(void)
+{
+        uint8_t buf[4 + TOUCH_MAX * GT9886_POINT_LEN];
+        int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+        uint32_t mask = 0;
+        /* Frame at 0x4100: read event + count + the first point (12 bytes),
+         * then the remaining points in place. The whole 4+8n frame must sum
+         * to zero mod 256 (vendor checksum_u8 over touch_num*8+4 bytes). */
+        int err = touch_read(0x5d, GT9886_COOR_REG, true, buf, 4 + GT9886_POINT_LEN);
+        if (err) {
+                return err;
+        }
+        if (!(buf[0] & GT9886_TOUCH_EV)) {
+                if (buf[0] & GT9886_REQUEST_EV) {
+                        /* Firmware request (e.g. re-send config): log once,
+                         * clear, and continue -- we cannot service requests
+                         * we have not identified. */
+                        static bool logged = false;
+                        if (!logged) {
+                                printf("SWEET TOUCH: request event %#x; clearing\n",
+                                    buf[0]);
+                                logged = true;
+                        }
+                        (void)gt9886_clear();
+                }
+                return 0; /* no touch frame: retain current contacts */
+        }
+        unsigned n = buf[1] & 15u;
+        if (n > TOUCH_MAX) {
+                (void)gt9886_clear();
+                return EIO;
+        }
+        if (n > 1) {
+                err = touch_read(0x5d, GT9886_COOR_REG + 4u + GT9886_POINT_LEN, true,
+                    buf + 4 + GT9886_POINT_LEN, (n - 1) * GT9886_POINT_LEN);
+                if (err) {
+                        return err;
+                }
+        }
+        unsigned sum = 0;
+        for (unsigned i = 0; i < 4u + n * GT9886_POINT_LEN; ++i) {
+                sum += buf[i];
+        }
+        if ((sum & 0xffu) != 0u) {
+                (void)gt9886_clear();
+                return EIO;
+        }
+        for (unsigned i = 0; i < n; ++i) {
+                const uint8_t *p = buf + 2 + i * GT9886_POINT_LEN;
+                unsigned id = p[0] & 15u;
+                unsigned px = p[1] | ((unsigned)p[2] << 8);
+                unsigned py = p[3] | ((unsigned)p[4] << 8);
+                /* High bit of the id byte marks pen data; vendor drops what
+                 * it cannot parse, so drop silently instead of failing. */
+                if ((p[0] & 0x80u) || id >= TOUCH_MAX || (mask & (1u << id)) ||
+                    px > 1079u || py > TOUCH_MAX_Y) {
+                        continue;
+                }
+                if (st.flip) {
+                        px = 1079u - px;
+                        py = TOUCH_MAX_Y - py;
+                }
+                mask |= 1u << id;
+                x[id] = (int)px;
+                y[id] = (int)py;
+        }
+        err = gt9886_clear();
+        if (!err) {
+                touch_report(mask, x, y);
+        }
+        return err;
+}
+
+static int
+touch_goodix(void)
+{
+        uint8_t buf[90];
+        int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+        uint32_t mask = 0;
+        int err = touch_read(0x5d, GOODIX_EVENT_REG, true, buf, GOODIX_HEAD_LEN);
+        if (err) {
+                return err;
+        }
+        if (!(buf[0] & 0x80u)) {
+                /* Do not acknowledge firmware/config requests that we cannot service. */
+                if (buf[0] & 0x40u) {
+                        return ENOTSUP;
+                }
+                return 0; /* no new touch frame: retain current contacts */
+        }
+        if (!touch_checksum(buf, GOODIX_HEAD_LEN)) {
+                return EIO; /* header untrusted: no write to the IC */
+        }
+        unsigned n = buf[2] & 15u;
+        if (n > TOUCH_MAX) {
+                (void)touch_goodix_ack();
+                return EIO;
+        }
+        if (n) {
+                err = touch_read(0x5d, GOODIX_EVENT_REG + GOODIX_HEAD_LEN, true,
+                    buf + GOODIX_HEAD_LEN, n * GOODIX_POINT_LEN + 2u);
+                if (err) {
+                        return err;
+                }
+                if (!touch_checksum(buf + GOODIX_HEAD_LEN, n * GOODIX_POINT_LEN + 2u)) {
+                        (void)touch_goodix_ack();
+                        return EIO;
+                }
+        }
+        for (unsigned i = 0; i < n; ++i) {
+                const uint8_t *p = buf + GOODIX_HEAD_LEN + i * GOODIX_POINT_LEN;
+                unsigned id = p[0] >> 4;
+                unsigned px = touch_be16(p + 2), py = touch_be16(p + 4);
+                /* Low nibble 1/3 denotes pen data in the vendor parser. */
+                if ((p[0] & 15u) == 1u || (p[0] & 15u) == 3u || id >= TOUCH_MAX ||
+                    (mask & (1u << id)) || px > 1079 || py > TOUCH_MAX_Y) {
+                        (void)touch_goodix_ack();
+                        return EIO;
+                }
+                mask |= 1u << id;
+                x[id] = (int)px;
+                y[id] = (int)py;
+        }
+        err = touch_goodix_ack();
+        if (!err) {
+                touch_report(mask, x, y);
+        }
+        return err;
+}
+
+static int
+touch_focaltech(void)
+{
+        uint8_t buf[63];
+        int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+        uint32_t mask = 0, seen = 0;
+        int err = touch_read(0x38, 0, false, buf, sizeof(buf));
+        if (err) {
+                return err;
+        }
+        unsigned n = buf[2] & 15u, active = 0;
+        if ((buf[0] & 0x70u) || n > TOUCH_MAX) {
+                return EIO;
+        }
+        for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+                const uint8_t *p = buf + 3u + 6u * i;
+                unsigned id = p[2] >> 4, event = p[0] >> 6;
+                if (id >= TOUCH_MAX) {
+                        break; /* vendor's unused-record sentinel */
+                }
+                if (seen & (1u << id)) {
+                        return EIO;
+                }
+                seen |= 1u << id;
+                if (event == 1u) {
+                        continue; /* UP record */
+                }
+                if (event == 3u) {
+                        return EIO;
+                }
+                unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
+                unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
+                if (px > 1079 || py > TOUCH_MAX_Y) {
+                        return EIO;
+                }
+                mask |= 1u << id;
+                x[id] = (int)px;
+                y[id] = (int)py;
+                ++active;
+        }
+        if (active != n) {
+                return EIO;
+        }
+        touch_report(mask, x, y);
+        return 0;
+}
+
+/* ST FTS event FIFO, strictly read-only (see the protocol note above).
+ * Enter/motion update contacts; leave and unknown events just drop ids
+ * from the mask. If the IC is not sensing (fresh power-up without panel
+ * init) the FIFO stays silent and nothing is reported. */
+static int
+touch_stfts(void)
+{
+        uint8_t buf[STFTS_EVT_LEN * 11];
+        int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+        uint32_t mask = 0;
+        const uint8_t cmd = STFTS_FIFO_CMD;
+        /* Repeated-start pair (like touch_read): the pointer write holds the
+         * bus, the zero-TX read pulls the events. touch_msg rejects a single
+         * write+read message by design. */
+        int err = touch_msg(STFTS_ADDR, &cmd, 1, NULL, 0, true);
+        if (err) {
+                return err;
+        }
+        err = touch_msg(STFTS_ADDR, NULL, 0, buf, STFTS_EVT_LEN, false);
+        if (err) {
+                return err;
+        }
+        if (buf[0] == 0x00u) {
+                return 0; /* EVT_ID_NOEVENT: retain current contacts */
+        }
+        unsigned more = buf[7] & 0x1fu;
+        if (more > 10u) {
+                more = 10u; /* 10 more events = 80 bytes, one read <= 90 */
+        }
+        if (more) {
+                err = touch_msg(STFTS_ADDR, &cmd, 1, NULL, 0, true);
+                if (err) {
+                        return err;
+                }
+                err = touch_msg(STFTS_ADDR, NULL, 0, buf + STFTS_EVT_LEN,
+                    more * STFTS_EVT_LEN, false);
+                if (err) {
+                        return err;
+                }
+        }
+        for (unsigned e = 0; e <= more; ++e) {
+                const uint8_t *evt = buf + e * STFTS_EVT_LEN;
+                unsigned id = (evt[1] & 0xf0u) >> 4;
+                unsigned type = evt[1] & 0x0fu;
+                if (evt[0] >> 4 == 0x1u || evt[0] >> 4 == 0x2u) {
+                        /* enter/motion; skip invalid/stylus, accept the rest */
+                        if (type == 0x00u || type == 0x03u || id >= TOUCH_MAX) {
+                                continue;
+                        }
+                        int px = (int)(((evt[3] & 0x0fu) << 8) | evt[2]);
+                        int py = (int)((evt[4] << 4) | ((evt[3] & 0xf0u) >> 4));
+                        if (px > 1079 || py > (int)TOUCH_MAX_Y) {
+                                return EIO;
+                        }
+                        mask |= 1u << id;
+                        x[id] = px;
+                        y[id] = py;
+                }
+                /* 0x3 leave (drop from mask), 0x4 status, 0x5 user, 0xe debug,
+                 * 0xf error: nothing to do; touch_report() drops the ids. */
+        }
+        touch_report(mask, x, y);
+        return 0;
+}
+
+static bool
+touch_se_init(void)
+{
+        uint32_t fw = touch_rd(st.se, SE_FW);
+        uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+        printf("SWEET TOUCH: se7 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
+            fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
+            touch_rd(st.se, 0x908));
+        if (((fw >> 8) & 0xffu) != 3u || (touch_rd(st.se, 0x64) & 1u) ||
+            ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+            ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+                printf("SWEET TOUCH: need ABL-loaded I2C firmware and 32-bit FIFOs; probes skipped\n");
+                return false;
+        }
+        if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+                printf("SWEET TOUCH: SE7 already busy; probes skipped\n");
+                return false;
+        }
+        touch_wr(st.se, 0xe18, 0); /* no GSI events */
+        touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+        touch_wr(st.se, 0x644, 0);
+        touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+        touch_wr(st.se, 0x648, 0xffffffffu);
+        touch_wr(st.se, SE_DMA, 0);
+        touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+        touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+        touch_wr(st.se, 0x24, 0x7f);
+        touch_wr(st.se, 0x20, 1);
+        touch_wr(st.se, SE_CLK_SEL, 0);
+        touch_wr(st.se, SE_MCLK, (7u << 4) | 1u);
+        touch_wr(st.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+        /* Linux 8-bit I2C packing: MSB on the wire, LSB byte first in FIFO. */
+        touch_wr(st.se, 0x254, 0);
+        touch_wr(st.se, 0x260, SE_PACK0);
+        touch_wr(st.se, 0x264, SE_PACK1);
+        touch_wr(st.se, 0x284, SE_PACK0);
+        touch_wr(st.se, 0x288, SE_PACK1);
+        touch_wr(st.se, SE_TX_WM, 0);
+        touch_wr(st.se, 0x810, 0);
+        touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+        touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+        printf("SWEET TOUCH: packing tx=%#x/%#x rx=%#x/%#x gran=%#x\n",
+            touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
+            touch_rd(st.se, 0x284), touch_rd(st.se, 0x288), touch_rd(st.se, 0x254));
+        if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+            touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+            touch_rd(st.se, 0x254) != 0) {
+                printf("SWEET TOUCH: packing readback mismatch; probes skipped\n");
+                return false;
+        }
+        if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+            (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+                printf("SWEET TOUCH: inherited FIFO data; probes skipped\n");
+                return false;
+        }
+        return true;
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+        unsigned delay_s = 45;
+        (void)arg;
+        (void)result;
+        /*
+         * Start late (boot-arg sweettouchdelay, seconds): if the bus access
+         * below hangs the SoC, the persistent log and the GUI got there first.
+         */
+        (void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+        printf("SWEET TOUCH: starting in %u s\n", delay_s);
+        touch_wait(delay_s * 1000u);
+        printf("SWEET TOUCH: mapping GCC/TLMM-south/SE7\n");
+        st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+        st.gpio = ml_io_map(TOUCH_GPIO_PA, 0x80000);
+#else
+        st.gpio = ml_io_map(TOUCH_GPIO_PA, 0x5b000);
+#endif
+        st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
+        if (!st.gcc || !st.gpio || !st.se) {
+                printf("SWEET TOUCH: MMIO mapping failed\n");
+                goto out;
+        }
+        if (!touch_clocks() || !touch_se_init()) {
+                goto out;
+        }
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+        printf("SWEET TOUCH: TLMM reset(gpio%u)=%#x irq(gpio%u)=%#x; GPIO rail power\n",
+            TOUCH_GPIO_RESET, touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_RESET)),
+            TOUCH_GPIO_IRQ, touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_IRQ)));
+        /* IRQ stays an input throughout (vendor tp_active: pull-up, 16 mA). */
+        touch_gpio(TOUCH_GPIO_IRQ, 0, 3, 3, false, false); /* IRQ input, pull-up */
+        /* Cold power cycle: the previous OS may have left the IC mid-transaction
+         * or its rails already sequenced. Hold reset while both GPIO rails go
+         * through a full off/on edge, so every bring-up starts from t0. */
+        touch_gpio(TOUCH_GPIO_RESET, 0, 3, 3, true, false); /* reset asserted */
+        touch_gpio(TOUCH_GPIO_VDD, 0, 0, 0, true, false);   /* 3v3 off */
+        touch_gpio(TOUCH_GPIO_AVDD, 0, 0, 0, true, false);  /* 1v8 off */
+        touch_wait(100); /* vendor power-off-delay is 5 ms; rails and decays */
+        touch_gpio(TOUCH_GPIO_VDD, 0, 0, 0, true, true);    /* 3v3 on */
+        touch_gpio(TOUCH_GPIO_AVDD, 0, 0, 0, true, true);   /* 1v8 on */
+        touch_wait(20); /* conservative rail settling; not a DT timing value */
+        touch_gpio(TOUCH_GPIO_SDA, 2, 0, 2, false, false); /* qup19, 2 mA */
+        touch_gpio(TOUCH_GPIO_SCL, 2, 0, 2, false, false);
+        /* Bus verdict while the IC still holds reset: idle SDA/SCL must read
+         * high through the board pull-ups (powered from the avdd rail) if the
+         * GPIO rail power is real. ios mirrors the same pads from the serial
+         * engine side. bit0 of each TLMM IN_OUT register is the pad input. */
+        printf("SWEET TOUCH: bus idle vdd=%#x avdd=%#x sda=%#x scl=%#x reset=%#x ios=%#x\n",
+            touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_VDD)),
+            touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_AVDD)),
+            touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_SDA)),
+            touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_SCL)),
+            touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_RESET)),
+            touch_rd(st.se, 0x908));
+        /* Vendor GT9889 dev_confirm: reset low 2 ms, then high. */
+        touch_wait(2);
+        touch_gpio(TOUCH_GPIO_RESET, 0, 3, 3, true, true);
+        touch_wait(300); /* exceeds vendor 5 ms test + 95 ms post-test wait */
+        printf("SWEET TOUCH: bus live sda=%#x scl=%#x irq=%#x ios=%#x\n",
+            touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_SDA)),
+            touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_SCL)),
+            touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_IRQ)),
+            touch_rd(st.se, 0x908));
+        /* GT9886 "normandy" bring-up per the vendor driver: identify, pick
+         * the matching panel config, keep the IC awake, download the config,
+         * then poll 0x4100. The 0x49 ST FTS probe is GONE: raphael enables
+         * only the Goodix, and the 0x49 NACK left bytes in the TX FIFO that
+         * poisoned every following transfer (t11: probe ok, then every poll
+         * err=5 with DONE and zero RX). */
+        uint8_t pid[4] = {0}, sensor = 0, ver[GT9886_VER_LEN] = {0};
+        /* t23/0102 cold-boot retry ladder. t22 evidence: the IC stayed alive
+         * at 0x5d (every xfer err=0, ACK + clock stretch) but PID read
+         * [22 50 96 ba] and the 72-byte version block summed to 0x8a instead
+         * of the vendor-guaranteed 0x00. Both live in the IC's RAM image, so
+         * the flash firmware was not running when we probed: the post-reset
+         * 300 ms window is not always enough (probabilistic - t12..t21 all
+         * brought the panel up, t22 lost the race). On a mismatch redo the
+         * cold power cycle with longer settle windows; the third attempt also
+         * straps INT high across the reset rising edge (classic Goodix boot
+         * strap) before returning the pad to input. Still no fw-update path:
+         * if every attempt reads garbage, stop with the full evidence. */
+        int pe = -1, se = -1, ve = -1;
+        bool id_ok = false;
+        for (unsigned att = 0u; att < 3u && !st.dead; ++att) {
+                if (att) {
+                        unsigned off_ms = (att == 1u) ? 200u : 300u;
+                        unsigned set_ms = (att == 1u) ? 50u : 100u;
+                        unsigned low_ms = 10u;
+                        unsigned boot_ms = 500u;
+                        printf("SWEET TOUCH: retry %u cold cycle off=%u settle=%u "
+                            "low=%u boot=%u ms\n",
+                            att, off_ms, set_ms, low_ms, boot_ms);
+                        touch_gpio(TOUCH_GPIO_RESET, 0, 3, 3, true, false);
+                        touch_gpio(TOUCH_GPIO_VDD, 0, 0, 0, true, false);
+                        touch_gpio(TOUCH_GPIO_AVDD, 0, 0, 0, true, false);
+                        touch_wait(off_ms);
+                        touch_gpio(TOUCH_GPIO_VDD, 0, 0, 0, true, true);
+                        touch_gpio(TOUCH_GPIO_AVDD, 0, 0, 0, true, true);
+                        touch_wait(set_ms);
+                        touch_gpio(TOUCH_GPIO_SDA, 2, 0, 2, false, false);
+                        touch_gpio(TOUCH_GPIO_SCL, 2, 0, 2, false, false);
+                        if (att == 2u) {
+                                /* INT high while reset rises: the IC samples
+                                 * the strap at the reset edge; we let go 1 ms
+                                 * later, before its firmware can drive. */
+                                touch_gpio(TOUCH_GPIO_IRQ, 0, 3, 3, true, true);
+                        }
+                        touch_wait(low_ms);
+                        touch_gpio(TOUCH_GPIO_RESET, 0, 3, 3, true, true);
+                        if (att == 2u) {
+                                touch_wait(1);
+                                touch_gpio(TOUCH_GPIO_IRQ, 0, 3, 3, false, false);
+                        }
+                        touch_wait(boot_ms);
+                }
+                pid[0] = pid[1] = pid[2] = pid[3] = 0;
+                sensor = 0;
+                for (unsigned i = 0; i < GT9886_VER_LEN; ++i) {
+                        ver[i] = 0;
+                }
+                st.probing = true;
+                pe = touch_read(0x5d, GT9886_PID_REG, true, pid, 4);
+                se = touch_read(0x5d, GT9886_SENSOR_REG, true, &sensor, 1);
+                ve = touch_read(0x5d, GT9886_VER_BASE, true, ver, GT9886_VER_LEN);
+                st.probing = false;
+                unsigned vsum = 0;
+                for (unsigned i = 0; i < GT9886_VER_LEN; ++i) {
+                        vsum += ver[i];
+                }
+                printf("SWEET TOUCH: GT9886 try%u pid err=%d [%02x %02x %02x %02x] "
+                    "sensor err=%d id=%#x ver err=%d sum=%#x\n",
+                    att, pe, pid[0], pid[1], pid[2], pid[3], se,
+                    sensor & 0x0fu, ve, vsum & 0xffu);
+                id_ok = !pe && pid[0] == '9' && pid[1] == '8' &&
+                    pid[2] == '8' && pid[3] == '6';
+                if (id_ok) {
+                        break;
+                }
+        }
+        if (st.dead) {
+                printf("SWEET TOUCH: sequencer dead; stopping\n");
+                goto out;
+        }
+        if (!id_ok) {
+                /* The vendor rejects the cfg package and walks a firmware
+                 * update when the pid mismatches. We have no update path:
+                 * stop with the evidence in the log. */
+                printf("SWEET TOUCH: pid is not 9886 after 3 cold boots "
+                    "(fw update path not built); stopping\n");
+                goto out;
+        }
+        /* Panel supplier id selects the config package; the DT flips both
+         * axes for sensor 0 only (raphael-sm8150.dtsi sensor0: x2x, y2y). */
+        unsigned sid = se ? 0u : (sensor & 0x0fu);
+        const uint8_t *cfg = gt9886_cfg_f11_sensor0;
+        unsigned cfg_len = sizeof(gt9886_cfg_f11_sensor0);
+        st.flip = true;
+        if (sid == 1u) {
+                cfg = gt9886_cfg_f11_sensor1;
+                cfg_len = sizeof(gt9886_cfg_f11_sensor1);
+                st.flip = false;
+        }
+        int dz = gt9886_doze_disable();
+        printf("SWEET TOUCH: doze disable err=%d (staying awake for polling)\n", dz);
+        int ce = gt9886_send_config(cfg, cfg_len);
+        printf("SWEET TOUCH: cfg send sensor%u %uB err=%d flip=%d\n",
+            sid, cfg_len, ce, st.flip);
+        if (ce) {
+                printf("SWEET TOUCH: config download failed; polling anyway\n");
+        }
+        st.kind = TOUCH_GOODIX9886;
+        printf("SWEET TOUCH: selected GT9886 normandy, 1080x%u, poll=10ms irq-hint=%d\n",
+            TOUCH_MAX_Y + 1u, st.irq_hint);
+#else
+        printf("SWEET TOUCH: TLMM reset=%#x irq=%#x vdd90=%#x; voting L11C through RPMh\n",
+            touch_rd(st.gpio, TOUCH_GPIO_IO(8)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
+            touch_rd(st.gpio, TOUCH_GPIO_IO(90)));
+        /* Keep the IC in reset while its rails settle; IRQ stays an input. */
+        touch_gpio(9, 0, 3, 3, false, false); /* IRQ input, 8 mA, pull-up */
+        touch_gpio(8, 0, 3, 3, true, false);
+        int power_error = sweet_rpmh_vreg_enable("ldoc11", 3200);
+        if (power_error) {
+                printf("SWEET TOUCH: L11C RPMh enable failed %d; probes skipped\n", power_error);
+                goto out;
+        }
+        touch_gpio(90, 0, 0, 0, true, true); /* board digital power enable */
+        touch_wait(10); /* conservative rail settling; not a DT timing value */
+        touch_gpio(6, 1, 0, 0, false, false); /* qup11 SDA/SCL, 2 mA */
+        touch_gpio(7, 1, 0, 0, false, false);
+        /* Vendor GT9896 dev_confirm: reset low 2 ms, then high. */
+        touch_gpio(8, 0, 3, 3, true, false);
+        touch_wait(2);
+        touch_gpio(8, 0, 3, 3, true, true);
+        touch_wait(300); /* exceeds vendor 5 ms test + 95 ms post-test wait */
+        uint8_t gid[32], legacy[32], fid1 = 0, fid2 = 0;
+        st.probing = true;
+        int ge = touch_probe_info(GOODIX_PID_REG, gid);
+        printf("SWEET TOUCH: probe 0x5d err=%d pid=%02x%02x%02x%02x fw=%02x.%02x.%02x.%02x irq=%#x\n",
+            ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
+        (void)touch_probe_info(0x8240, legacy);
+        int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
+        int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+        printf("SWEET TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
+            fe1, fe2, fid1, fid2, st.irq_status);
+        st.probing = false;
+        bool goodix = !ge && gid[0] == '9' && gid[1] == '8' && gid[2] == '9' && gid[3] == '6';
+        bool fts = !fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52;
+        if (st.dead || goodix == fts) {
+                printf("SWEET TOUCH: no unique supported IC (goodix=%d fts=%d dead=%d); stopping\n",
+                    goodix, fts, st.dead);
+                goto out;
+        }
+        st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
+        printf("SWEET TOUCH: selected %s, 1080x2400, poll=10ms irq-hint=%d\n",
+            goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
+#endif
+        unsigned errors = 0, ticks = 0;
+        while (!st.dead) {
+                /* Optional IRQ hint still reads every 100ms, and always while down. */
+                if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_GPIO_IRQ)) & 1u) ||
+                    (++ticks % 10u) == 0) {
+                        int err = st.kind == TOUCH_GOODIX ? touch_goodix() :
+                            st.kind == TOUCH_GOODIX9886 ? touch_goodix_9886() :
+                            st.kind == TOUCH_STFTS ? touch_stfts() :
+                            touch_focaltech();
+                        if (err) {
+                                if ((errors++ % 100u) == 0) {
+                                        printf("SWEET TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+                                }
+                                if (errors == 10) {
+                                        touch_report(0, st.x, st.y); /* release after persistent bad reads */
+                                }
+                        } else {
+                                errors = 0;
+                        }
+                }
+                touch_wait(10);
+        }
+        touch_report(0, st.x, st.y);
+out:
+        (void)thread_terminate(current_thread());
+        thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_init(void)
+{
+        int enabled = 1;
+        thread_t thread;
+        if (st.started) {
+                return;
+        }
+        st.started = true;
+        (void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+        (void)PE_parse_boot_argn("sweettouchirq", &st.irq_hint, sizeof(st.irq_hint));
+        if (!enabled) {
+                printf("SWEET TOUCH: disabled (sweettouch=0)\n");
+                return;
+        }
+        kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+        if (kr == KERN_SUCCESS) {
+                thread_deallocate(thread);
+        } else {
+                printf("SWEET TOUCH: kernel_thread_start failed %d\n", kr);
+        }
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
