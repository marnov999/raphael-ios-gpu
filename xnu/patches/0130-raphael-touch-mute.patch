+/*
+ * kern.sweet_touch_mute (boot-arg sweettouchmute): 1 drops the touchscreen's own reports (fingers down
+ * are let go once), for measurements without this panel's ghost touches; touches injected from userland
+ * (tools/touch.sh) still come through.
+ */
+static int sweet_touch_mute = -1;
+SYSCTL_INT(_kern, OID_AUTO, sweet_touch_mute, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_touch_mute, 0,
+    "1: the touchscreen's own touches dropped");
+
 static void
 touch_report(uint32_t mask, const int *x, const int *y)
 {
+        if (sweet_touch_mute < 0) {
+                sweet_touch_mute = 0;
+                (void)PE_parse_boot_argn("sweettouchmute", &sweet_touch_mute, sizeof(sweet_touch_mute));
+        }
+        if (sweet_touch_mute > 0) {
+                mask = 0;
+        }
         /* No flip by default: the R14 video was shot while the phone was
          * physically held upside down (user-confirmed 2026-10-21) -- the
          * panel and iOS agree and touch needs no rotation. The hook stays:
