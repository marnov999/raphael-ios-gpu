--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -685,6 +685,8 @@ sweet_ufs_init(void)
 static char sweet_log_ring[SWEET_LOG_SIZE];
 static uint64_t _Atomic sweet_log_total;
 static int sweet_log_chan;
+static uint64_t _Atomic sweet_log_flushed;
+static bool sweet_log_running;
 static uint32_t sweet_log_secs = SWEET_LOG_SECS;
 
 /* Called for all console output, any context: never blocks. */
@@ -785,6 +787,23 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 			return;
 		}
 		flushed = total;
+		os_atomic_store(&sweet_log_flushed, total, relaxed);
+	}
+}
+
+/*
+ * Put everything logged so far on the flash now (up to 3 s), for code that may reset the phone next:
+ * bsd/dev/sweet_gpu.c calls it before each bring-up step.
+ */
+void sweet_log_sync(void);
+
+void
+sweet_log_sync(void)
+{
+	uint64_t want = os_atomic_load(&sweet_log_total, relaxed);
+	for (int i = 0; sweet_log_running && i < 300 && os_atomic_load(&sweet_log_flushed, relaxed) < want; i++) {
+		wakeup(&sweet_log_chan);
+		delay_for_interval(10, NSEC_PER_MSEC);
 	}
 }
 
@@ -804,6 +823,7 @@ sweet_log_start(void)
 	}
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
+		sweet_log_running = true;
 	}
 }
 
