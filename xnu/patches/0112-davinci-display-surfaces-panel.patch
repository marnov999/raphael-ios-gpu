+		 * stays named as the Metal renderer, chosen with the com.apple.opengles UseMetal default. */
+		accelerator->setProperty("IOGLESBundleName", "SweetGLES");
+		accelerator->setProperty("IOGLESMetalBundleName", "AppleMetalGLRenderer");
