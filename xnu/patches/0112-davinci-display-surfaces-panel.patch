+static int64_t
+sweet_surface_push_written(SweetSurface *s)
+{
+	struct sweet_surface_page *list = sweet_surface_pages(s);
+	int64_t pushed = 0;
+	uint32_t pages = 0;
+	if (list == NULL) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < s->pageCount && list[i].len != 0; i++) {
+		if (list[i].pn == 0) {
+			static uint32_t told;
