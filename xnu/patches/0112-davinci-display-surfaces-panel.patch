+			while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0 && mach_absolute_time() < until) {
+				IODelay(100);
+			}
+		}
+		present(rec);
+		IOLockLock(fLock);
+		memcpy((void *)&fShownSwap, rec + 0x50, sizeof(uint32_t));   /* (the swap's id, +0x50) */
+		IOLockWakeup(fLock, (event_t)&fShownSwap, false);
+		IOLockUnlock(fLock);
+		fRateShown++;
+		fRateFlips += fFlips - flips;
+		if (fLastShown != 0) {
+			absolutetime_to_nanoseconds(now - fLastShown, &ns);
+			fRateLate += ns > 20000000ull;
+		}
+		fLastShown = now;
+	}
+	IOLockUnlock(fPresentLock);
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
+
+void
+AppleCLCD::presentCallout(thread_call_param_t self, __unused thread_call_param_t unused)
+{
+	((AppleCLCD *)self)->presentPending();
+}
+
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
 	IOLockLock(fLock);
+	/*
+	 * Two swaps within one tick (CoreAnimation's frames do not come exactly 16.7 ms apart): the
+	 * first is kept and shown at the next tick, the second at the one after -- not the first
+	 * dropped and the next tick left with nothing new, a frame missed in a steady motion (the
+	 * "micro lags"). A third before either is shown drops the oldest.
+	 */
+	if (fDirty && fFlushTicks == 1) {
+		memcpy(fEarly, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fHasEarly = true;
+	}
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
 	fDirty = true;
+	fRateSwaps++;
+	sweet_dvfs_kick();
+	if (sweet_tl_on) {
+		uint32_t i = sweet_tl_n;
+		if (i < SWEET_TL_SWAPS) {
+			bzero(&sweet_tl[i], sizeof(sweet_tl[i]));
+			memcpy(&sweet_tl[i].id, rec + 0x50, sizeof(uint32_t));
+			sweet_tl[i].arrive = sweet_tl_us();
+			sweet_tl_n = i + 1;
+		}
+	}
 	IOLockUnlock(fLock);
+	if (fImmediate && fScanout > 0) {
+		/*
+		 * Not on the caller's thread: a present waits for the GPU to be done with the frame (1.5-3
+		 * ms, sweet_gpu_surface_wait), and the caller is CoreAnimation's render thread, which could
+		 * be drawing the next frame meanwhile -- the heaviest frames missed their tick by that much.
+		 */
+		if (fPresentCall != NULL) {
+			thread_call_enter(fPresentCall);
+		} else {
+			presentPending();
+		}
+	}
 	if ((++sweet_fb_swap_count % 1000) == 0) {
 		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
 	}
 }
 
+/*
+ * Scanning out (boot-arg sweetfb_scanout=1), as Android's composer has the display engine do: no
+ * copy, the engine fetches iOS's surface itself. The boot loader leaves pipe VIG0 fetching its
+ * framebuffer (SRC0_ADDR 0x9c000000, 1080x2340, stride 4320; dt qcom,sde-sspp-off: vig0 0x5000)
+ * through CTL0 to INTF1, whose tear check refreshes the command-mode panel by itself every frame
+ * (INTF_TEAR autorefresh, sweet_dpu.c's survey). A swap writes the surface's address and stride
+ * into VIG0 and VIG0's flush bit into CTL0 (sde_hw_ctl: SSPP_VIG0 = bit 0): the engine takes the
+ * double-buffered registers at the next frame's start, so there is no tearing. The surface has to
+ * be one physical piece below 4 GB (SweetSurface allocates CoreAnimation's full-screen ones so);
+ * anything else is copied as before, with VIG0 back on the boot framebuffer. Scaled (fScale), VIG0
+ * fetches the whole 1125x2436 surface and its scaler shrinks it to the panel (scalerOn): the boot
+ * loader's 1:1 setup of the pipe is changed at the first flip, and put back by scanBack.
+ */
+
+/* VIG0's last flush taken by the display engine (or MS gone by): what is written now is all taken together at the next */
+static bool
+sweet_fb_flush_taken(volatile uint32_t *r, uint32_t ms)
+{
+	uint64_t until = 0;
+	clock_interval_to_deadline(ms, kMillisecondScale, &until);
+	while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0) {
+		if (mach_absolute_time() >= until) {
+			return false;
+		}
+		IODelay(100);
+	}
+	return true;
+}
+
+/*
+ * VIG0 fetching SW x SH and its scaler giving DW x DH to LM0, as the vendor driver sets a pipe up when
+ * nobody gave it scaler data (sde_plane.c _sde_plane_setup_scaler3 -> sde_hw_sspp.c setup_rects,
+ * setup_pe, sde_hw_util.c sde_hw_setup_scaler3): bilinear, so no coefficient tables to load; a phase
+ * step of SW / DW source pixels (21 fraction bits: 1125 -> 1080 is 0x215555, 2436 -> 2340 0x215015);
+ * initial phase 0; the preload of QSEED3 (4 across, 3 down); no pixel extension (the pipe's
+ * PE_OVERRIDE is set, so REQ_PIXELS is what it fetches: the whole source). The scaler's op mode last.
+ */
+static unsigned
+sweet_fb_scaler_config(struct sweet_fb_reg *c, uint32_t sw, uint32_t sh, uint32_t dw, uint32_t dh, bool alpha)
+{
+	uint32_t src = (sh << 16) | sw, dst = (dh << 16) | dw;
+	uint32_t step_x = (uint32_t)(((uint64_t)sw << SWEET_QSEED_PHASE_SHIFT) / dw);
+	uint32_t step_y = (uint32_t)(((uint64_t)sh << SWEET_QSEED_PHASE_SHIFT) / dh);
+	uint32_t preload = SWEET_QSEED_PRELOAD_H | (SWEET_QSEED_PRELOAD_V << 8) | (SWEET_QSEED_PRELOAD_H << 16) |
+	    (SWEET_QSEED_PRELOAD_V << 24);
+	uint32_t op = SWEET_QSEED_OP_ENABLE | SWEET_QSEED_OP_Y_BILINEAR | SWEET_QSEED_OP_BLEND | SWEET_QSEED_OP_8BIT;
+	const uint32_t q = SWEET_MDP_VIG0_QSEED;
+	unsigned n = 0;
+
+	if (alpha) {
+		op |= SWEET_QSEED_OP_ALPHA | SWEET_QSEED_OP_A_BILINEAR;
+	}
+	c[n++] = { SWEET_MDP_VIG0_SRC_SIZE, src };
+	c[n++] = { SWEET_MDP_VIG0_SRC_XY, 0 };
+	c[n++] = { SWEET_MDP_VIG0_OUT_SIZE, dst };
+	c[n++] = { SWEET_MDP_VIG0_OUT_XY, 0 };
+	c[n++] = { SWEET_MDP_VIG0_DECIMATION, 0 };
+	for (uint32_t i = 0; i < 3; i++) {     /* colour 0, colours 1 and 2, colour 3: LR, TB, REQ_PIXELS */
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x0u, 0 };
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x4u, 0 };
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x8u, src };
+	}
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x0u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x4u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x8u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0xcu, 0 };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x0u, step_x };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x4u, step_y };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x8u, step_x };      /* (RGB: no subsampled chroma) */
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0xcu, step_y };
+	c[n++] = { q + SWEET_QSEED_PRELOAD, preload };
+	c[n++] = { q + SWEET_QSEED_SRC_SIZE_Y + 0x0u, src };
+	c[n++] = { q + SWEET_QSEED_SRC_SIZE_Y + 0x4u, src };
+	c[n++] = { q + SWEET_QSEED_DST_SIZE, dst };
+	c[n++] = { q + SWEET_QSEED_OP_MODE, op };
+	return n;
+}
+#define SWEET_FB_SCALER_SRC     0       /* (indexes into that: logged) */
+#define SWEET_FB_SCALER_OUT     2
+#define SWEET_FB_SCALER_REQ     7
+#define SWEET_FB_SCALER_STEP    18
+#define SWEET_FB_SCALER_DST     25
+
+/*
+ * The scaler on (VIG0 fetching the presented size): the first time, its version read (a scaler that
+ * is not there, or the first QSEED3 with its other phase registers, is not used: the frames are then
+ * copied, scaled by the CPU) and what the boot loader had in these registers kept. Written while no
+ * flush is pending, so that the next flush (scanOut's, with the address) has the engine take all of
+ * them at one frame's start.
+ */
+bool
+AppleCLCD::scalerOn(void)
+{
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	struct sweet_fb_reg c[SWEET_FB_SCALER_REGS];
+	bool alpha = (r[SWEET_MDP_VIG0_FORMAT / 4] & SWEET_MDP_VIG0_FORMAT_ALPHA) != 0;
+	unsigned n = sweet_fb_scaler_config(c, fLogicalW, fLogicalH, fWidth, fHeight, alpha);
+
+	if (fScalerState < 0) {
+		return false;
+	}
+	if (fScalerState == 0) {
+		uint32_t version = r[(SWEET_MDP_VIG0_QSEED + SWEET_QSEED_VERSION) / 4];
+		if (version == 0 || version == 0xffffffffu || version == 0x1002u) {
+			IOLog("SWEET FB: VIG0's scaler reads version %#x: not used (frames copied, scaled by the CPU)\n", version);
+			fScalerState = -1;
+			return false;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			fScalerSave[i].off = c[i].off;
+			fScalerSave[i].val = r[c[i].off / 4];
+		}
+		fScalerRegs = n;
+		fScalerState = 1;
+		IOLog("SWEET FB: VIG0's scaler version %#x; the boot loader's src %#x out %#x req %#x, scaler op %#x step %#x/%#x "
+		    "dst %#x\n", version, fScalerSave[SWEET_FB_SCALER_SRC].val, fScalerSave[SWEET_FB_SCALER_OUT].val,
+		    fScalerSave[SWEET_FB_SCALER_REQ].val, fScalerSave[n - 1].val, fScalerSave[SWEET_FB_SCALER_STEP].val,
+		    fScalerSave[SWEET_FB_SCALER_STEP + 1].val, fScalerSave[SWEET_FB_SCALER_DST].val);
+	}
+	if (!sweet_fb_flush_taken(r, 40)) {
+		IOLog("SWEET FB: scaler on: VIG0's last flush still not taken after 40 ms\n");
+	}
+	for (unsigned i = 0; i < n; i++) {
+		r[c[i].off / 4] = c[i].val;
+	}
+	fScaled = true;
+	IOLog("SWEET FB: VIG0 scaled: %ux%u -> %ux%u, step %#x/%#x, scaler op %#x\n", fLogicalW, fLogicalH, fWidth,
+	    fHeight, c[SWEET_FB_SCALER_STEP].val, c[SWEET_FB_SCALER_STEP + 1].val, c[n - 1].val);
+	return true;
+}
+
+/* The boot loader's 1:1 setup back (the next flush takes it), for its framebuffer. */
+void
+AppleCLCD::scalerOff(void)
+{
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	if (!fScaled) {
+		return;
+	}
+	(void)sweet_fb_flush_taken(r, 40);
+	for (unsigned i = 0; i < fScalerRegs; i++) {
+		r[fScalerSave[i].off / 4] = fScalerSave[i].val;
+	}
+	fScaled = false;
+}
+
+bool
+AppleCLCD::scanOut(SweetSurface *s, uint64_t pa, uint32_t stride, bool scaled)
+{
+	if (fMdp == 0 && (fMdp = ml_io_map_unmappable(SWEET_MDP_PA, 0x6000u, 0x7u /* VM_WIMG_IO */)) == 0) {
+		return false;
+	}
+	if (scaled && !fScaled && !scalerOn()) {
+		return false;
+	} else if (!scaled && fScaled) {
+		scalerOff();
+	}
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	r[SWEET_MDP_VIG0_ADDR / 4] = (uint32_t)pa;
+	r[SWEET_MDP_VIG0_STRIDE / 4] = (r[SWEET_MDP_VIG0_STRIDE / 4] & 0xffff0000u) | (stride & 0xffffu);
+	__asm__ volatile("dsb sy" ::: "memory");
+	r[SWEET_MDP_CTL0_FLUSH / 4] = SWEET_MDP_FLUSH_VIG0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_panel_new_frame();
+	sweet_fb_scanout_id = s->id;
+	if (s != fShown[0]) {
+		OSSafeReleaseNULL(fShown[1]);        /* two flips old: no longer fetched */
+		fShown[1] = fShown[0];
+		s->retain();
+		fShown[0] = s;
+	}
+	if (!fScanning || fFlips < 4) {
+		IOLog("SWEET FB: scanning out surface %u at %#llx, stride %u%s (flip %u)\n", s->id, pa, stride,
+		    fScaled ? ", scaled" : "", fFlips);
+	}
+	fScanning = true;
+	fFlips++;
+	return true;
+}
+
+/*
+ * SwapWait: until the swap is on the panel. CoreAnimation asks this before it draws into the
+ * buffer that swap replaced; answered at once, as before, it drew into the buffer the display
+ * engine was still fetching -- tearing, and frames run ahead of the panel then bunched. On the
+ * panel means: shown at a tick (or a later swap was), and when it was scanned out, the display
+ * engine has taken the new address -- CTL0's flush bits read back set until the engine latches
+ * them at the start of the panel's next frame.
+ */
+bool
+AppleCLCD::swapShown(uint32_t id, uint64_t timeoutMS)
+{
+	static uint32_t told;
+	uint64_t began = mach_absolute_time(), deadline, ns = 0;
+	bool shown = true;
+	uint64_t win = sweet_tl_on ? sweet_tl_us() : 0;
+	clock_interval_to_deadline((uint32_t)timeoutMS, kMillisecondScale, &deadline);
+	IOLockLock(fLock);
+	while ((int32_t)(fShownSwap - id) < 0 && id <= fSwapID) {
+		if (IOLockSleepDeadline(fLock, (event_t)&fShownSwap, *(AbsoluteTime *)&deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+			shown = false;
+			break;
+		}
+	}
+	IOLockUnlock(fLock);
+	if (shown && fScanning && fMdp != 0) {
+		volatile uint32_t *r = (volatile uint32_t *)fMdp;
+		bool pending = false;
+		while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0 && mach_absolute_time() < deadline) {
+			pending = true;
+			IODelay(100);
+		}
+		if (pending) {
+			fLatchAt = mach_absolute_time();   /* (seen to change: within 0.1 ms of the frame's start) */
+		}
+	}
+	if (sweet_tl_on) {
+		struct sweet_tl_swap *t = sweet_tl_find(id);
+		if (t != NULL && t->win == 0) {
+			t->win = win;
+			t->wout = sweet_tl_us();
+			t->latch = t->wout;         /* (on the panel by then: latched, or the flush already taken) */
+		}
+	}
+	if (told < 12) {
+		told++;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		IOLog("SWEET FB: swap wait for %u (shown %u, last begun %u): %s after %llu us\n", id, fShownSwap, fSwapID,
+		    shown ? "on the panel" : "timed out", ns / 1000ull);
+	}
+	return shown;
+}
+
+/*
+ * The display's modes, as CoreAnimation reads them (HackiOS MiniIOMobileFramebuffer publishModes):
+ * TimingElements and ColorElements, one timing of the presented size at 60 Hz (16.16), one colour
+ * mode, 8-bit RGB; GetBlock 0x40 answers with their identifiers as "the current mode". Without
+ * them CoreAnimation had no refresh rate from the display to plan its frames by.
+ */
+#define SWEET_FB_TIMING_ID 1
+#define SWEET_FB_COLOR_ID  1
+static void
+sweet_fb_set_number(OSDictionary *d, const char *key, uint64_t v)
+{
+	OSNumber *n = OSNumber::withNumber(v, 64);
+	if (n != NULL) {
+		d->setObject(key, n);
+		n->release();
+	}
+}
+
+void
+AppleCLCD::publishModes(void)
+{
+	OSDictionary *timing = OSDictionary::withCapacity(8), *horizontal = OSDictionary::withCapacity(4);
+	OSDictionary *vertical = OSDictionary::withCapacity(4), *color = OSDictionary::withCapacity(8);
+	OSArray *timings = OSArray::withCapacity(1), *colors = OSArray::withCapacity(1);
+	const uint64_t rate = 60ull << 16;
+	if (timing && horizontal && vertical && color && timings && colors) {
+		sweet_fb_set_number(color, "ID", SWEET_FB_COLOR_ID);
+		sweet_fb_set_number(color, "PixelEncoding", 0);
+		sweet_fb_set_number(color, "Depth", 8);
+		sweet_fb_set_number(color, "Colorimetry", 1);
+		sweet_fb_set_number(color, "EOTF", 1);
+		sweet_fb_set_number(color, "DynamicRange", 0);
+		sweet_fb_set_number(color, "Score", 1);
+		color->setObject("IsVirtual", kOSBooleanFalse);
+		colors->setObject(color);
+		sweet_fb_set_number(horizontal, "Active", fLogicalW);
+		sweet_fb_set_number(horizontal, "Total", fLogicalW);
+		sweet_fb_set_number(horizontal, "SyncRate", rate);
+		sweet_fb_set_number(horizontal, "PreciseSyncRate", rate);
+		sweet_fb_set_number(vertical, "Active", fLogicalH);
+		sweet_fb_set_number(vertical, "Total", fLogicalH);
+		sweet_fb_set_number(vertical, "SyncRate", rate);
+		sweet_fb_set_number(vertical, "PreciseSyncRate", rate);
+		sweet_fb_set_number(timing, "ID", SWEET_FB_TIMING_ID);
+		sweet_fb_set_number(timing, "Score", 1);
+		timing->setObject("IsVirtual", kOSBooleanFalse);
+		timing->setObject("IsOverscanned", kOSBooleanFalse);
+		timing->setObject("HorizontalAttributes", horizontal);
+		timing->setObject("VerticalAttributes", vertical);
+		timing->setObject("ColorModes", colors);
+		timings->setObject(timing);
+		setProperty("TimingElements", timings);
+		setProperty("ColorElements", colors);
+	}
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+}
+
+void
+AppleCLCD::scanBack(void)
+{
+	if (!fScanning) {
+		return;
+	}
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	scalerOff();        /* (scaled: the boot framebuffer is the panel's size) */
+	r[SWEET_MDP_VIG0_ADDR / 4] = (uint32_t)fPhys;
+	r[SWEET_MDP_VIG0_STRIDE / 4] = (r[SWEET_MDP_VIG0_STRIDE / 4] & 0xffff0000u) | (fRowBytes & 0xffffu);
+	__asm__ volatile("dsb sy" ::: "memory");
+	r[SWEET_MDP_CTL0_FLUSH / 4] = SWEET_MDP_FLUSH_VIG0;
+	fScanning = false;
+	IOLog("SWEET FB: back on the boot framebuffer\n");
+}
+
+/* Scaled: the first panel pixel (of PANEL) whose centre is on logical pixel L or after it (of LOGICAL). */
+static int32_t
+sweet_fb_panel_at(int32_t l, uint32_t logical, uint32_t panel)
+{
+	int64_t num = 2 * (int64_t)l * panel - logical;
+	int64_t p = num <= 0 ? 0 : (num + 2 * (int64_t)logical - 1) / (2 * (int64_t)logical);
+	return (int32_t)(p > (int64_t)panel ? panel : p);
+}
+
+/* Scaled: the logical pixel under panel pixel P's centre. */
+static uint32_t
+sweet_fb_logical_at(int32_t p, uint32_t logical, uint32_t panel)
+{
+	return (uint32_t)(((2 * (uint64_t)p + 1) * logical) / (2 * (uint64_t)panel));
+}
