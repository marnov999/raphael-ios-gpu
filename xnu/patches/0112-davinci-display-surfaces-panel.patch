+extern "C" int
+sweet_surface_gpu_pages(uint32_t id, uint64_t *pa, unsigned maxpages, unsigned *npages,
+    uint32_t *allocSize, uint32_t *width, uint32_t *height, uint32_t *bytesPerRow,
+    uint32_t *pixelFormat)
