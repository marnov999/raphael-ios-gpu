@@ -37,7 +39,6 @@
 #include "SweetSurface.h"
 
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
-extern "C" vm_offset_t ml_io_map(vm_offset_t phys, vm_size_t size);
 
 #if defined(SWEET)
 #include <IOKit/IOService.h>
@@ -47,92 +48,21 @@ extern "C" vm_offset_t ml_io_map(vm_offset_t phys, vm_size_t size);
 #include <IOKit/IOLocks.h>
 #include <IOKit/IOWorkLoop.h>
 #include <IOKit/IOTimerEventSource.h>
-#include <libkern/c++/OSCollectionIterator.h>
+#include <kern/thread_call.h>
 #include <IOKit/system.h>
 #include <pexpert/pexpert.h>
 #include <kern/clock.h>
+#include <kern/thread.h>
 #include <sys/proc.h>
-
-#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
-/* Raphael panel control through the DSI command DMA, exactly the vendor
