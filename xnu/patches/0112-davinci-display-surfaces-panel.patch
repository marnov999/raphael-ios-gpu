diff --git a/bsd/dev/sweet_dpu.c b/bsd/dev/sweet_dpu.c
new file mode 100644
index 0000000..9c5c803
--- /dev/null
+++ b/bsd/dev/sweet_dpu.c
@@ -0,0 +1,83 @@
+/*
+ * The display engine (MDSS MDP / "DPU", dt qcom,mdss_mdp@ae00000), step 1 of scanning iOS's frames
+ * out directly instead of copying them into the boot loader's framebuffer: what the boot loader
+ * left programmed, read and printed. Reads only.
+ *
+ * Block offsets from davinci's dt (qcom,sde-*-off); register layout from the vendor's SDE driver
+ * (drivers/gpu/drm/msm/sde: sde_hw_sspp.c, sde_hw_ctl.c, sde_hw_lm.c, sde_hw_pingpong.c,
+ * sde_hw_intf.c). Every block is printed as its non-zero words, so what is live stands out: the
+ * pipe that fetches the framebuffer (its address, stride, format, sizes), the mixer and control
+ * path it goes through, the pingpong's tear check and autorefresh (a command-mode panel), and the
+ * DSI interface. And VIG0's pixel extension and scaler (QSEED3 lite at +0xa00), which
+ * SweetFramebuffer.cpp's scalerOn sets up to fetch 1125x2436 and give the panel 1080x2340.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <mach/memory_object_types.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+#ifndef VM_WIMG_IO
+#define VM_WIMG_IO 0x7u
+#endif
+
+void sweet_dpu_survey(void);
+
+#define MDP_PA    0x0ae00000u
+#define MDP_SIZE  0x90000u
+
+static const struct {
+	const char *name;
+	uint32_t off, len;
+} dpu_blocks[] = {
+	{ "top", 0x1000u, 0x460u },
+	{ "ctl0", 0x2000u, 0x100u }, { "ctl1", 0x2200u, 0x100u }, { "ctl2", 0x2400u, 0x100u },
+	{ "ctl3", 0x2600u, 0x100u }, { "ctl4", 0x2800u, 0x100u }, { "ctl5", 0x2a00u, 0x100u },
+	{ "vig0", 0x5000u, 0x80u }, { "vig0 pe", 0x5100u, 0x30u }, { "vig0 qseed", 0x5a00u, 0xa0u },
+	{ "vig1", 0x7000u, 0x80u },
+	{ "dma0", 0x25000u, 0x80u }, { "dma1", 0x27000u, 0x80u }, { "dma2", 0x29000u, 0x80u },
+	{ "lm0", 0x45000u, 0x60u }, { "lm1", 0x46000u, 0x60u }, { "lm2", 0x47000u, 0x60u }, { "lm3", 0x48000u, 0x60u },
+	{ "intf1(dsi)", 0x6b800u, 0x2c0u }, { "intf2(dsi)", 0x6c000u, 0x2c0u },
+	{ "pp0", 0x71000u, 0x40u }, { "pp1", 0x71800u, 0x40u }, { "pp2", 0x72000u, 0x40u }, { "pp3", 0x72800u, 0x40u },
+};
+
+void
+sweet_dpu_survey(void)
+{
+	static bool done;
+	vm_offset_t mdp;
+	unsigned b;
+	if (done) {
+		return;
+	}
+	done = true;
+	mdp = ml_io_map_unmappable(MDP_PA, MDP_SIZE, VM_WIMG_IO);
+	if (!mdp) {
+		printf("SWEET DPU: cannot map the MDP\n");
+		return;
+	}
+	printf("SWEET DPU: [1] the display engine as the boot loader left it (non-zero words; reads only)\n");
+	for (b = 0; b < sizeof(dpu_blocks) / sizeof(dpu_blocks[0]); b++) {
+		char line[320];
+		int at = 0;
+		unsigned nz = 0;
+		for (uint32_t o = 0; o < dpu_blocks[b].len; o += 4u) {
+			uint32_t v = *(volatile uint32_t *)(mdp + dpu_blocks[b].off + o);
+			if (v == 0) {
+				continue;
+			}
+			nz++;
+			if (at > (int)sizeof(line) - 24) {
+				printf("SWEET DPU: %s:%s\n", dpu_blocks[b].name, line);
+				at = 0;
+			}
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %03x=%x", o, v);
+		}
+		if (nz) {
+			printf("SWEET DPU: %s:%s\n", dpu_blocks[b].name, line);
+		}
+	}
+	printf("SWEET DPU: [1] done\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_panel.c b/bsd/dev/sweet_panel.c
new file mode 100644
index 0000000..952ba84
--- /dev/null
+++ b/bsd/dev/sweet_panel.c
@@ -0,0 +1,226 @@
+/*
+ * SWEET panel hooks for raphael (Mi 9T Pro / Redmi K20 Pro, SM8150): the Samsung EA8076 AMOLED in command
+ * mode, which the boot loader leaves lit and refreshing itself from its framebuffer. What davinci's
+ * bsd/dev/sweet_gpu.c gives SweetFramebuffer.cpp and SweetBacklight.cpp for its panel, here:
+ *
+ *   sweet_panel_brightness(0..2047)  DCS 0x51, the 11-bit level big-endian (the vendor's _ss variant,
+ *                                    qcom,mdss-brightness-max-level 2047)
+ *   sweet_panel_power(0/1)           DCS 0x28 display off (and 0x10 sleep in with sweetpanel_sleep=1);
+ *                                    on: 0x11 / 0x29 and the brightness once the first new frame is drawn
+ *   sweet_panel_new_frame()          (davinci: the panel stays dark after a wake until then, or 1 s)
+ *
+ * The commands go through the DSI controller's test-pattern DMA FIFO as Gsjsjzhznsz's raphael port does
+ * (vendor dsi_ctrl_hw_cmn_kickoff_fifo_command): header dword [wc_lo wc_hi data_type flags], payload,
+ * flags bit 7 the last command, bit 6 a payload follows. The controller is the first of ctrl0/ctrl1 that
+ * completes a command.
+ */
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+#define DSI0_PA                 0x0ae94000u
+#define DSI1_PA                 0x0ae96000u
+#define DSI_LEN                 0x400u
+#define DSI_CMD_DMA_CTRL        0x03cu
+#define DSI_DMA_CMD_LENGTH      0x04cu
+#define DSI_SW_TRIGGER          0x090u
+#define DSI_INT_CTRL            0x110u          /* bit 0: command DMA done (write 1 to clear) */
+#define DSI_TPG_CTRL            0x15cu
+#define DSI_TPG_CMD_INIT_VAL    0x17cu
+#define DSI_TPG_FIFO_RESET      0x1ecu
+#define DCS_SHORT_WRITE         0x05u
+#define DCS_LONG_WRITE          0x39u
+#define LEVEL_MAX               2047u
+
+int sweet_panel_brightness(uint32_t level);
+int sweet_panel_power(int on);
+void sweet_panel_new_frame(void);
+void sweet_panel_wake_tick(void);
+
+static vm_offset_t g_dsi;
+static int g_dsi_state;                 /* 0 not tried, 1 working, -1 none answers */
+static uint32_t g_level = 0x218u;       /* asked for; shown unless off */
+static bool g_off;
+static volatile uint32_t g_wake_pending;
+static thread_call_t g_wake_call;
+
+static void
+dsi_w(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(g_dsi + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint32_t
+dsi_r(uint32_t off)
+{
+	return *(volatile uint32_t *)(g_dsi + off);
+}
+
+/* One packet of `count` dwords; true once the controller says the command DMA is done. */
+static bool
+dsi_send(const uint32_t *dw, uint32_t count)
+{
+	dsi_w(DSI_TPG_CTRL, 0);
+	dsi_w(DSI_TPG_FIFO_RESET, 1);
+	delay(1);
+	dsi_w(DSI_TPG_FIFO_RESET, 0);
+	dsi_w(DSI_TPG_CTRL, 1u << 1 | 1u << 2 | 3u << 16);
+	for (uint32_t i = 0; i < count; i++) {
+		dsi_w(DSI_TPG_CMD_INIT_VAL, dw[i]);
+	}
+	if (count & 1u) {
+		dsi_w(DSI_TPG_CMD_INIT_VAL, 0);
+	}
+	uint32_t dma = dsi_r(DSI_CMD_DMA_CTRL) & ~(1u << 31 | 1u << 30 | 1u << 29 | 1u << 24);
+	dsi_w(DSI_CMD_DMA_CTRL, dma | 1u << 28 | 1u << 26);        /* embedded mode, low-power commands */
+	dsi_w(DSI_DMA_CMD_LENGTH, count * 4u);
+	dsi_w(DSI_SW_TRIGGER, 1);
+	for (int i = 0; i < 5000; i++) {
+		if (dsi_r(DSI_INT_CTRL) & 1u) {
+			dsi_w(DSI_INT_CTRL, 1);
+			dsi_w(DSI_TPG_CTRL, 0);
+			return true;
+		}
+		delay(10);
+	}
+	dsi_w(DSI_TPG_CTRL, 0);
+	return false;
+}
+
+static bool
+dsi_ready(void)
+{
+	static const uint32_t pas[2] = { DSI0_PA, DSI1_PA };
+	const uint32_t on = 0x29u | DCS_SHORT_WRITE << 16 | 0x80u << 24;      /* display on: no-op on a lit panel */
+
+	if (g_dsi_state != 0) {
+		return g_dsi_state > 0;
+	}
+	g_dsi_state = -1;
+	for (int i = 0; i < 2; i++) {
+		if ((g_dsi = ml_io_map(pas[i], DSI_LEN)) != 0 && dsi_send(&on, 1)) {
+			g_dsi_state = 1;
+			printf("SWEET PANEL: DSI ctrl%d takes commands\n", i);
+			return true;
+		}
+	}
+	printf("SWEET PANEL: no DSI controller completes a command: no brightness or display off\n");
+	return false;
+}
+
+static int
+dcs_short(uint8_t cmd)
+{
+	uint32_t dw = cmd | DCS_SHORT_WRITE << 16 | 0x80u << 24;
+	return dsi_ready() && dsi_send(&dw, 1) ? 0 : -1;
+}
+
+static int
+dcs_brightness(uint32_t level)
+{
+	uint32_t dw[2] = { 3u | DCS_LONG_WRITE << 16 | 0xc0u << 24,
+		           0x51u | (level >> 8 & 0xffu) << 8 | (level & 0xffu) << 16 | 0xffu << 24 };
+	return dsi_ready() && dsi_send(dw, 2) ? 0 : -1;
+}
+
+int
+sweet_panel_brightness(uint32_t level)
+{
+	static uint32_t most;
+	static uint32_t last_lit = 0x218u;
+	if (most == 0) {
+		most = LEVEL_MAX;
+		(void)PE_parse_boot_argn("sweetbl_max", &most, sizeof(most));
+		if (most == 0 || most > LEVEL_MAX) {
+			most = LEVEL_MAX;
+		}
+	}
+	if (level > most) {
+		level = most;
+	}
+	/* backboardd: 0 is off, 1 is "back to where it was" (davinci, 2026-10-26) */
+	if (level == 1u && last_lit > 1u) {
+		level = last_lit;
+	} else if (level > 1u) {
+		last_lit = level;
+	}
+	g_level = level;
+	return g_off || g_wake_pending ? 0 : dcs_brightness(level);
+}
+
+static void
+panel_reveal(const char *why)
+{
+	if (!__atomic_exchange_n(&g_wake_pending, 0u, __ATOMIC_ACQ_REL)) {
+		return;
+	}
+	int a = dcs_short(0x29), b = dcs_brightness(g_level);
+	printf("SWEET PANEL: shown after the wake (%s; display on %d, brightness %d)\n", why, a, b);
+}
+
+static void
+panel_wake_timeout(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	panel_reveal("no frame in 1 s");
+}
+
+void
+sweet_panel_new_frame(void)
+{
+	if (g_wake_pending) {
+		panel_reveal("first frame");
+	}
+}
+
+void
+sweet_panel_wake_tick(void)
+{
+}
+
+int
+sweet_panel_power(int on)
+{
+	static int sleep_ok = -1;
+	int r;
+	if (sleep_ok < 0) {
+		sleep_ok = 0;
+		(void)PE_parse_boot_argn("sweetpanel_sleep", &sleep_ok, sizeof(sleep_ok));
+	}
+	if (!on) {
+		g_off = true;
+		g_wake_pending = 0;
+		r = dcs_short(0x28);
+		if (sleep_ok) {
+			r |= dcs_short(0x10);
+		}
+		return r;
+	}
+	if (!g_off) {
+		return 0;
+	}
+	g_off = false;
+	r = 0;
+	if (sleep_ok) {
+		r = dcs_short(0x11);
+		delay(120000);                  /* sleep out: 120 ms before the next command */
+	}
+	/* dark until the first new frame (no stale frame from before the sleep), or 1 s */
+	g_wake_pending = 1;
+	if (g_wake_call == NULL) {
+		g_wake_call = thread_call_allocate(panel_wake_timeout, NULL);
+	}
+	if (g_wake_call != NULL) {
+		uint64_t deadline;
+		clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(g_wake_call, deadline);
+	} else {
+		panel_reveal("no timer");
+	}
+	return r;
+}
+#endif /* ARM64_BOARD_CONFIG_RAPHAEL */
diff --git a/iokit/Kernel/arm/SweetBacklight.cpp b/iokit/Kernel/arm/SweetBacklight.cpp
new file mode 100644
index 0000000..7031302
--- /dev/null
+++ b/iokit/Kernel/arm/SweetBacklight.cpp
@@ -0,0 +1,152 @@
+/*
+ * SweetBacklight: the panel's brightness for iOS. backboardd's CoreBrightness looks for a service
+ * with the property backlight-control (IOPropertyMatch, IOServiceNotificationUser) and, failing to
+ * find one, has nothing to send the brightness slider's value to. This is that service: it carries
+ * backlight-control and an IODisplayParameters "brightness" range, takes what is set on it
+ * (setProperties), and sends the panel DCS 0x51 through bsd/dev/sweet_gpu.c's
+ * sweet_panel_brightness() (davinci's Samsung AMOLED: 0..2047).
+ *
+ * What iOS sets, and how, is logged (the first sixty times), so the mapping can follow what
+ * CoreBrightness really does; a number under "brightness" (or IODisplayParameters.brightness.value)
+ * is taken on the published scale.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSSerialize.h>
+
+extern "C" int sweet_panel_brightness(uint32_t level);
+
+#define SWEET_BL_SCALE  65536u          /* the published range: 0..65536 (IODisplayParameters, as on a Mac) */
+#define SWEET_BL_PANEL  2047u           /* the panel's own maximum */
+#define SWEET_BL_START  0x218u          /* dt qcom,mdss-dsi-bl-default-level */
+
+/* The class is called what CoreBrightness matches (CBDisplayContaineriOS: IOServiceMatching("AppleARMBacklight")). */
+#define SweetBacklight AppleARMBacklight
+class SweetBacklight : public IOService {
+	OSDeclareDefaultStructors(SweetBacklight);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+private:
+	unsigned fLogged;
+	uint32_t fValue;                     /* on the published scale */
+	void publish(uint32_t value);
+	void take(uint32_t value, const char *how);
+};
+
+OSDefineMetaClassAndStructors(SweetBacklight, IOService);
+
+void
+SweetBacklight::publish(uint32_t value)
+{
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *brightness = OSDictionary::withCapacity(3);
+	OSNumber *min = OSNumber::withNumber(0ull, 32), *max = OSNumber::withNumber(SWEET_BL_SCALE, 32),
+	    *cur = OSNumber::withNumber(value, 32);
+	if (params && brightness && min && max && cur) {
+		brightness->setObject("min", min);
+		brightness->setObject("max", max);
+		brightness->setObject("value", cur);
+		params->setObject("brightness", brightness);
+		setProperty("IODisplayParameters", params);
+		setProperty("brightness", cur);
+	}
+	OSSafeReleaseNULL(min);
+	OSSafeReleaseNULL(max);
+	OSSafeReleaseNULL(cur);
+	OSSafeReleaseNULL(brightness);
+	OSSafeReleaseNULL(params);
+}
+
+void
+SweetBacklight::take(uint32_t value, const char *how)
+{
+	uint32_t level;
+	if (value > SWEET_BL_SCALE) {
+		value = SWEET_BL_SCALE;
+	}
+	level = (uint32_t)(((uint64_t)value * SWEET_BL_PANEL + SWEET_BL_SCALE / 2) / SWEET_BL_SCALE);
+	if (level == 0 && value != 0) {
+		level = 1;                       /* the slider's bottom is dim, not black */
+	}
+	fValue = value;
+	publish(value);
+	IOLog("SWEET BACKLIGHT: %s %u/%u -> panel %u: %d\n", how, value, SWEET_BL_SCALE, level, sweet_panel_brightness(level));
+}
+
+bool
+SweetBacklight::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fValue = (uint32_t)(((uint64_t)SWEET_BL_START * SWEET_BL_SCALE) / SWEET_BL_PANEL);
+	setProperty("backlight-control", kOSBooleanTrue);
+	publish(fValue);
+	registerService();
+	IOLog("SWEET BACKLIGHT: published (backlight-control), brightness %u/%u\n", fValue, SWEET_BL_SCALE);
+	return true;
+}
+
+static bool
+sweet_bl_number(OSObject *o, uint32_t *out)
+{
+	OSNumber *n = OSDynamicCast(OSNumber, o);
+	if (n) {
+		*out = n->unsigned32BitValue();
+		return true;
+	}
+	return false;
+}
+
+IOReturn
+SweetBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	uint32_t value = 0;
+	if (fLogged < 60) {
+		OSSerialize *s = OSSerialize::withCapacity(512);
+		fLogged++;
+		if (s && properties->serialize(s)) {
+			IOLog("SWEET BACKLIGHT: set %.400s\n", s->text());
+		}
+		OSSafeReleaseNULL(s);
+	}
+	if (!dict) {
+		return kIOReturnBadArgument;
+	}
+	if (sweet_bl_number(dict->getObject("IOMFBBrightnessLevel"), &value)) {   /* CoreBrightness Display.m */
+		take(value, "IOMFBBrightnessLevel");
+		return kIOReturnSuccess;
+	}
+	if (sweet_bl_number(dict->getObject("brightness"), &value)) {
+		take(value, "brightness");
+		return kIOReturnSuccess;
+	}
+	{
+		OSDictionary *params = OSDynamicCast(OSDictionary, dict->getObject("IODisplayParameters"));
+		OSDictionary *b = params ? OSDynamicCast(OSDictionary, params->getObject("brightness")) : NULL;
+		if (b && sweet_bl_number(b->getObject("value"), &value)) {
+			take(value, "IODisplayParameters");
+			return kIOReturnSuccess;
+		}
+	}
+	return kIOReturnSuccess;                 /* accepted (and logged) */
+}
+
+IOReturn
+SweetBacklight::newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+    IOUserClient **handler)
+{
+	IOLog("SWEET BACKLIGHT: a user client of type %u asked for\n", (unsigned)type);
+	return IOService::newUserClient(owningTask, securityID, type, properties, handler);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
