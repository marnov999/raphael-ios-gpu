+void
+AppleCLCD::copyRows(const RowJob *job, int32_t y0, int32_t y1)
+{
+	for (int32_t y = y0; y < y1; y++) {
+		uintptr_t to = job->dst + (uint64_t)y * job->rowBytes;
+		uintptr_t from = job->src + (uint64_t)(job->rowMap != NULL ? job->rowMap[y] : (uint32_t)y) * job->stride;
+		if (job->runs == NULL) {
+			memcpy((void *)to, (const void *)from, job->bytes);
+			continue;
+		}
+		for (uint32_t i = 0; i < job->nruns; i++) {
+			const ScaleRun *run = &job->runs[i];
+			memcpy((void *)(to + (uint64_t)run->dst * 4), (const void *)(from + (uint64_t)run->src * 4), (size_t)run->n * 4);
+		}
+	}
+}
+
+/* A helper: waits for a frame, copies its share of the rows (share index + 1; the presenter takes 0). */
+void
+AppleCLCD::helperMain(void *self, __unused wait_result_t wr)
+{
+	AppleCLCD *fb = (AppleCLCD *)self;
+	uint64_t done = 0;
+	unsigned index;
+
+	IOLockLock(fb->fHelperLock);
+	index = fb->fHelpersStarted++;
+	IOLockUnlock(fb->fHelperLock);
+	for (;;) {
+		const RowJob *job;
+		IOLockLock(fb->fHelperLock);
+		while (fb->fHelperGeneration == done) {
+			IOLockSleep(fb->fHelperLock, &fb->fHelperGeneration, THREAD_UNINT);
+		}
+		done = fb->fHelperGeneration;
+		job = fb->fHelperJob;
+		IOLockUnlock(fb->fHelperLock);
+		copyRows(job, (int32_t)((int64_t)job->rows * (index + 1) / fb->fThreads),
+		    (int32_t)((int64_t)job->rows * (index + 2) / fb->fThreads));
+		IOLockLock(fb->fHelperLock);
+		if (--fb->fHelpersBusy == 0) {
+			IOLockWakeup(fb->fHelperLock, &fb->fHelpersBusy, true);
+		}
+		IOLockUnlock(fb->fHelperLock);
+	}
+}
+
+/* The rows shared out: the helpers take theirs, this thread the first share, then waits for them. */
+void
+AppleCLCD::copyFrame(const RowJob *job)
+{
+	if (fThreads <= 1 || fHelpersStarted + 1 < fThreads) {
+		copyRows(job, 0, job->rows);
+		return;
+	}
+	IOLockLock(fHelperLock);
+	fHelperJob = job;
+	fHelpersBusy = fThreads - 1;
+	fHelperGeneration++;
+	IOLockWakeup(fHelperLock, &fHelperGeneration, false);
+	IOLockUnlock(fHelperLock);
+	copyRows(job, 0, (int32_t)((int64_t)job->rows / fThreads));
+	IOLockLock(fHelperLock);
+	while (fHelpersBusy != 0) {
+		IOLockSleep(fHelperLock, &fHelpersBusy, THREAD_UNINT);
+	}
+	IOLockUnlock(fHelperLock);
+}
