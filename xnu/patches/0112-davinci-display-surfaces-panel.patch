+/*
+ * Only what a processor wrote, pushed out of the cache: XNU sets a page's "modified" bit at the
+ * first write after the bit was cleared (the clear makes every mapping of it read-only again),
+ * so the pages with it set are the ones whose lines may be in the cache. Each is cleared, then
+ * pushed out (a write between the two faults and sets the bit again). Pushing out the whole of
+ * every surface a submission named was 500 MB a second of cache maintenance in the window
+ * server; it draws almost everything with the GPU. Returns the bytes pushed out, or -1 when the
+ * memory is not pages the VM keeps bits for (the panel's): then the caller pushes out all of it.
+ */
+static struct sweet_surface_page *
+sweet_surface_pages(SweetSurface *s)
+{
+	struct sweet_surface_page *list = s->pages;
+	uint64_t length, off;
+	uint32_t count = 0, most;
+	if (list != NULL || s->memory == NULL) {
+		return list;
+	}
+	/* by physical page, not by PAGE_SIZE steps of the memory: what an application lends starts
+	 * where its allocation does, anywhere in a page, and then every step lies in two pages */
+	length = s->memory->getLength();
+	most = (uint32_t)(length / PAGE_SIZE) + 2u;
+	list = (struct sweet_surface_page *)IOMalloc(most * sizeof(list[0]));
+	if (list == NULL) {
+		return NULL;
+	}
+	for (off = 0; off < length && count < most; count++) {
+		IOByteCount seg = 0;
+		addr64_t pa = s->memory->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+		uint64_t in_page = PAGE_SIZE - (pa & PAGE_MASK);
+		uint64_t len = in_page < length - off ? in_page : length - off;
+		list[count].pn = (ppnum_t)(pa >> PAGE_SHIFT);
+		if (pa == 0 || !pmap_valid_page(list[count].pn)) {
+			list[count].pn = 0;
+		}
+		list[count].off = (uint32_t)off;
+		list[count].len = (uint32_t)len;
+		list[count].poff = (uint32_t)(pa & PAGE_MASK);
+		off += len;
+	}
+	IOLockLock(sweet_surface_lock);
+	if (s->pages == NULL) {
+		s->pageCount = most;            /* (the allocation's size, for IOFree) */
+		s->pages = list;
+		if (count < most) {
+			list[count].len = 0;    /* end */
+		}
+		list = NULL;
+	}
+	IOLockUnlock(sweet_surface_lock);
