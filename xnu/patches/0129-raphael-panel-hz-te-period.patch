+/*
+ * The panel's refresh rate (boot-arg sweetpanel_hz, 30..91; tools/panel-hz.sh does the same live). The
+ * EA8076 runs its frames off the DSI bit clock: 60.214 Hz at the boot loader's 1103 MHz, 63.19 at 1157.7,
+ * 66.01 at 1209, 72.01, 74.99, 81.00 at 1483.8 (measured 2026-11-03) -- so the rate is the DSI0 PLL's,
+ * 1103 MHz * hz / 60.214, and nothing in the panel changes. Done between two panel frames with
+ * autorefresh paused (the panel shows its own RAM meanwhile): the PLL's decimal and fractional dividers
+ * (VCO = (dec + frac / 2^18) * 2 * 19.2 MHz, the bit clock: no post dividers), then the PLL off and on
+ * with the PHY's global clock gated (vendor mdss-dsi-pll-7nm.c dsi_pll_disable / dsi_pll_enable; the
+ * PHY digital reset there hung a write here, left out). The rate in milli-Hz the panel runs at now.
+ */
+#define DSI0_PLL                0x94900u
+#define PLL_DECIMAL_DIV_START_1 0x0e0u
+#define PLL_FRAC_DIV_START_LOW_1 0x0e4u         /* (MID_1 0x0e8, HIGH_1 0x0ec: bits 17:16) */
+#define PLL_COMMON_STATUS_ONE   0x1b0u          /* bit 0: locked */
+#define DSI0_PHY                0x94400u
+#define PHY_CMN_CLK_CFG1        0x014u          /* bit 5: the global clock on */
+#define PHY_CMN_PLL_CNTRL       0x03cu
+#define INTF1_AUTOREFRESH       0x2b4u
+#define BOOT_BITCLK_HZ          1103000000ull
+#define BOOT_PANEL_MHZ          60214ull        /* milli-Hz at that clock */
+
+static uint32_t g_panel_mhz = (uint32_t)BOOT_PANEL_MHZ;
+
+uint32_t sweet_panel_rate(void);
+uint32_t
+sweet_panel_rate(void)
+{
+	return g_panel_mhz;
+}
+
+int sweet_panel_set_hz(uint32_t hz);
+int
+sweet_panel_set_hz(uint32_t hz)
+{
+	vm_offset_t m = mdss();
+	if (m == 0 || hz < 30 || hz > 91) {
+		return -1;
+	}
+	volatile uint32_t *pll = (volatile uint32_t *)(m + DSI0_PLL), *phy = (volatile uint32_t *)(m + DSI0_PHY);
+	volatile uint32_t *tear = (volatile uint32_t *)(m + INTF1_TEAR);
+	uint64_t bitclk = BOOT_BITCLK_HZ * hz * 1000ull / BOOT_PANEL_MHZ;
+	uint64_t x = (bitclk << 18) / 38400000ull;     /* (dec << 18) | frac */
+	uint32_t dec = (uint32_t)(x >> 18), frac = (uint32_t)(x & 0x3ffffu);
+	uint32_t autorefresh = tear[INTF1_AUTOREFRESH / 4], cfg1 = phy[PHY_CMN_CLK_CFG1 / 4];
+	int locked = 0;
+
+	tear[INTF1_AUTOREFRESH / 4] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(20000);                   /* a frame's transfer (13.7 ms at 60 Hz) done */
+	pll[PLL_DECIMAL_DIV_START_1 / 4] = dec;
+	pll[PLL_FRAC_DIV_START_LOW_1 / 4] = frac & 0xffu;
+	pll[PLL_FRAC_DIV_START_LOW_1 / 4 + 1] = frac >> 8 & 0xffu;
+	pll[PLL_FRAC_DIV_START_LOW_1 / 4 + 2] = frac >> 16 & 0x3u;
+	phy[PHY_CMN_CLK_CFG1 / 4] = cfg1 & ~(1u << 5);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	phy[PHY_CMN_PLL_CNTRL / 4] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	phy[PHY_CMN_PLL_CNTRL / 4] = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int i = 0; i < 50 && !locked; i++) {
+		delay(100);
+		locked = pll[PLL_COMMON_STATUS_ONE / 4] & 1u;
+	}
+	phy[PHY_CMN_CLK_CFG1 / 4] = cfg1 | 1u << 5 | 1u << 4;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	tear[INTF1_AUTOREFRESH / 4] = autorefresh != 0 ? autorefresh : 0x80000001u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	g_panel_mhz = hz * 1000u;
+	printf("SWEET PANEL: %u Hz: DSI bit clock %llu Hz (dec %#x frac %#x), PLL %s\n", hz, bitclk, dec, frac,
+	    locked ? "locked" : "NOT locked");
+	return locked ? 0 : -1;
+}
+
 /*
  * kern.sweet_mdss (root): in { op, off, val, n, bytes[56] }, out { val, ok, at, count }.
  * op 0 reads the word at MDSS + off, 1 writes val there (and reads it back), 2 sends bytes[0..n) to the
- * panel as one DCS long write, 3 samples the TE (sweet_panel_te).
+ * panel as one DCS long write, 3 samples the TE (sweet_panel_te), 4 sets the panel to val Hz
+ * (sweet_panel_set_hz; out val: the rate in milli-Hz).
  */
 struct sweet_mdss_req {
 	uint32_t op, off, val, n;
@@ -321,6 +396,10 @@ sysctl_sweet_mdss SYSCTL_HANDLER_ARGS
 	case 3:
 		out.ok = sweet_panel_te(&out.at, &out.count);
 		break;
+	case 4:
+		out.ok = sweet_panel_set_hz(in.val) == 0;
+		out.val = g_panel_mhz;
+		break;
 	default:
 		return EINVAL;
 	}
