diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 827448d..c270877 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1027,6 +1027,45 @@ ud_if_create(void)
 	    err ? "NOT configured" : "up", err);
 }
 
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+/*
+ * A bus reset or a disconnect (the cable out and in, the host resetting the port): the data endpoints
+ * and their transfers as on a fresh connection (Linux dwc3_gadget_reset_interrupt / dwc3_stop_active_transfers),
+ * so that the host's next SET_CONFIGURATION sets them up again. Before (as on davinci), ud.configured stayed
+ * set, ud_configure() did nothing, and the network was gone until the next boot (u12, 2026-11-03).
+ */
+#define DEPCMD_ENDTRANSFER      8
+#define DEPCMD_HIPRI_FORCERM    (1u << 11)
+static void
+ud_data_reset(const char *why)
+{
+	if (!ud.configured) {
+		return;
+	}
+	if (rg != 0) {
+		(void)ud_epcmd(EP_RX, DEPCMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | (rx_rsc << 16), 0, 0, 0);
+		if (tx_on) {
+			(void)ud_epcmd(EP_TX, DEPCMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | (tx_rsc << 16), 0, 0, 0);
+		}
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & ~((1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT)));
+	lck_mtx_lock(ud.lock);
+	while (ud.txq_count > 0) {
+		mbuf_freem(ud.txq[ud.txq_head]);
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+	}
+	ud.tx_busy = false;
+	tx_on = false;
+	tx_head = tx_tail = tx_used = 0;
+	rx_next = 0;
+	ud.configured = false;
+	lck_mtx_unlock(ud.lock);
+	ud_link_event(false);
+	printf("SWEET USB: %s: data endpoints reset, waiting for the host to configure again\n", why);
+}
+#endif
+
 static void
 ud_event(uint32_t ev)
 {
@@ -1035,6 +1074,9 @@ ud_event(uint32_t ev)
 		if (type == 1) {        /* USB reset */
 			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
 			printf("SWEET USB: bus reset\n");
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+			ud_data_reset("bus reset");
+#endif
 		} else if (type == 2) { /* connect done */
 			uint32_t speed = dwc_rd(DSTS) & 7;
 			/* ep0 max packet: 64 at high/full speed (modify action) */
@@ -1045,6 +1087,9 @@ ud_event(uint32_t ev)
 			printf("SWEET USB: connected, speed %u\n", speed);
 		} else if (type == 0) {
 			printf("SWEET USB: disconnect\n");
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+			ud_data_reset("disconnect");
+#endif
 		}
 		return;
 	}
