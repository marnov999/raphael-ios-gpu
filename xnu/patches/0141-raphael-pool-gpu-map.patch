+/* Its display buffer (1..SWEET_DISPLAY_POOL; 0: none): its pages are the same for as long as the system runs */
+extern "C" uint32_t
+sweet_surface_gpu_pool_slot(void *surface)
+{
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+	SweetSurface *s = (SweetSurface *)surface;
+	return s != NULL ? s->poolSlot : 0;
+#else
+	(void)surface;
+	return 0;
+#endif
+}
+
 extern "C" int64_t
 sweet_surface_gpu_push_written(void *surface)
 {
