 uint32_t sweet_display_hits, sweet_display_misses, sweet_display_busy_now;
+static SweetSurface *sweet_display_owner[SWEET_DISPLAY_POOL];     /* (not a reference: cleared by its free) */
+
+/* The busy display buffers now: of a surface somebody has (in the table, users), and of one nobody has any more (held by the kernel alone) */
+extern "C" void
+sweet_display_census(uint32_t *live, uint32_t *dead)
+{
+	*live = *dead = 0;
+	if (sweet_surface_lock == NULL) {
+		return;
+	}
+	IOLockLock(sweet_surface_lock);
+	for (unsigned i = 0; i < SWEET_DISPLAY_POOL; i++) {
+		SweetSurface *o = sweet_display_owner[i];
+		if (!sweet_display_busy[i] || o == NULL) {
+			continue;
+		}
+		if (o->id != 0 && o->id < SWEET_SURFACE_MAX_ID && sweet_surface_table[o->id] == o && sweet_surface_users[o->id] != 0) {
+			(*live)++;
+		} else {
+			(*dead)++;
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+}
 
