diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 67fbced..658c097 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1988,6 +1988,8 @@ static int                g_kgsl_ready;  /* submit path live */
 extern void IODelay(unsigned microseconds);       /* IOKit/IOLib.h */
 /* (how the syncs went, for the five-second line: done in the busy look, done later, never; their time) */
 uint64_t sweet_ws_submit_at;            /* (mach time; read by SweetFramebuffer.cpp) */
+extern volatile uint64_t sweet_fb_vsync_count, sweet_fb_frame_tick;    /* SweetFramebuffer.cpp */
+extern volatile uint32_t sweet_fb_frame_open;
 extern task_t current_task(void);
 static uint32_t g_tlb_quick, g_tlb_slow, g_tlb_never;
 /* (drm_ioctl's waits, for the five-second line) */
@@ -3727,6 +3729,11 @@ drm_do_gem_submit(struct drm_msm_gem_submit *s, uint32_t *out_fence)
 		extern task_t sweet_window_server_task;
 		if (sweet_window_server_task != TASK_NULL && current_task() == sweet_window_server_task) {
 			sweet_ws_submit_at = mach_absolute_time();
+			/* (the first of a frame: the tick it is drawn for -- SweetFramebuffer.cpp sweetfb_depth) */
+			if (!sweet_fb_frame_open) {
+				sweet_fb_frame_tick = sweet_fb_vsync_count;
+				sweet_fb_frame_open = 1;
+			}
 		}
 	}
 	fence = gpu_submit(ibva, ibdw, n);
diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 6c9f5d8..08dfb2f 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -540,6 +540,8 @@ uint32_t sweet_fb_scanout_id;
 /* (raphael) the vsync again US after a tick with no swap since (0: off), and only if the window server is not drawing: SweetFramebuffer.cpp */
 extern uint32_t sweet_fb_retick_us, sweet_fb_retick_idle;
 SYSCTL_UINT(_kern, OID_AUTO, sweet_fb_retick, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_fb_retick_us, 0, "vsync again us after a tick with no swap");
+extern uint32_t sweet_fb_drawtick;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_fb_drawtick, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_fb_drawtick, 0, "a frame flipped by the tick its drawing began");
 SYSCTL_UINT(_kern, OID_AUTO, sweet_fb_retick_idle, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_fb_retick_idle, 0, "retick only when not drawing");
