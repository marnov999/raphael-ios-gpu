diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 4112ef9..9032262 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -203,6 +203,18 @@ sweet_fb_timeline(int on)
 /* (raphael) sweetfb_retick / sweetfb_retick_idle, and kern.sweet_fb_retick* (bsd/kern/sweet_amfi.c) */
 extern "C" uint32_t sweet_fb_retick_us, sweet_fb_retick_idle;
 uint32_t sweet_fb_retick_us, sweet_fb_retick_idle;
+/*
+ * The tick a frame is drawn for (raphael, sweetfb_depth=2): the vsync count when the window server gave the
+ * GPU the frame's first work (bsd/dev/sweet_gpu.c), not when its swap came -- a frame begun at its tick
+ * that came a little after the next was flipped a tick later than its neighbours, and stayed up two
+ * refreshes (the "server" misses, half of those left, u31). Boot-arg sweetfb_drawtick=0: by the swap.
+ */
+extern "C" volatile uint64_t sweet_fb_vsync_count, sweet_fb_frame_tick;
+extern "C" volatile uint32_t sweet_fb_frame_open;
+extern "C" uint32_t sweet_fb_drawtick;
+uint32_t sweet_fb_drawtick = 1;         /* (kern.sweet_fb_drawtick, bsd/kern/sweet_amfi.c) */
+volatile uint64_t sweet_fb_vsync_count, sweet_fb_frame_tick;
+volatile uint32_t sweet_fb_frame_open;
 /* the panel's refresh as told to CoreAnimation, and the free-running tick's period (boot-arg sweetfb_rate, Hz: 60) */
 static uint32_t sweet_fb_rate = 60, sweet_fb_vsync_us = 16667;
 #define SWEET_FB_DOT_PITCH              458     /* ppi, as the iPhone X panel */
@@ -672,6 +684,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 	AppleCLCD *fb = (AppleCLCD *)owner;
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
+	sweet_fb_vsync_count = count;
 	if (sweet_tl_on && sweet_tl_nt < SWEET_TL_TICKS) {
 		sweet_tl_tick[sweet_tl_nt] = sweet_tl_us();
 		sweet_tl_nt = sweet_tl_nt + 1;
@@ -1055,7 +1068,17 @@ AppleCLCD::swap(const uint8_t *rec)
 		fHasEarly = true;
 	}
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
-	fPendingTick = fVsyncCount;
+	{
+		static int asked = 0;
+		if (!asked) {
+			asked = 1;
+			(void)PE_parse_boot_argn("sweetfb_drawtick", (void *)&sweet_fb_drawtick, sizeof(sweet_fb_drawtick));
+		}
+		/* (a frame whose drawing began more than a tick ago is not held for later: by the swap then) */
+		fPendingTick = sweet_fb_drawtick && sweet_fb_frame_open && fVsyncCount - sweet_fb_frame_tick <= 1 ? sweet_fb_frame_tick :
+		    fVsyncCount;
+		sweet_fb_frame_open = 0;
+	}
 	fLastSwapAt = mach_absolute_time();
 	fDirty = true;
 	fRateSwaps++;
