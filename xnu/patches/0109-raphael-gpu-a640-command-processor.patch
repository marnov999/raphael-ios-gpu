+	    gpu_rd(g_core, CP_SQE_INSTR_BASE), gpu_rd(g_core, CP_RB_BASE), gpu_rd(g_core, CP_RB_CNTL),
+	    gpu_rd(g_core, UCHE_GMEM_RANGE_MAX), gpu_rd(g_core, RBBM_STATUS));
