+	}
+	ring_command(CP_ME_INIT, 8);                    /* a6xx_cp_init */
+	ring_put(0x0000002fu);
+	ring_put(0x00000003u);                          /* several hardware contexts */
+	ring_put(0x20000000u);                          /* error detection */
