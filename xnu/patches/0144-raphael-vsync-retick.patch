 }
 
+void
+AppleCLCD::retickFired(OSObject *owner, __unused IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	IOLockLock(fb->fLock);
+	if (fb->fLastSwapAt < fb->fTickAt) {
+		for (unsigned int i = 0; i < fb->fClients->getCount(); i++) {
+			((IOMobileFramebufferUserClient *)fb->fClients->getObject(i))->notify(SWEET_FB_NOTIFY_VSYNC, fb->fTickValues, 6);
+		}
+		fb->fReticks++;
+	}
+	IOLockUnlock(fb->fLock);
+}
+
 void
 AppleCLCD::addClient(IOMobileFramebufferUserClient *client)
