+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+/*
+ * Rings (u7, 2026-11-03: 1.2 MB/s). One frame at a time each way, taken and given back at the event
+ * poll every 1 ms, kept the link near 1.5 MB/s, and the phone's TCP acknowledgements queued behind each
+ * other. As Linux's dwc3 runs a bulk endpoint (gadget.c __dwc3_prepare_one_trb): its TRBs in a ring
+ * closed by a link TRB, one endless transfer, CSP on the OUT ones so that a short packet (the end of
+ * every frame) ends only its TRB, IOC for an XferInProgress event each, and UPDATE_TRANSFER whenever
+ * TRBs are given back to the controller or added.
+ */
+#define DEPCMD_UPDATETRANSFER   7
+#define TRB_CSP                 (1u << 3)
+#define TRBCTL_LINK             (8u << 4)
+#define RX_N                    64
+#define TX_N                    32
+#define RG_RX_TRB(i)            (16u * (i))
+#define RG_TX_TRB(i)            (0x1000u + 16u * (i))
+#define RG_RX_BUF(i)            (0x2000u + UD_FRAME_MAX * (i))
+#define RG_TX_BUF(i)            (0x2000u + UD_FRAME_MAX * (RX_N + (i)))
+#define RG_SIZE                 (0x2000u + UD_FRAME_MAX * (RX_N + TX_N))
+#define RX_CTL                  (TRBCTL_NORMAL | TRB_HWO | TRB_CSP | TRB_IOC)
+static vm_offset_t rg;
+static uint64_t    rg_pa;
+static uint32_t    rx_next, rx_rsc, tx_head, tx_tail, tx_used, tx_rsc;
+static bool        tx_on;
+
+static void
+rg_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(rg_pa + off), len, TRUE);
+}
+
+static void
+rg_trb(uint32_t off, uint64_t pa, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(rg + off);
+	t[0] = (uint32_t)pa;
+	t[1] = (uint32_t)(pa >> 32);
+	t[2] = len;
+	t[3] = ctl;
+	rg_sync(off, 16);
+}
+
+static bool
+ud_rings(void)
+{
+	if (rg == 0 && kmem_alloc_contig(kernel_map, &rg, round_page(RG_SIZE), PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		rg = 0;
+		return false;
+	}
+	rg_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)rg));
+	return rg_pa != 0;
+}
+
+/* STARTTRANSFER at a TRB of the ring; the transfer's resource index, or ~0 */
+static uint32_t
+rg_start(unsigned ep, uint32_t trb)
+{
+	uint64_t tpa = rg_pa + trb;
+	if (ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0)) {
+		return ~0u;
+	}
+	return (dwc_rd(DEPCMD(ep)) >> 16) & 0x7f;
+}
+
+static void
+ud_rx_ring_start(void)
+{
+	for (uint32_t i = 0; i < RX_N; i++) {
+		rg_trb(RG_RX_TRB(i), rg_pa + RG_RX_BUF(i), UD_FRAME_MAX, RX_CTL);
+	}
+	rg_trb(RG_RX_TRB(RX_N), rg_pa + RG_RX_TRB(0), 0, TRBCTL_LINK | TRB_HWO);
+	rx_next = 0;
+	rx_rsc = rg_start(EP_RX, RG_RX_TRB(0));
+	printf("SWEET USB: rings of %u frames in, %u out (resource %u)\n", RX_N, TX_N, rx_rsc);
+}
+
+/* the frames the controller has filled, up the stack, and their TRBs given back */
+static void
+ud_rx_ring_done(void)
+{
+	unsigned n;
+	for (n = 0; n < RX_N; n++) {
+		uint32_t off = RG_RX_TRB(rx_next);
+		volatile uint32_t *t = (volatile uint32_t *)(rg + off);
+		rg_sync(off, 16);
+		if (t[3] & TRB_HWO) {
+			break;
+		}
+		rg_sync(RG_RX_BUF(rx_next), UD_FRAME_MAX);
+		ud_rx_frame((const void *)(rg + RG_RX_BUF(rx_next)), UD_FRAME_MAX - (t[2] & 0xffffff));
+		rg_trb(off, rg_pa + RG_RX_BUF(rx_next), UD_FRAME_MAX, RX_CTL);
+		rx_next = (rx_next + 1) % RX_N;
+	}
+	if (n != 0) {
+		(void)ud_epcmd(EP_RX, DEPCMD_UPDATETRANSFER | (rx_rsc << 16), 0, 0, 0);
+	}
+}
+
+/* the frames sent taken back, the queued ones put in the ring. ud.lock held. */
+static void
+ud_tx_ring_kick_locked(void)
+{
+	bool added = false;
+	while (tx_used > 0) {
+		volatile uint32_t *t = (volatile uint32_t *)(rg + RG_TX_TRB(tx_tail));
+		rg_sync(RG_TX_TRB(tx_tail), 16);
+		if (t[3] & TRB_HWO) {
+			break;
+		}
+		tx_tail = (tx_tail + 1) % TX_N;
+		tx_used--;
+	}
+	while (ud.txq_count > 0 && tx_used < TX_N && ud.configured) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		uint8_t *buf = (uint8_t *)(rg + RG_TX_BUF(tx_head));
+		mbuf_copydata(m, 0, len, buf);
+		mbuf_freem(m);
+		if ((len % 512) == 0) {         /* (as ud_tx_kick_locked: no zero-length packet needed) */
+			buf[len++] = 0;
+		}
+		rg_sync(RG_TX_BUF(tx_head), (uint32_t)len);
+		rg_trb(RG_TX_TRB(tx_head), rg_pa + RG_TX_BUF(tx_head), (uint32_t)len, TRBCTL_NORMAL | TRB_HWO | TRB_IOC);
+		tx_head = (tx_head + 1) % TX_N;
+		tx_used++;
+		ud.tx_frames++;
+		added = true;
+	}
+	if (!added) {
+		return;
+	}
+	if (!tx_on) {
+		rg_trb(RG_TX_TRB(TX_N), rg_pa + RG_TX_TRB(0), 0, TRBCTL_LINK | TRB_HWO);
+		tx_rsc = rg_start(EP_TX, RG_TX_TRB(0));
+		tx_on = tx_rsc != ~0u;
+	} else {
+		(void)ud_epcmd(EP_TX, DEPCMD_UPDATETRANSFER | (tx_rsc << 16), 0, 0, 0);
+	}
+}
+#endif
