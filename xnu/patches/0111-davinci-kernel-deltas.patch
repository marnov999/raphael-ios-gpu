+/*
+ * SWEET: boot-arg sweettrace=NAME[,NAME...] logs every system call of the processes so named
+ * (p_comm, the first 16 characters) that fails, with its errno and, for the calls that take paths, the path(s):
+ *     SWEET TRACE: MobileNotes[491] mkdir("/private/var/...") = 1 EPERM
+ * One process's failures and nothing else, to find the call an obfuscated or Swift binary gives
+ * up on (HackiOS's systrace= does the same for every call). The error-return path only, so a
+ * process not named costs one byte compare per call.
+ */
+static TUNABLE_STR(sweet_trace_name, 96, "sweettrace", "");
+
+static bool
+sweet_trace_named(const char *comm)
+{
+	size_t len = strnlen(comm, MAXCOMLEN + 1);
+	for (const char *t = sweet_trace_name; *t != '\0';) {
+		const char *end = strchr(t, ',');
+		size_t n = end ? (size_t)(end - t) : strlen(t);
+		if (n == len && strncmp(t, comm, n) == 0) {
+			return true;
+		}
+		if (end == NULL) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+static int
+sweet_trace_path_args(unsigned short code, int *second)
+{
+	*second = -1;
+	switch (code) {
+	case SYS_link: case SYS_rename: case SYS_symlink:
+		*second = 1;
+		return 0;
+	case SYS_open: case SYS_open_nocancel: case SYS_unlink: case SYS_chdir: case SYS_mknod:
+	case SYS_chmod: case SYS_chown: case SYS_access: case SYS_readlink: case SYS_mkdir:
+	case SYS_rmdir: case SYS_utimes: case SYS_pathconf: case SYS_truncate: case SYS_getattrlist:
+	case SYS_setattrlist: case SYS_getxattr: case SYS_setxattr: case SYS_removexattr:
+	case SYS_listxattr: case SYS_stat64: case SYS_lstat64: case SYS_statfs64: case SYS_lchown:
+	case SYS_chflags: case SYS_mkfifo: case SYS_stat: case SYS_lstat: case SYS_statfs:
+	case SYS_getattrlistbulk:
+		return code == SYS_getattrlistbulk ? -1 : 0;
+	case SYS_openat: case SYS_openat_nocancel: case SYS_mkdirat: case SYS_fstatat64:
+	case SYS_unlinkat: case SYS_faccessat: case SYS_getattrlistat: case SYS_readlinkat:
+	case SYS_fchmodat: case SYS_fchownat: case SYS_fstatat: case SYS_setattrlistat:
+		return 1;
+	case SYS_renameat: case SYS_renameatx_np:
+		*second = 3;
+		return 1;
+	case SYS_linkat:
+		*second = 3;
+		return 1;
+	case SYS_symlinkat:
+		*second = 2;
+		return 0;
+	default:
+		return -1;
+	}
+}
+
+static void
+sweet_trace_fail(struct proc *p, unsigned short code, struct uthread *ut, int error)
+{
+	static char path[2][1024];
+	size_t n;
+	int second, first;
+
+	if (!sweet_trace_named(p->p_comm)) {
+		return;
+	}
+	path[0][0] = path[1][0] = '\0';
+	first = sweet_trace_path_args(code, &second);
+	if (first >= 0 && copyinstr((user_addr_t)ut->uu_arg[first], path[0], sizeof(path[0]), &n) != 0) {
+		strlcpy(path[0], "?", sizeof(path[0]));
+	}
+	if (second >= 0 && copyinstr((user_addr_t)ut->uu_arg[second], path[1], sizeof(path[1]), &n) != 0) {
+		strlcpy(path[1], "?", sizeof(path[1]));
+	}
+	printf("SWEET TRACE: %s[%d] syscall %u(%s%s%s%s%s%s) args %#llx %#llx %#llx = errno %d\n", p->p_comm,
+	    proc_pid(p), code, first >= 0 ? "\"" : "", path[0], first >= 0 ? "\"" : "",
+	    second >= 0 ? ", \"" : "", path[1], second >= 0 ? "\"" : "",
+	    (unsigned long long)ut->uu_arg[0], (unsigned long long)ut->uu_arg[1],
+	    (unsigned long long)ut->uu_arg[2], error);
+}
+
 /*
  * Function:	unix_syscall
  *
@@ -180,6 +268,10 @@ unix_syscall(
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
+	if (__improbable(sweet_trace_name[0] != '\0') && error != 0 && error != EJUSTRETURN &&
+	    error != ERESTART) {
+		sweet_trace_fail(proc, code, uthread, error);
+	}
 
 #if CONFIG_MACF
 skip_syscall:
diff --git a/bsd/dev/sweet_prof.c b/bsd/dev/sweet_prof.c
new file mode 100644
index 0000000..20610cf
--- /dev/null
+++ b/bsd/dev/sweet_prof.c
@@ -0,0 +1,313 @@
+/*
+ * SWEET profiler: where does a process spend its processor time? (The window server draws 20-30
+ * frames a second on a phone that does 60 under Android; the profile says why.)
+ *
+ *   sysctl kern.sweetprof=S   sample the process named in boot-arg sweetprof_name (default
+ *                             backboardd) for S seconds (1..30)
+ *
+ * The samples are taken in osfmk/arm64/sleh.c: every interrupt that comes while a thread of that
+ * process runs in user mode notes its pc, lr and thread. When the time is up this prints:
+ *   PRF begin <name>[<pid>] <n> samples in <ms> ms
+ *   SMP ...                  the shared cache's slide and every thread (sweet_sample_task)
+ *   PRF img <load> <path>    every image outside the shared cache (dyld's list in the task)
+ *   PRF kslide <slide>       the kernel's slide (samples with cpu bit 31 were in the kernel)
+ *   PRF s <pc> <lr> <tid> <cpu> <us>   (us: the frame timeline's clock)
+ *   PRF end
+ * and before them the frame timeline of the same seconds (TL begin .. TL end, SweetFramebuffer.cpp).
+ * for tools/sweet-prof.py to put names to (the shared cache with its slide; our dylibs by load
+ * address).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <sys/sysctl.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <mach/task_info.h>
+#include <vm/vm_map.h>
+#include <pexpert/pexpert.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+#include <os/atomic_private.h>
+
+struct sweet_prof_sample {
+	uint64_t pc, lr;
+	uint32_t tid, cpu;
+	uint64_t when;          /* mach_absolute_time() */
+	uint64_t up[4];         /* a sample in the kernel: the return addresses of the four frames above */
+	uint64_t upc, ulr;      /* ... and where its thread is in user space (the call that brought it in) */
+};
+#define SWEET_PROF_MAX 16384
+extern task_t                    sweet_prof_target;
+extern volatile uint32_t         sweet_prof_n;
+extern struct sweet_prof_sample  sweet_prof_buf[SWEET_PROF_MAX];
+extern void sweet_sample_task(const char *name, int pid, task_t task);   /* osfmk/kern/exception.c */
+extern task_t proc_task(proc_t);
+extern vm_map_t get_task_map(task_t);
+extern kern_return_t vm_map_read_user(vm_map_t map, vm_map_address_t src_addr, void *dst_p, vm_size_t size);
+extern int hz;
+extern vm_offset_t vm_kernel_slide;
+extern void sweet_fb_timeline(int on);
+extern int sweet_task_thread_times(task_t task, uint64_t *tid, uint64_t *mach, int max);   /* osfmk/kern/exception.c */
+#define SWEET_PROF_THREADS 256
+static uint64_t sweet_prof_tid0[SWEET_PROF_THREADS], sweet_prof_cpu0[SWEET_PROF_THREADS];
+static uint64_t sweet_prof_tid1[SWEET_PROF_THREADS], sweet_prof_cpu1[SWEET_PROF_THREADS];     /* iokit/Kernel/arm/SweetFramebuffer.cpp: the frame timeline */
+
+static int sweet_prof_seconds;
+static void sweet_prof_thread(void *arg, wait_result_t wr);          /* asked for, 0: nothing to do */
+static int sweet_prof_busy;
+static char sweet_prof_name[32] = "backboardd";
+
+struct sweet_prof_find {
+	task_t task;
+	int pid;
+};
+
+static int
+sweet_prof_proc(proc_t p, void *arg)
+{
+	struct sweet_prof_find *f = arg;
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (f->task == TASK_NULL && strcmp(name, sweet_prof_name) == 0) {
+		f->task = proc_task(p);
+		f->pid = proc_pid(p);
+		if (f->task != TASK_NULL) {
+			task_reference(f->task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+/* dyld's list of the task's images: those outside the shared cache, with their load addresses. */
+static void
+sweet_prof_images(task_t task)
+{
+	struct task_dyld_info info;
+	mach_msg_type_number_t count = TASK_DYLD_INFO_COUNT;
+	vm_map_t map = get_task_map(task);
+	struct {
+		uint32_t version, count;
+		uint64_t array;
+	} all;
+	if (task_info(task, TASK_DYLD_INFO, (task_info_t)&info, &count) != KERN_SUCCESS || info.all_image_info_addr == 0 ||
+	    vm_map_read_user(map, (vm_map_address_t)info.all_image_info_addr, &all, sizeof(all)) != KERN_SUCCESS) {
+		printf("PRF img none (no dyld image list)\n");
+		return;
+	}
+	for (uint32_t i = 0; i < all.count && i < 2048u; i++) {
+		struct {
+			uint64_t load, path, date;
+		} img;
+		char path[200];
+		if (vm_map_read_user(map, (vm_map_address_t)(all.array + 24ull * i), &img, sizeof(img)) != KERN_SUCCESS) {
+			break;
+		}
+		bzero(path, sizeof(path));
+		if (img.path == 0 || vm_map_read_user(map, (vm_map_address_t)img.path, path, sizeof(path) - 1) != KERN_SUCCESS) {
+			/* (a path may end close to the end of its page: shorter tries) */
+			if (img.path == 0 || vm_map_read_user(map, (vm_map_address_t)img.path, path, 64) != KERN_SUCCESS) {
+				continue;
+			}
+		}
+		path[sizeof(path) - 1] = 0;
+		if (strncmp(path, "/System/", 8) == 0 || strncmp(path, "/usr/lib/", 9) == 0) {
+			continue;               /* in the shared cache: named by its address and the slide */
+		}
+		printf("PRF img 0x%llx %s\n", img.load, path);
+	}
+}
+
+/* The other way to ask (the sysctl may not be there): /tmp/prof_go = "<seconds> <anything>", a change of it starts one. */
+extern vnode_t rootvnode;
+static void
+sweet_prof_file(void)
+{
+	static char last[32];
+	char now[32];
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx;
+	int resid = 0;
+	if (rootvnode == NULLVP) {
+		return;
+	}
+	ctx = vfs_context_kernel();
+	if (vnode_lookup("/tmp/prof_go", 0, &vp, ctx) != 0) {
+		return;
+	}
+	bzero(now, sizeof(now));
+	(void)vn_rdwr(UIO_READ, vp, (caddr_t)now, sizeof(now) - 1, 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (now[0] != 0 && strncmp(now, last, sizeof(last)) != 0) {
+		int secs = 0;
+		strlcpy(last, now, sizeof(last));
+		for (const char *c = now; *c >= '0' && *c <= '9'; c++) {
+			secs = secs * 10 + (*c - '0');
+		}
+		if (secs >= 1 && secs <= 30) {
+			/* "SECONDS [NAME] ...": a process to sample other than boot-arg sweetprof_name's */
+			const char *c = now;
+			while (*c >= '0' && *c <= '9') {
+				c++;
+			}
+			while (*c == ' ') {
+				c++;
+			}
+			if ((*c >= 'A' && *c <= 'Z') || (*c >= 'a' && *c <= 'z')) {
+				size_t n = 0;
+				while (c[n] != 0 && c[n] != ' ' && c[n] != '\n' && n + 1 < sizeof(sweet_prof_name)) {
+					n++;
+				}
+				memcpy(sweet_prof_name, c, n);
+				sweet_prof_name[n] = 0;
+			}
+			printf("PRF asked by /tmp/prof_go: %d s of %s\n", secs, sweet_prof_name);
+			sweet_prof_seconds = secs;
+		}
+	}
+}
+
+void sweet_prof_start(void);
+void
+sweet_prof_start(void)
+{
+	if (!sweet_prof_busy) {
+		thread_t t;
+		sweet_prof_busy = 1;
+		if (kernel_thread_start(sweet_prof_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+		}
+	}
+}
+
+static void
+sweet_prof_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	(void)PE_parse_boot_argn("sweetprof_name", sweet_prof_name, sizeof(sweet_prof_name));
+	for (;;) {
+		struct sweet_prof_find f = { TASK_NULL, 0 };
+		uint64_t start, ns;
+		uint32_t n;
+		int secs;
+		while (sweet_prof_seconds == 0) {
+			(void)tsleep(&chan, PZERO, "sweetprf", hz / 2);
+			sweet_prof_file();
+		}
+		secs = sweet_prof_seconds;
+		if (strcmp(sweet_prof_name, "BIGCORES") == 0) {
+			/* every interrupt on cpu 6-7, whatever task it comes in: "PRF b NAME PRIORITY TID CPU US KERNEL" */
+			extern volatile int sweet_prof_bigcores;
+			sweet_prof_n = 0;
+			sweet_fb_timeline(1);
+			sweet_prof_bigcores = 1;
+			(void)tsleep(&chan, PZERO, "sweetprf", secs * hz);
+			sweet_prof_bigcores = 0;
+			sweet_fb_timeline(0);
+			delay(2000);
+			n = sweet_prof_n < SWEET_PROF_MAX ? sweet_prof_n : SWEET_PROF_MAX;
+			printf("PRF begin BIGCORES %u samples in %d s\n", n, secs);
+			for (uint32_t i = 0; i < n; i++) {
+				char name[9];
+				uint64_t us = 0;
+				for (int k = 0; k < 8; k++) {
+					char c = (char)(sweet_prof_buf[i].pc >> (8 * k));
+					name[k] = c >= 0x21 && c < 0x7f ? c : (c == 0 ? 0 : '_');
+				}
+				name[8] = 0;
+				absolutetime_to_nanoseconds(sweet_prof_buf[i].when, &us);
+				printf("PRF b %s %u %u %u %llu %u\n", name[0] ? name : "?", (uint32_t)sweet_prof_buf[i].lr, sweet_prof_buf[i].tid,
+				    sweet_prof_buf[i].cpu, us / 1000u, (uint32_t)(sweet_prof_buf[i].lr >> 32));
+				if ((i & 255u) == 255u) {
+					(void)tsleep(&chan, PZERO, "sweetprf", hz / 20);
+				}
+			}
+			printf("PRF end\n");
+			sweet_prof_seconds = 0;
+			continue;
+		}
+		proc_iterate(PROC_ALLPROCLIST, sweet_prof_proc, &f, NULL, NULL);
+		if (f.task == TASK_NULL) {
+			printf("PRF no process named %s\n", sweet_prof_name);
+			sweet_prof_seconds = 0;
+			continue;
+		}
+		sweet_prof_n = 0;
+		start = mach_absolute_time();
+		int nt0 = sweet_task_thread_times(f.task, sweet_prof_tid0, sweet_prof_cpu0, SWEET_PROF_THREADS);
+		sweet_fb_timeline(1);
+		os_atomic_store(&sweet_prof_target, f.task, release);
+		(void)tsleep(&chan, PZERO, "sweetprf", secs * hz);
+		os_atomic_store(&sweet_prof_target, TASK_NULL, release);
+		sweet_fb_timeline(0);              /* (TL begin .. TL end, before the samples) */
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		n = sweet_prof_n < SWEET_PROF_MAX ? sweet_prof_n : SWEET_PROF_MAX;
+		delay(2000);                    /* (an interrupt that saw the target may still be writing) */
+		printf("PRF begin %s[%d] %u samples in %llu ms\n", sweet_prof_name, f.pid, n, ns / 1000000ull);
+		sweet_sample_task(sweet_prof_name, f.pid, f.task);
+		printf("PRF kslide 0x%lx\n", (unsigned long)vm_kernel_slide);
+		{
+			/* every thread's processor time in these seconds, exactly: "PRF t TID US PERMILLE" (of one core) */
+			int nt1 = sweet_task_thread_times(f.task, sweet_prof_tid1, sweet_prof_cpu1, SWEET_PROF_THREADS);
+			for (int a = 0; a < nt1; a++) {
+				uint64_t was = 0, us = 0;
+				for (int b = 0; b < nt0; b++) {
+					if (sweet_prof_tid0[b] == sweet_prof_tid1[a]) {
+						was = sweet_prof_cpu0[b];
+						break;
+					}
+				}
+				absolutetime_to_nanoseconds(sweet_prof_cpu1[a] - was, &us);
+				us /= 1000u;
+				if (us >= 1000u) {
+					printf("PRF t %llu %llu %llu\n", sweet_prof_tid1[a], us, ns / 1000ull ? us * 1000u / (ns / 1000ull) : 0);
+				}
+			}
+		}
+		sweet_prof_images(f.task);
+		for (uint32_t i = 0; i < n; i++) {
+			uint64_t us = 0;
+			absolutetime_to_nanoseconds(sweet_prof_buf[i].when, &us);
+			us /= 1000u;            /* (the frame timeline's clock: TL lines) */
+			printf("PRF s %llx %llx %u %u %llu %llx %llx %llx %llx %llx %llx\n", sweet_prof_buf[i].pc, sweet_prof_buf[i].lr,
+			    sweet_prof_buf[i].tid, sweet_prof_buf[i].cpu, us, sweet_prof_buf[i].up[0], sweet_prof_buf[i].up[1],
+			    sweet_prof_buf[i].up[2], sweet_prof_buf[i].up[3], sweet_prof_buf[i].upc, sweet_prof_buf[i].ulr);
+			if ((i & 255u) == 255u) {
+				(void)tsleep(&chan, PZERO, "sweetprf", hz / 20);   /* (the USB log streams 100 ms at a time) */
+			}
+		}
+		printf("PRF end\n");
+		task_deallocate(f.task);
+		sweet_prof_seconds = 0;
+	}
+}
+
+static int
+sweet_prof_sysctl SYSCTL_HANDLER_ARGS
+{
+	int v = 0, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (v < 1 || v > 30) {
+		return EINVAL;
+	}
+	if (!sweet_prof_busy) {
+		thread_t t;
+		sweet_prof_busy = 1;
+		if (kernel_thread_start(sweet_prof_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+		}
+	}
+	if (sweet_prof_seconds != 0) {
+		return EBUSY;
+	}
+	sweet_prof_seconds = v;
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweetprof, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, NULL, 0,
+    sweet_prof_sysctl, "I", "profile boot-arg sweetprof_name (backboardd) for this many seconds");
diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index cb67b4d..9790f0a 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -24,6 +24,7 @@
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <kern/debug.h>
+#include <kern/kalloc.h>
 #include <kern/startup.h>
 #include <libkern/amfi/amfi.h>
 #include <mach/kern_return.h>
@@ -32,6 +33,7 @@
 #include <sys/priv.h>
 #include <sys/proc.h>
 #include <sys/systm.h>
+#include <sys/sysctl.h>
 #include <sys/ubc_internal.h>
 #include <sys/vnode.h>
 #include <security/mac_policy.h>
@@ -285,8 +287,59 @@ sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
  */
 static uint64_t sweet_sandbox_seen;
 
+/*
+ * Extension issue (op 5): libsystem_sandbox's __sandbox_extension_issue mallocs a 2 KB buffer, passes
+ * {class, ?, path, flags, buffer, ...} and on success hands the buffer back as the token without
+ * having written a byte of it. tccd issues one to every client it grants a service to (Photos,
+ * AddressBook, ...); ENOENT here made each grant "server error: Failed to issue Sandbox Extension"
+ * (kTCCErrorDomain 6), i.e. denied -- assetsd then aborts ("requires TCCPhotosService access") and
+ * Photos opens no library. There is no sandbox to extend, so the token only has to be well formed
+ * for whoever consumes it (op 6, which succeeds): Apple's shape, the class and the path in it.
+ */
+struct sweet_sb_issue_args {
+	uint64_t ext_class;     /* const char * */
+	uint64_t unknown;
+	uint64_t path;          /* const char * */
+	uint64_t flags;
+	uint64_t token;         /* char[2048] out */
+	uint64_t pid_or_token;
+	uint64_t unknown2;
+};
+
+static int
+sweet_sandbox_extension_issue(user_addr_t arg)
+{
+	struct sweet_sb_issue_args a;
+	char cls[128] = "";
