+/*
+ * SWEET: a managed window that crosses 0x100000000 (> 4 GiB) unmasks 32-bit physical-address
+ * truncations elsewhere in the kernel (davinci: 0x57778000 == 0x157778000 & 0xFFFFFFFF, below
+ * gPhysBase; pmap_sync_page_attributes_phys was one, fixed in 0103). Recover the dropped bit 32 and
+ * log each distinct caller once, so the real truncation sites can be found and fixed.
+ */
+static pmap_paddr_t __attribute__((noinline))
+sweet_untruncate_pa(pmap_paddr_t pa, const char *who, void *ret)
+{
+	pmap_paddr_t fixed = pa | 0x100000000ULL;
+	if ((pa < gPhysBase) && (fixed >= gPhysBase) && ((fixed - gPhysBase) < real_phys_size)) {
+		static void *sweet_trunc_callers[16];
+		static int sweet_trunc_n = 0;
+		int k;
+		for (k = 0; k < sweet_trunc_n && sweet_trunc_callers[k] != ret; k++) {
+		}
+		if (k == sweet_trunc_n && sweet_trunc_n < 16) {
+			sweet_trunc_callers[sweet_trunc_n++] = ret;
+			printf("SWEET %s: truncated PA 0x%llx -> 0x%llx caller %p\n",
+			    who, (unsigned long long)pa, (unsigned long long)fixed, ret);
+		}
+		return fixed;
+	}
+	return pa;
+}
