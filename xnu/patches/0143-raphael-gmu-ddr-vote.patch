 };
 
+static bool
+gpu_ddr_vote(void)
+{
+	static int v = -1;
+	if (v < 0) {
+		v = 0;
+		(void)PE_parse_boot_argn("sweetgpu_ddr", &v, sizeof(v));
+	}
+	return v != 0;
+}
+
 static bool
 gmu_core_power(void)
 {
@@ -1050,6 +1061,17 @@ gmu_core_power(void)
 		return false;
 	}
 	bw.ddr_data[0][0] = bw.ddr_data[0][1] = bw.ddr_data[0][2] = 0x40000000u;
+	/*
+	 * (raphael, boot-arg sweetgpu_ddr=1) The one level of bus votes the GMU is given, and puts in with each
+	 * speed: the system cache (SH0) and the DDR (MC0) at their fastest -- RPMh BCM commands (commit, valid,
+	 * average and peak, 14 bits each; past the top is the top). Nothing here voted the memory's speed: as
+	 * Linux's a640 table, "off", while Linux votes it for the GPU through its interconnect framework --
+	 * here nobody did, and the window server's frames waited on memory (CoreAnimation's layer work, the
+	 * GPU's full-screen clear and copy of each frame, the display's 81 Hz fetch).
+	 */
+	if (gpu_ddr_vote()) {
+		bw.ddr_data[0][0] = bw.ddr_data[0][1] = 0x6fffffffu;    /* BCM_TCS_CMD(1, 1, 0x3fff, 0x3fff) */
+	}
 	bw.cnoc_data[0][0] = 0x40000000u;
 	bw.cnoc_data[1][0] = 0x60000001u;
 	(void)PE_parse_boot_argn("sweetgpu_speed", &speed, sizeof(speed));
@@ -1057,6 +1079,7 @@ gmu_core_power(void)
