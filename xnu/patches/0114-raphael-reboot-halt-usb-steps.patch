+#define GUSB2PHYCFG             0xc200
+#define   GUSB2PHYCFG_SUSPHY    (1u << 6)
+#define   GUSB2PHYCFG_ENBLSLPM  (1u << 8)
+#define GUSB3PIPECTL            0xc2c0
+#define   GUSB3PIPECTL_SUSPHY   (1u << 17)
+#define GSNPSID                 0xc120
+#define QSCRATCH_GENERAL_CFG    0x08
+#define   PIPE_UTMI_CLK_SEL     (1u << 0)
+#define   PIPE3_PHYSTATUS_SW    (1u << 3)
+#define   PIPE_UTMI_CLK_DIS     (1u << 8)
+
+static void
+qs_wr(vm_offset_t qs, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(qs + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* Before the shared start's soft reset: steps 1-7. false: stop. */
+static bool
+ud_raphael_prepare(void)
+{
+	/* ABL's global setup, put back after the core reset (Linux sets these from the DT). */
+	static const uint32_t keep[] = { 0xc100, 0xc104, 0xc12c, 0xc11c, 0xc630, GUSB2PHYCFG, GUSB3PIPECTL };
+	uint32_t saved[sizeof(keep) / sizeof(keep[0])], gctl = dwc_rd(GCTL);
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE), qs = ml_io_map(QSCRATCH_PA, 0x100);
+
+	if (gcc == 0 || qs == 0) {
+		return false;
+	}
+	for (unsigned k = 0; k < sizeof(keep) / sizeof(keep[0]); k++) {
+		saved[k] = dwc_rd(keep[k]);
+	}
+	if (!ud_step(1, "halt the controller (DCTL.RUN_STOP off), mask events")) {
+		return false;
+	}
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	dwc_wr(DEVTEN, 0);
+	dwc_wr(GEVNTSIZ, dwc_rd(GEVNTSIZ) | (1u << 31));
+	if (ud_fix & UD_FIX_CORE_BCR) {
+		if (!ud_step(2, "core reset (GCC_USB30_PRIM_BCR)")) {
+			return false;
+		}
+		qs_wr(gcc, GCC_USB30_PRIM_BCR, 1);
+		ud_sleep_ms(1);
+		qs_wr(gcc, GCC_USB30_PRIM_BCR, 0);
+		ud_sleep_ms(10);
+		if (!ud_step(3, "read the core after its reset")) {
+			return false;
+		}
+		printf("SWEET USB: after core reset: GSNPSID 0x%08x GCTL 0x%08x DCTL 0x%08x DSTS 0x%08x GUSB2PHYCFG 0x%08x "
+		    "GUSB3PIPECTL 0x%08x\n", dwc_rd(GSNPSID), dwc_rd(GCTL), dwc_rd(DCTL), dwc_rd(DSTS),
+		    dwc_rd(GUSB2PHYCFG), dwc_rd(GUSB3PIPECTL));
+		if (!ud_step(4, "ABL's global setup back, device mode")) {
+			return false;
+		}
+		for (unsigned k = 0; k < sizeof(keep) / sizeof(keep[0]); k++) {
+			dwc_wr(keep[k], saved[k]);
+		}
+		/* device role (PRTCAPDIR 2), clock gating off (stock DT snps,disable-clk-gating) */
+		dwc_wr(GCTL, (gctl & ~(3u << 12)) | (2u << 12) | 1u);
+	}
+	if (ud_fix & UD_FIX_UTMI_PIPE) {
+		if (!ud_step(5, "UTMI clock as the pipe clock (QSCRATCH GENERAL_CFG)")) {
+			return false;
+		}
+		qs_wr(qs, QSCRATCH_GENERAL_CFG, usb_rd(qs, QSCRATCH_GENERAL_CFG) | PIPE_UTMI_CLK_DIS);
+		delay(1000);
+		qs_wr(qs, QSCRATCH_GENERAL_CFG, usb_rd(qs, QSCRATCH_GENERAL_CFG) | PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW);
+		delay(1000);
+		qs_wr(qs, QSCRATCH_GENERAL_CFG, usb_rd(qs, QSCRATCH_GENERAL_CFG) & ~PIPE_UTMI_CLK_DIS);
+		printf("SWEET USB: GENERAL_CFG 0x%08x\n", usb_rd(qs, QSCRATCH_GENERAL_CFG));
+	}
+	if (!(ud_fix & UD_FIX_KEEP_SUSPHY)) {
+		if (!ud_step(6, "PHY suspend off (GUSB2PHYCFG SUSPHY/ENBLSLPM, GUSB3PIPECTL SUSPHY)")) {
+			return false;
+		}
+		dwc_wr(GUSB2PHYCFG, dwc_rd(GUSB2PHYCFG) & ~(GUSB2PHYCFG_SUSPHY | GUSB2PHYCFG_ENBLSLPM));
+		dwc_wr(GUSB3PIPECTL, dwc_rd(GUSB3PIPECTL) & ~GUSB3PIPECTL_SUSPHY);
+		delay(10000);
+	}
+	if (!ud_step(7, "read before the soft reset")) {
+		return false;
+	}
+	printf("SWEET USB: GCTL 0x%08x GUSB2PHYCFG 0x%08x GUSB3PIPECTL 0x%08x DCTL 0x%08x DSTS 0x%08x DEPCMD0 0x%08x\n",
+	    dwc_rd(GCTL), dwc_rd(GUSB2PHYCFG), dwc_rd(GUSB3PIPECTL), dwc_rd(DCTL), dwc_rd(DSTS), dwc_rd(DEPCMD(0)));
+	return true;
+}
+
+static void
+ud_raphael_thread(void *arg, wait_result_t wr __unused)
+{
+	uint32_t secs = 0;
+	PE_parse_boot_argn("sweetusbdelay", &secs, sizeof(secs));
+	if (secs) {
+		ud_sleep_ms(secs * 1000);
+	}
+	sweet_usb_gadget_start((vm_offset_t)arg);
+	printf("SWEET USB: start thread done\n");
+	sweet_log_sync();
+}
+
+static void
+ud_raphael_start(vm_offset_t dwc)
+{
+	thread_t thread;
+	PE_parse_boot_argn("sweetusbstop", &ud_stop, sizeof(ud_stop));
+	PE_parse_boot_argn("sweetusbfix", &ud_fix, sizeof(ud_fix));
+	if (kernel_thread_start(ud_raphael_thread, (void *)dwc, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
