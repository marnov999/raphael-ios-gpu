diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 6f4365c..7600738 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -94,6 +94,97 @@ usb_rd(vm_offset_t base, uint32_t off)
 	return v;
 }
 
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+/*
+ * raphael: davinci's start reset the phone (g2, 2026-11-02), and the K20 Pro port's six rounds
+ * (Gsjsjzhznsz/ios-raphael t14-t19, rolled back) wedged a CPU on the first endpoint command. The
+ * Mi 9T Pro's controller is a DWC_usb31 (GSNPSID "3110") with maximum-speed super-speed-plus behind
+ * a QMP USB3/DP PHY (stock DT ssusb@a600000, ssphy@88e8000), not davinci's high-speed-only DWC3, and
+ * after `fastboot boot` ABL leaves it halted on a SuperSpeed link (DSTS speed 4, address 7) with
+ * its event buffer at ABL's 0xfdbf9000. What was never looked at there: the SS PHY's pipe clock
+ * (the DWC31 runs parts of its device logic on it), the core reset (the stock driver resets the
+ * whole controller through GCC_USB30_PRIM_BCR before it sets it up) and the SMMU stream of its DMA.
+ * So the state is reported, and the start runs on its own thread, one step at a time, each step
+ * logged and on the flash (sweet_log_sync) before it runs: a step that hangs the bus is the last
+ * line of the log. sweetusbstop=N stops before step N; sweetusbfix= bits (default UD_FIX_DEFAULT):
+ *   1  core reset through GCC_USB30_PRIM_BCR (0xf000), ABL's global setup put back after it
+ *   2  UTMI clock as the pipe clock (Linux dwc3_qcom_select_utmi_clk: a high-speed-only port)
+ *   4  no device soft reset (DCTL.CSFTRST)
+ *   8  leave GUSB2PHYCFG / GUSB3PIPECTL SUSPHY as ABL left them (default: cleared, the stock DT's
+ *      dis_u2_susphy, mainline's dis_u3_susphy for sm8150)
+ * sweetusbdelay=S waits S seconds first.
+ */
+#define UD_FIX_CORE_BCR         1u
+#define UD_FIX_UTMI_PIPE        2u
+#define UD_FIX_NO_CSFTRST       4u
+#define UD_FIX_KEEP_SUSPHY      8u
+#define UD_FIX_DEFAULT          (UD_FIX_CORE_BCR | UD_FIX_UTMI_PIPE)
+#define GCC_USB30_PRIM_BCR      0x0f000
+#define SMMU_PA                 0x15000000      /* apps_smmu */
+#define USB_SID                 0x140           /* stock DT iommus = <&apps_smmu 0x140 0> */
+
+extern void sweet_log_sync(void);
+static uint32_t ud_stop, ud_fix = UD_FIX_DEFAULT;
+static void ud_raphael_start(vm_offset_t dwc);
+static bool ud_raphael_prepare(void);
+
+static bool
+ud_step(unsigned n, const char *what)
+{
+	printf("SWEET USB: step %u: %s\n", n, what);
+	if (ud_stop != 0 && n >= ud_stop) {
+		printf("SWEET USB: stopped before step %u (sweetusbstop)\n", n);
+		sweet_log_sync();
+		return false;
+	}
+	sweet_log_sync();
+	return true;
+}
+
+/* Read-only: the clocks, registers and SMMU stream the start depends on. */
+static void
+ud_raphael_report(vm_offset_t gcc, vm_offset_t dwc, bool smmu)
+{
+	printf("SWEET USB: clk phy-aux 0x%08x phy-com-aux 0x%08x phy-pipe 0x%08x prim-clkref 0x%08x BCR 0x%08x\n",
+	    usb_rd(gcc, 0xf050), usb_rd(gcc, 0xf054), usb_rd(gcc, 0xf058), usb_rd(gcc, 0x8c008),
+	    usb_rd(gcc, GCC_USB30_PRIM_BCR));
+	printf("SWEET USB: DWC3 VER 0x%08x GUSB3PIPECTL 0x%08x GSBUSCFG0 0x%08x GSBUSCFG1 0x%08x GUCTL 0x%08x "
+	    "GUCTL1 0x%08x GFLADJ 0x%08x\n", usb_rd(dwc, 0xc1a0), usb_rd(dwc, 0xc2c0), usb_rd(dwc, 0xc100),
+	    usb_rd(dwc, 0xc104), usb_rd(dwc, 0xc12c), usb_rd(dwc, 0xc11c), usb_rd(dwc, 0xc630));
+	vm_offset_t qs = ml_io_map(0x0a6f8800, 0x100);
+	if (qs != 0) {
+		printf("SWEET USB: QSCRATCH GENERAL_CFG 0x%08x HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
+		    usb_rd(qs, 0x08), usb_rd(qs, 0x10), usb_rd(qs, 0x30));
+	}
+	if (!smmu) {
+		return;
+	}
+	printf("SWEET USB: reading the SMMU\n");
+	sweet_log_sync();
+	vm_offset_t sm = ml_io_map(SMMU_PA, 0x1000);
+	if (sm != 0) {
+		uint32_t cr0 = usb_rd(sm, 0x0), n = usb_rd(sm, 0x20) & 0xff;
+		bool found = false;
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t smr = usb_rd(sm, 0x800 + 4 * i), s2cr, type;
+			uint32_t id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+			if (!(smr & (1u << 31)) || ((id ^ USB_SID) & ~mask) != 0) {
+				continue;
+			}
+			s2cr = usb_rd(sm, 0xc00 + 4 * i);
+			type = (s2cr >> 16) & 3;
+			printf("SWEET USB: SMMU stream 0x%x: SMR %u 0x%08x S2CR 0x%08x (%s)\n", USB_SID, i, smr, s2cr,
+			    type == 1 ? "bypass" : type == 0 ? "translated" : "FAULT");
+			found = true;
+		}
+		if (!found) {
+			printf("SWEET USB: SMMU stream 0x%x: no SMR of %u (sCR0 0x%08x: unmatched %s)\n", USB_SID, n, cr0,
+			    (cr0 & (1u << 10)) ? "FAULT" : "bypass");
+		}
+	}
+}
+#endif
