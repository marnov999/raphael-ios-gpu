diff --git a/bsd/dev/sweet_reboot.c b/bsd/dev/sweet_reboot.c
new file mode 100644
index 0000000..e933954
--- /dev/null
+++ b/bsd/dev/sweet_reboot.c
@@ -0,0 +1,248 @@
+/*
+ * SWEET (raphael): reboot into fastboot, power off and restart, as davinci's sweet_gpu.c does them.
+ *
+ * The reboot target is the PMIC's: Linux's qcom-pon reboot-mode writes PON SOFT_RB_SPARE (PM8150
+ * SID 0, peripheral 0x08, register 0x8f) bits[7:1] = 2 for "bootloader" (pm8150.dtsi: pm8998-pon,
+ * reason shift 1), the register survives the SoC reset, and ABL reads and clears it. Written over
+ * SPMI v5 (sm8150.dtsi spmi_bus, the same regions as davinci's SM7150): an APID's read/write
+ * channel at chnls + 0x10000 * apid, the observer (reads) at obsrvr + 0x80 * apid.
+ *
+ *   sweet_reboot_fastboot(0)   set the reason only: any reset from now on comes up in fastboot
+ *   sweet_reboot_fastboot(1)   set it and reset (DRM MSM_INFO_IOS_REBOOT: userland fbreboot)
+ *
+ * Boot-arg sweetarmfb=1 sets the reason at boot (before the USB start and the GPU), so a hang that
+ * ends in a watchdog reset, or a panic, lands in fastboot instead of the flashed boot's iOS (whose
+ * boot would overwrite the log ring). PE_halt_restart (boot-arg sweethalt=0: not set) does power off
+ * and restart as Linux's msm-poweroff / qpnp-power-on: the reason cleared, the PMIC's PS_HOLD reset
+ * type set to shutdown or hard reset, PS_HOLD dropped (iOS's Shut Down ended in "halt/reset timed
+ * out" without it). A panic restart, when armed, is a PSCI reset (into fastboot).
+ */
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+#include <stdbool.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_log_sync(void);
+extern int (*PE_halt_restart)(unsigned int type);
+int sweet_reboot_fastboot(uint32_t mode);
+void sweet_reboot_init(void);
+
+#define SPMI_CORE_PA            0x0c440000u
+#define SPMI_CHNLS_PA           0x0c600000u
+#define SPMI_OBS_PA             0x0e600000u
+#define SPMI_CFG_PA             0x0c40a000u
+#define PON_PERIPH              0x08u
+#define PON_PERPH_SUBTYPE       0x05u
+#define PON_PS_HOLD_RST_CTL     0x5au
+#define PON_PS_HOLD_RST_CTL2    0x5bu
+#define PON_SOFT_RB_SPARE       0x8fu
+#define PON_REASON_BL           0x02u
+#define PON_RESET_EN            0x80u
+#define PON_TYPE_SHUTDOWN       0x04u
+#define PON_TYPE_HARD_RESET     0x07u
+#define PON_GEN2_PRIMARY        0x04u
+#define PON_GEN2_SECONDARY      0x05u
+
+#define IMEM_PA                 0x146bf000u     /* stock DT qcom,msm-imem@146bf000 */
+#define IMEM_RESTART_REASON_OFF 0x65cu
+#define RESTART_REASON_FASTBOOT 0x77665500u
+#define PSHOLD_PA               0x0c264000u     /* stock DT restart@c264000 (qcom,pshold) */
+#define PSCI_SYSTEM_RESET       0x84000009ull
+
+enum { SWEET_PE_HALT = 0, SWEET_PE_RESTART = 1, SWEET_PE_UPS_HALT = 3, SWEET_PE_PANIC_RESTART = 4,
+       SWEET_PE_PANIC_RESTART_NOCALLOUTS = 9 };  /* IOPlatformExpert.h kPE* */
+
+static vm_offset_t sr_core, sr_cfg, sr_obs;
+static unsigned sr_count, sr_apid = 0xffffu;
+static bool sr_armed;
+
+static void
+sr_psci_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+	__asm__ volatile ("smc #0" : "+r"(x0) :: "memory", "x1", "x2", "x3", "x4", "x5", "x6", "x7",
+	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17");
+}
+
+/* The arbiter mapped and PON's APID found (owner EE 0 preferred). 0 or -1. */
+static int
+sr_spmi_init(void)
+{
+	if (sr_apid != 0xffffu) {
+		return 0;
+	}
+	if (!sr_core) {
+		sr_core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+		sr_cfg = ml_io_map(SPMI_CFG_PA, 0x1000u);
+		sr_obs = ml_io_map(SPMI_OBS_PA, 0x10000u);
+	}
+	if (!sr_core || !sr_cfg || !sr_obs) {
+		return -1;
+	}
+	sr_count = (*(volatile uint32_t *)(sr_core + 4)) & 0x7ffu;
+	for (unsigned i = 0; i < sr_count && i < 512u; i++) {
+		uint32_t map = *(volatile uint32_t *)(sr_core + 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != PON_PERIPH) {
+			continue;
+		}
+		if (sr_apid == 0xffffu || ((*(volatile uint32_t *)(sr_cfg + 0x700u + 4u * i)) & 7u) == 0u) {
+			sr_apid = i;
+		}
+	}
+	return sr_apid == 0xffffu ? -1 : 0;
+}
+
+/* One PON register by the observer channel (EXT_READL). */
+static int
+sr_pon_rd(uint8_t reg, uint8_t *out)
+{
+	unsigned off = 0x80u * sr_apid;
+	*(volatile uint32_t *)(sr_obs + off) = (1u << 27) | ((uint32_t)reg << 4);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000u; i++) {
+		uint32_t st = *(volatile uint32_t *)(sr_obs + off + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return -1;
+			}
+			*out = (uint8_t)*(volatile uint32_t *)(sr_obs + off + 0x18u);
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+/* One PON register by the APID's own read/write channel (EXT_WRITEL, 1 byte). */
+static int
+sr_pon_wr(uint8_t reg, uint8_t val)
+{
+	static vm_offset_t ch;
+	if (!ch && !(ch = ml_io_map(SPMI_CHNLS_PA + 0x10000u * sr_apid, 0x1000u))) {
+		return -1;
+	}
+	*(volatile uint32_t *)(ch + 0x10u) = val;                       /* WDATA0 */
+	__asm__ volatile ("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (0u << 27) | ((uint32_t)reg << 4);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000u; i++) {
+		uint32_t st = *(volatile uint32_t *)(ch + 0x08u);       /* STATUS */
+		if (st & 1u) {
+			return (st & 0x0eu) ? -2 : 0;
+		}
+		delay(1);
+	}
+	return -3;
+}
+
+int
+sweet_reboot_fastboot(uint32_t mode)
+{
+	uint8_t old = 0, val, rb = 0xff;
+	int rc;
+
+	if (sr_spmi_init() != 0 || sr_pon_rd(PON_SOFT_RB_SPARE, &old) != 0) {
+		printf("SWEET REBOOT: PON not found / not readable (%u APIDs)\n", sr_count);
+		return -1;
+	}
+	val = (uint8_t)((old & 0x01u) | (PON_REASON_BL << 1));
+	rc = sr_pon_wr(PON_SOFT_RB_SPARE, val);
+	delay(50);
+	(void)sr_pon_rd(PON_SOFT_RB_SPARE, &rb);
+	printf("SWEET REBOOT: PON apid %u (owner ee %u) SOFT_RB_SPARE %#x -> %#x: write %d, reads back %#x%s\n",
+	    sr_apid, (*(volatile uint32_t *)(sr_cfg + 0x700u + 4u * sr_apid)) & 7u, old, val, rc, rb,
+	    rb == val ? " (SET: a reset now goes to fastboot)" : " (NOT set)");
+	{       /* and the IMEM cookie the downstream kernel also leaves (harmless if ABL ignores it) */
+		vm_offset_t imem = ml_io_map(IMEM_PA, 0x1000u);
+		if (imem) {
+			*(volatile uint32_t *)(imem + IMEM_RESTART_REASON_OFF) = RESTART_REASON_FASTBOOT;
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+	}
+	sr_armed = (rb == val);
+	if (mode == 0) {
+		return sr_armed ? 0 : -1;
+	}
+	printf("SWEET REBOOT: resetting\n");
+	sweet_log_sync();
+	delay(200000);                  /* the line out over the network first */
+	sr_psci_reset();
+	return -1;
+}
+
+static int
+sweet_halt_restart(unsigned int type)
+{
+	bool off = (type == SWEET_PE_HALT || type == SWEET_PE_UPS_HALT);
+	uint8_t spare = 0, ctl = 0, ctl2 = 0;
+	vm_offset_t ph;
+
+	if (type == SWEET_PE_PANIC_RESTART || type == SWEET_PE_PANIC_RESTART_NOCALLOUTS) {
+		if (!sr_armed) {
+			return -1;
+		}
+		sr_psci_reset();        /* armed: the panic comes back up in fastboot */
+		return -1;
+	}
+	if (!off && type != SWEET_PE_RESTART) {
+		return -1;
+	}
+	if (sr_spmi_init() == 0 && sr_pon_rd(PON_SOFT_RB_SPARE, &spare) == 0) {
+		/* an intended restart or power off: not into fastboot */
+		int w0 = sr_pon_wr(PON_SOFT_RB_SPARE, (uint8_t)(spare & 0x01u));
+		(void)sr_pon_rd(PON_PS_HOLD_RST_CTL, &ctl);
+		(void)sr_pon_rd(PON_PS_HOLD_RST_CTL2, &ctl2);
+		int w1 = sr_pon_wr(PON_PS_HOLD_RST_CTL2, (uint8_t)(ctl2 & ~PON_RESET_EN));
+		delay(500);             /* 10 sleep-clock cycles, with Linux's margin */
+		int w2 = sr_pon_wr(PON_PS_HOLD_RST_CTL,
+		    (uint8_t)((ctl & 0xf0u) | (off ? PON_TYPE_SHUTDOWN : PON_TYPE_HARD_RESET)));
+		int w3 = sr_pon_wr(PON_PS_HOLD_RST_CTL2, (uint8_t)(ctl2 | PON_RESET_EN));
+		printf("SWEET HALT: %s: reason %#x -> %#x, PS_HOLD type %#x -> %#x, writes %d %d %d %d\n",
+		    off ? "power off" : "restart", spare, spare & 0x01u, ctl,
+		    (ctl & 0xf0u) | (off ? PON_TYPE_SHUTDOWN : PON_TYPE_HARD_RESET), w0, w1, w2, w3);
+	} else {
+		printf("SWEET HALT: %s: PMIC PON not reachable\n", off ? "power off" : "restart");
+	}
+	sweet_log_sync();
+	delay(200000);                  /* the line out over the network first */
+	if (!off) {
+		sr_psci_reset();
+	}
+	ph = ml_io_map(PSHOLD_PA, 0x1000u);
+	if (ph) {
+		*(volatile uint32_t *)ph = 0u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
+
+/* From the UFS start (bsd/dev/sweet_ufs.c), the log running, before the USB start. */
+void
+sweet_reboot_init(void)
+{
+	uint32_t arm = 0, halt = 1;
+	uint8_t subtype = 0;
+
+	if (sr_spmi_init() != 0 || sr_pon_rd(PON_PERPH_SUBTYPE, &subtype) != 0) {
+		printf("SWEET REBOOT: PMIC PON not found (%u APIDs): no fastboot reboot, no power off\n", sr_count);
+		return;
+	}
+	printf("SWEET REBOOT: PON apid %u, subtype %#x\n", sr_apid, subtype);
+	if (PE_parse_boot_argn("sweetarmfb", &arm, sizeof(arm)) && arm) {
+		printf("SWEET REBOOT: armed for fastboot: %d\n", sweet_reboot_fastboot(0));
+	}
+	(void)PE_parse_boot_argn("sweethalt", &halt, sizeof(halt));
+	/* PS_HOLD_RST_CTL/CTL2 as above only on a gen2 PON (PMIC5: PM8150 is one) */
+	if (halt && PE_halt_restart == NULL &&
+	    (subtype == PON_GEN2_PRIMARY || subtype == PON_GEN2_SECONDARY)) {
+		PE_halt_restart = sweet_halt_restart;
+		printf("SWEET REBOOT: power off / restart hook set\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_RAPHAEL */
