+/*
+ * Physically contiguous zeroed memory, out of this processor's cache (anywhere in RAM: the GPU's tables
+ * take 36-bit addresses); *va the cacheable kernel view. 0 when it went well.
+ */
+static int
+gmub_alloc_phys(vm_offset_t *va, uint64_t *pa, vm_size_t size)
+{
+	ppnum_t pn;
+	*va = 0;
+	*pa = 0;
+	if (kmem_alloc_contig(kernel_map, va, size, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS || !(pn = pmap_find_phys(kernel_pmap, (addr64_t)*va))) {
+		return -1;
+	}
+	*pa = ptoa_64(pn);
+	gpu_to_memory(*va, size);
+	return 0;
+}
