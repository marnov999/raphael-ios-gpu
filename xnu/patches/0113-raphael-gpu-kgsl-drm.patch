+/* XNU process KPIs: reclaim GPU contexts/BOs whose owning process has died.
+ * (A shared cdev's d_close only fires on last-close, so per-process cleanup can't
+ * live there; instead we lazily reap dead owners at allocation time.) */
+struct proc;
+extern int          proc_selfpid(void);
+extern struct proc *proc_find(int pid);   /* ref'd proc if alive, NULL if dead */
+extern int          proc_rele(struct proc *p);
+static struct kgsl_ctx_ent g_ctx[KGSL_MAX_CTX];
+static struct kgsl_bo_ent  g_bo[KGSL_MAX_BO];
+static uint32_t g_ctx_next = 1;
+static uint32_t g_mmap_page_next = 4;   /* 4K-page units; multiple of 4 keeps id<<12 16K-aligned */
+
+/* SweetSurface.cpp (0046): an IOSurface held by the GPU, its seed, and its pixels pushed out
+ * of this processor's cache. */
+extern void    *sweet_surface_gpu_ref(uint32_t id);
+extern void     sweet_surface_gpu_unref(void *surface);
+extern uint32_t sweet_surface_gpu_seed(void *surface);
+extern void     sweet_surface_gpu_flush(void *surface);
+extern int64_t  sweet_surface_gpu_push_written(void *surface);   /* bytes, -1: push it all out */
+void sweet_dvfs_kick(void);     /* the clock governor (sweet_cpufreq's): something is being drawn */
+void sweet_dvfs_wake_now(void); /* and back from the display-off clocks at once (a wake) */
+
+/*
+ * One lock around everything that is the GPU's: the ring, the fence, the address space and
+ * the buffer tables (HackiOS RedwoodGPU.cpp gGPULock). A waiter lets go of it while it waits.
+ */
+static lck_grp_t *g_gpu_grp;
+static lck_mtx_t *g_gpu_mtx;
+static void gpu_lock(void)   { lck_mtx_lock(g_gpu_mtx); }
+static void gpu_unlock(void) { lck_mtx_unlock(g_gpu_mtx); }
+
+static struct kgsl_ctx_ent *kgsl_ctx_find(uint32_t id)
+{
+	unsigned i;
+	for (i = 0; i < KGSL_MAX_CTX; i++) { if (g_ctx[i].used && g_ctx[i].id == id) { return &g_ctx[i]; } }
+	return NULL;
+}
+/* handle -> table index hint (RedwoodGPU indexes handles directly; ours are mmap-offset ids, so
+ * a hint per id hash is checked first, and the table searched when it misses) */
+#define KGSL_BO_HINTS 8192u
+static uint16_t g_bo_hint[KGSL_BO_HINTS];
+/*
+ * A chained hash of the ids (4K-page offsets: the hash is id / 4). It was one hint per hash and,
+ * when the hint missed, a walk of the whole table -- 4096 entries of 112 bytes -- for every id not
+ * found as live, which is every buffer a submission names after it was given back or kept (used 2,
+ * 3): 4% of the render thread. A buffer is put in its chain when it is made (kgsl_bo_hint) and
+ * taken out when its entry is freed or made again (kgsl_bo_unhash). Boot-arg sweetgpu_bohash_verify=1:
+ * the table walked after a miss as well, and a buffer found so but not in its chain said.
+ */
+#define KGSL_BO_HASH(id) (((id) >> 2) % KGSL_BO_HINTS)
+static int g_bo_hash_verify = -1;
+static void kgsl_bo_hint(struct kgsl_bo_ent *b)
+{
+	unsigned h = KGSL_BO_HASH(b->id);
+	if (b->hashed) { return; }
+	b->hnext = g_bo_hint[h];
+	g_bo_hint[h] = (uint16_t)(b - g_bo + 1);
+	b->hashed = 1;
+}
+static void kgsl_bo_unhash(struct kgsl_bo_ent *b)
+{
+	uint16_t *link;
+	if (!b->hashed) { return; }
+	for (link = &g_bo_hint[KGSL_BO_HASH(b->id)]; *link != 0; link = &g_bo[*link - 1].hnext) {
+		if (&g_bo[*link - 1] == b) { *link = b->hnext; break; }
+	}
+	b->hnext = 0;
+	b->hashed = 0;
+}
+static struct kgsl_bo_ent *kgsl_bo_find(uint32_t id)
+{
+	unsigned i, steps = 0;
+	for (i = g_bo_hint[KGSL_BO_HASH(id)]; i != 0 && steps++ < KGSL_MAX_BO; i = g_bo[i - 1].hnext) {
+		if (g_bo[i - 1].used == 1 && g_bo[i - 1].id == id) { return &g_bo[i - 1]; }
+	}
+	if (g_bo_hash_verify < 0) {
+		int v = 0;
+		g_bo_hash_verify = PE_parse_boot_argn("sweetgpu_bohash_verify", &v, sizeof(v)) && v != 0;
+	}
+	if (g_bo_hash_verify) {
+		static unsigned told;
+		for (i = 0; i < KGSL_MAX_BO; i++) {
+			if (g_bo[i].used == 1 && g_bo[i].id == id) {
+				if (told++ < 20) { printf("SWEET DRM: buffer %u (entry %u) not in its hash chain\n", id, i); }
+				kgsl_bo_hint(&g_bo[i]);
+				return &g_bo[i];
+			}
+		}
+	}
+	return NULL;
+}
