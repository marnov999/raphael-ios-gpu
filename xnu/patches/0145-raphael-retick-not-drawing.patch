--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1987,6 +1987,8 @@ static int                g_kgsl_ready;  /* submit path live */
  * entry translation-faults (fsr.TF) the new region. */
 extern void IODelay(unsigned microseconds);       /* IOKit/IOLib.h */
 /* (how the syncs went, for the five-second line: done in the busy look, done later, never; their time) */
+uint64_t sweet_ws_submit_at;            /* (mach time; read by SweetFramebuffer.cpp) */
+extern task_t current_task(void);
 static uint32_t g_tlb_quick, g_tlb_slow, g_tlb_never;
 /* (drm_ioctl's waits, for the five-second line) */
 static uint32_t g_prep_calls, g_prep_zero, g_prep_nosync, g_waitf_calls;
@@ -3719,6 +3721,14 @@ drm_do_gem_submit(struct drm_msm_gem_submit *s, uint32_t *out_fence)
 	}
 	__asm__ volatile("dsb sy" ::: "memory");             /* and what was written last is in memory */
 	sweet_dvfs_kick();
+	{
+		/* (when the window server last gave the GPU work: SweetFramebuffer's retick sends a tick's vsync again
+		 * only when it has not begun drawing since -- else it drew that tick twice) */
+		extern task_t sweet_window_server_task;
+		if (sweet_window_server_task != TASK_NULL && current_task() == sweet_window_server_task) {
+			sweet_ws_submit_at = mach_absolute_time();
+		}
+	}
 	fence = gpu_submit(ibva, ibdw, n);
 	if (fence == 0) {
 		return EIO;                                      /* the ring stayed full: the core is not reading it */
