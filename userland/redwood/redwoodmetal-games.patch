+static NSUInteger
+rw_data_type(const char *t)
+{
+	static const struct { const char *n; NSUInteger v; } map[] = {
+		{ "float", 3 }, { "float2", 4 }, { "float3", 5 }, { "float4", 6 },
+		{ "float2x2", 7 }, { "float2x3", 8 }, { "float2x4", 9 }, { "float3x2", 10 },
+		{ "float3x3", 11 }, { "float3x4", 12 }, { "float4x2", 13 }, { "float4x3", 14 },
+		{ "float4x4", 15 }, { "half", 16 }, { "half2", 17 }, { "half3", 18 }, { "half4", 19 },
+		{ "half2x2", 20 }, { "half3x3", 24 }, { "half4x4", 28 }, { "int", 29 }, { "int2", 30 },
+		{ "int3", 31 }, { "int4", 32 }, { "uint", 33 }, { "uint2", 34 }, { "uint3", 35 },
+		{ "uint4", 36 }, { "short", 37 }, { "short2", 38 }, { "short3", 39 }, { "short4", 40 },
+		{ "ushort", 41 }, { "ushort2", 42 }, { "ushort3", 43 }, { "ushort4", 44 },
+		{ "char", 45 }, { "char2", 46 }, { "char3", 47 }, { "char4", 48 }, { "uchar", 49 },
+		{ "uchar2", 50 }, { "uchar3", 51 }, { "uchar4", 52 }, { "bool", 53 },
+		{ "packed_float2", 4 }, { "packed_float3", 5 }, { "packed_float4", 6 },
+		{ "packed_half2", 17 }, { "packed_half3", 18 }, { "packed_half4", 19 },
+	};
+	if (t == NULL) {
+		return 0;
+	}
+	if (strncmp(t, "metal::", 7) == 0) {
+		t += 7;
+	}
+	for (unsigned i = 0; i < sizeof(map) / sizeof(map[0]); i++) {
+		if (strcmp(t, map[i].n) == 0) {
