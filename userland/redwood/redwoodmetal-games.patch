+/* one function's arguments as MTLArgument-shaped objects; an empty array when unreadable */
+static NSArray *
+rw_reflect_function(struct rwa_device *dev, id function)
+{
+	NSMutableArray *out = [NSMutableArray array];
+	SEL bitcode = sel_getUid("bitcodeData");
+
+	if (dev == NULL || mesa.function_arguments == NULL || function == nil ||
+	    ![function respondsToSelector:bitcode]) {
+		return out;
+	}
+	NSData *air = ((NSData *(*)(id, SEL))objc_msgSend)(function, bitcode);
+	if (air == nil || [air length] < 4) {
+		return out;
+	}
+	static struct rwa_argument args[48];
+	static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+	unsigned n = 0;
+	char why[512] = { 0 };
+
+	pthread_mutex_lock(&lock);
+	if (RWL(mesa.function_arguments(dev, [air bytes], [air length], [[function name] UTF8String],
+				    args, 48, &n, why, sizeof(why))) != 0) {
+		pthread_mutex_unlock(&lock);
+		rw_print("reflection of %s: %s\n", [[function name] UTF8String], why);
+		return out;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		struct rwa_argument *a = &args[i];
+		RedwoodMetalArgument *r = [[RedwoodMetalArgument alloc] init];
+
+		r.name = [NSString stringWithUTF8String:a->name];
+		r.index = a->index;
+		r.active = YES;
+		r.access = a->write ? (a->read ? 1 : 2) : 0;
+		if (a->kind == 1) {
+			r.type = 2;                     /* MTLArgumentTypeTexture */
+			r.textureType = 2;              /* MTLTextureType2D */
+			r.textureDataType = strstr(a->type_name, "half") ? 16 :
+			    strstr(a->type_name, "uint") ? 33 : strstr(a->type_name, "int") ? 29 : 3;
+		} else if (a->kind == 2) {
+			r.type = 3;                     /* MTLArgumentTypeSampler */
+		} else {
+			r.type = 0;                     /* MTLArgumentTypeBuffer */
+			r.bufferAlignment = 16;
+			r.bufferDataSize = a->size;
+			r.bufferDataType = a->member_count ? 1 : rw_data_type(a->type_name);
+			if (a->member_count) {
+				NSMutableArray *ms = [NSMutableArray array];
+				unsigned end = 0;
+				for (unsigned k = 0; k < a->member_count; k++) {
+					RedwoodMetalStructMember *m = [[RedwoodMetalStructMember alloc] init];
+					m.name = [NSString stringWithUTF8String:a->members[k].name];
+					m.offset = a->members[k].offset;
+					m.dataType = rw_data_type(a->members[k].type_name);
+					/* bigger than one element of its type: an array of them. Its size is
+					 * the whole array's when the compiler says so; failing that, for a
+					 * 16-byte-or-larger element, the gap to the next member says it */
+					unsigned esize = rw_data_type_size(m.dataType);
+					unsigned span = a->members[k].size;
+					if (esize >= 16 && span == esize) {
+						unsigned next = 0;
+						for (unsigned j = 0; j < a->member_count; j++) {
+							unsigned o = a->members[j].offset;
+							if (o > a->members[k].offset && (next == 0 || o < next)) {
+								next = o;
+							}
+						}
+						if (next == 0 && a->size > a->members[k].offset) {
+							next = a->size;
+						}
+						if (next > a->members[k].offset + esize) {
+							span = next - a->members[k].offset;
+						}
+					}
+					if (esize != 0 && span > esize && span % esize == 0) {
+						RedwoodMetalArrayType *at = [[RedwoodMetalArrayType alloc] init];
+						at.elementType = m.dataType;
+						at.arrayLength = span / esize;
+						at.stride = esize;
+						m.arrayType = at;
+						[at release];
+						m.dataType = 2;   /* MTLDataTypeArray */
+					}
+					[ms addObject:m];
+					[m release];
+					if (a->members[k].offset + a->members[k].size > end) {
+						end = a->members[k].offset + a->members[k].size;
+					}
+				}
+				RedwoodMetalStructType *st = [[RedwoodMetalStructType alloc] init];
+				st.members = ms;
+				r.bufferStructType = st;
+				[st release];
+				if (r.bufferDataSize == 0) {
+					r.bufferDataSize = (end + 15u) & ~15u;
+				}
+			}
+		}
+		[out addObject:r];
+		[r release];
+	}
+	pthread_mutex_unlock(&lock);
+	static int reflect_log = -1;   /* /usr/local/gltest/rw_trace_reflect exists: every reflection, no budget */
+	if (reflect_log == -1) {
+		reflect_log = access("/usr/local/gltest/rw_trace_reflect", F_OK) == 0;
+	}
+	if (reflect_log || rw_trace_bind_on()) {
+		for (unsigned i = 0; i < n; i++) {
+			for (unsigned k = 0; k < args[i].member_count; k++) {
+				rw_print("REFLECT %s: %s member %s '%s' offset %u size %u -> MTLDataType %lu\n",
+				    [[function name] UTF8String], args[i].name, args[i].members[k].name,
+				    args[i].members[k].type_name, args[i].members[k].offset, args[i].members[k].size,
+				    (unsigned long)rw_data_type(args[i].members[k].type_name));
+			}
+		}
+		for (RedwoodMetalArgument *r in out) {
+			rw_print("REFLECT %s: %s type %lu index %lu members %lu\n", [[function name] UTF8String],
+			    [[r name] UTF8String], (unsigned long)[r type], (unsigned long)[r index],
+			    (unsigned long)[[[r bufferStructType] members] count]);
+		}
+	}
+	return out;
+}
