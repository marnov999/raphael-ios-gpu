+/* ONE LOCK over the Mesa context (raphael 2026-11-19): a pipe_context is not thread-safe, and LIMBO
+ * commits command buffers from its render thread and its main thread at once -- the first time
+ * its draws reached Mesa they crashed in batch_draw_tracking (NULL + 8). Recursive: -commit holds
+ * it across a whole command buffer and the calls inside take it again. */
+static pthread_mutex_t rw_mesa_mutex;
+static void
+rw_mesa_lock_init(void)
+{
+	pthread_mutexattr_t a;
+	pthread_mutexattr_init(&a);
+	pthread_mutexattr_settype(&a, PTHREAD_MUTEX_RECURSIVE);
+	pthread_mutex_init(&rw_mesa_mutex, &a);
+	pthread_mutexattr_destroy(&a);
+}
+static void
+rw_mesa_lock(void)
+{
+	static pthread_once_t once = PTHREAD_ONCE_INIT;
+	pthread_once(&once, rw_mesa_lock_init);
+	pthread_mutex_lock(&rw_mesa_mutex);
+}
+static void
+rw_mesa_unlock(void)
+{
+	pthread_mutex_unlock(&rw_mesa_mutex);
+}
+#define RWL(e) ({ rw_mesa_lock(); __auto_type _rwl_r = (e); rw_mesa_unlock(); _rwl_r; })
+#define RWLV(e) do { rw_mesa_lock(); (e); rw_mesa_unlock(); } while (0)
+
