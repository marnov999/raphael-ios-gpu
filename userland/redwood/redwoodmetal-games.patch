+/* Subclasses of Metal's own reflection classes, not of NSObject: applications add CATEGORIES to
+ * them (Real Racing 3 sends -[MTLArgument extractShaderVariablesFor:atBufferOffset:forShaderType:],
+ * its own method, to every argument -- "unrecognized selector" on an NSObject stand-in) and test
+ * isKindOfClass:. Every getter is overridden here, so nothing of the superclass's state is read. */
+/* bytes of one element of an MTLDataType, as laid out in a constant buffer (float3 = 16, as Metal pads it);
+ * 0 for a type this does not size */
+static unsigned
+rw_data_type_size(NSUInteger t)
+{
+	switch (t) {
+	case 3: case 29: case 33: return 4;                 /* float, int, uint */
+	case 4: case 30: case 34: return 8;                 /* float2, int2, uint2 */
+	case 5: case 6: case 31: case 32: case 35: case 36: return 16;   /* float3/4, int3/4, uint3/4 */
+	case 7: return 16;  case 8: return 32;  case 9: return 32;       /* float2x2, 2x3, 2x4 */
+	case 10: return 24; case 11: return 48; case 12: return 48;      /* float3x2, 3x3, 3x4 */
+	case 13: return 32; case 14: return 64; case 15: return 64;      /* float4x2, 4x3, 4x4 */
+	case 16: return 2; case 17: return 4; case 18: case 19: return 8; /* half .. half4 */
+	case 28: return 32;                                  /* half4x4 */
+	case 53: return 1;                                   /* bool */
+	default: return 0;
+	}
+}
