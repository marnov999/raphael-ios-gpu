+/*
+ * (raphael 2026-11-03) A surface nobody has written yet (seed 0; the kernel makes it zeroed) that is drawn
+ * into: CoreAnimation makes a new full-screen one every frame (1125x2436, 10.8 MB), and surface_to_texture()
+ * copied its zeroes into the texture with the CPU (~5 ms of the render thread a frame). The texture made
+ * without contents and cleared by the GPU instead. /usr/local/gltest/gl_no_fresh_clear: as before.
+ */
+static int
+no_fresh_clear(void)
+{
+	static int no = -1;
+	if (no < 0) {
+		struct stat flag;
+		no = stat("/usr/local/gltest/gl_no_fresh_clear", &flag) == 0;
+	}
+	return no;
+}
+
+static void
+texture_cleared(struct eagl *e, struct image *image)
+{
+	GLint fb = 0, scissor = 0;
+	GLfloat colour[4];
+	GLboolean mask[4];
+	static unsigned told;
+
+	glTexImage2D(image->to, 0, (GLint)internal_format(image->internal, image->format), image->width, image->height, 0,
+	    image->format, image->type, NULL);
+	glGetIntegerv(0x8CA6 /* GL_FRAMEBUFFER_BINDING */, &fb);
+	glGetFloatv(GL_COLOR_CLEAR_VALUE, colour);
+	glGetBooleanv(0x0C23 /* GL_COLOR_WRITEMASK */, mask);
+	scissor = glIsEnabled(GL_SCISSOR_TEST);
+	if (e->reader == 0) {
+		glGenFramebuffers(1, &e->reader);
+	}
+	glBindFramebuffer(GL_FRAMEBUFFER, e->reader);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->texture, 0);
+	glDisable(GL_SCISSOR_TEST);
+	glColorMask(1, 1, 1, 1);
+	glClearColor(0, 0, 0, 0);
+	glClear(GL_COLOR_BUFFER_BIT);
+	glClearColor(colour[0], colour[1], colour[2], colour[3]);
+	glColorMask(mask[0], mask[1], mask[2], mask[3]);
+	if (scissor) {
+		glEnable(GL_SCISSOR_TEST);
+	}
+	glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)fb);
+	image->seed = 0;
+	if (told++ < 3) {
+		say("redwood-gl: -attachImage: texture %u is new IOSurface %u (%dx%d, never written): cleared by the GPU, not copied\n",
+		    image->texture, IOSurfaceGetID(image->surface), image->width, image->height);
+	}
+}
